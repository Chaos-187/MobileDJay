# Copy to `.env` in the PROJECT ROOT (same folder as `server.js`) — not cwd-dependent.
# Loaded at startup from that path; startup logs: `[env] Loaded dotenv file: <absolute path> …`
# Silence the log: PORTAL_SILENCE_ENV_LOG=1
# Requires `dotenv` — used when you run `node server.js` / `npm run dev`.

# --- Server ---
PORT=3000
NODE_ENV=development

# Comma-separated allowed Origins for `GET /api/v1/*` CORS (portal frontends).
# Default if unset matches production EyUp hosts.
# PORTAL_CORS_ORIGINS=https://eyupevents.uk,https://www.eyupevents.uk,https://requests.eyupevents.uk

# --- Portal JWT (required in production) ---
PORTAL_JWT_SECRET=
# Fallback name also supported:
# JWT_SECRET=

# Portal access token TTL (jsonwebtoken `expiresIn` string, default 7d)
# PORTAL_JWT_EXPIRES_IN=7d

# --- Google Sign-In — customer portal POST /auth/login/google (JWT id_token verification)
# Web client ID from Google Cloud Console (same value as Authorized JavaScript origin on GIS).
# Optional: comma-separated for multiple OAuth clients (e.g. staging + production).
PORTAL_GOOGLE_CLIENT_ID=

# --- Cloudflare Turnstile (login/register bot protection)
# If unset, verification is skipped (local dev).
# Prefer CLOUDFLARE_TURNSTILE_SECRET_KEY over legacy alias below.
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# TURNSTILE_SECRET_KEY=

# --- Internal hooks (n8n, etc.) `{ "X-Portal-Internal-Key": "<value>" }`
# Minimum 16 characters when set; omit or leave empty to disable internal routes at runtime.
PORTAL_INTERNAL_API_KEY=

# --- Brevo transactional email (admin → customer welcome, etc.)
# API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Numeric template IDs from Brevo (see EYUP_EVENTS/email-templates/*.yml)
BREVO_TEMPLATE_ACCOUNT_CREATED=
BREVO_TEMPLATE_ACCOUNT_CREATED_TEMP_PASSWORD=
# Optional future templates:
# BREVO_TEMPLATE_DEPOSIT_DUE=
# BREVO_TEMPLATE_INVOICE_DUE=
# BREVO_TEMPLATE_POST_EVENT_THANK_YOU=
# BREVO_TEMPLATE_CONTACT_AUTORESPONDER=
# Override default "Sign in" link in emails (else PORTAL_CORS_ORIGINS / eyupevents.uk)
# PORTAL_PUBLIC_ORIGIN=https://eyupevents.uk
# Optional sender override (otherwise Brevo uses the template default)
# BREVO_SENDER_EMAIL=info@eyupevents.uk
# BREVO_SENDER_NAME=EYUP EVENTS

# --- Stripe (deposits & balance — checkout sessions, webhooks TBD)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook URL (register in Stripe Dashboard): https://requests.eyupevents.uk/api/v1/stripe/webhook
# Events: checkout.session.completed, checkout.session.expired
# STRIPE_CHECKOUT_SUCCESS_URL=https://eyupevents.uk/events/payment-return?outcome=success&return=customer&session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=https://eyupevents.uk/events/payment-return?outcome=cancel&return=customer&session_id={CHECKOUT_SESSION_ID}

# --- Customer PII at rest (optional)
# AES-GCM key: 32-byte value as 64-char hex OR base64-encoded 32 raw bytes (see docs).
# If unset, PII stays plaintext — production emits a startup warning until you configure a key.
PORTAL_PII_ENCRYPTION_KEY=

# --- Seed script only (`npm run portal-seed`) ---
# EYUP_PORTAL_SEED_CUSTOMER_EMAIL=customer@demo.eyupevents.uk
# EYUP_PORTAL_SEED_DJ_EMAIL=dj@demo.eyupevents.uk
# EYUP_PORTAL_SEED_ADMIN_EMAIL=admin@demo.eyupevents.uk
# EYUP_PORTAL_SEED_PASSWORD=ChangeMeDemo123!
