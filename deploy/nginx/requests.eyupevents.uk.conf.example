# Reverse proxy for MobileDJay portal API (requests.eyupevents.uk).
#
# Install (Ubuntu):
#   sudo cp deploy/nginx/requests.eyupevents.uk.conf.example /etc/nginx/sites-available/requests.eyupevents.uk
#   sudo ln -sf /etc/nginx/sites-available/requests.eyupevents.uk /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# After certbot, merge client_max_body_size into your SSL server block if certbot
# created a separate file — uploads fail with HTTP 413 if this stays at 1m (default).

upstream mobiledjay_portal {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name requests.eyupevents.uk;

    # Catalog + gallery uploads (multer allows up to 10–15 MB per file)
    client_max_body_size 20M;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_pass http://mobiledjay_portal;
    }
}
