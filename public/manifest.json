{
  "name": "MobileDJay",
  "short_name": "MobileDJay",
  "description": "Mobile DJ request app with GIF and media support",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#007bff",
  "icons": [
    {
      "src": "/images/dj-bg.jpg",
      "sizes": "192x192",
      "type": "image/jpeg"
    }
  ],
  "capabilities": [
    "rich-text-input",
    "media-input",
    "gif-input",
    "emoji-input"
  ],
  "rich_input": {
    "supported_formats": ["image/gif", "image/jpeg", "image/png", "image/webp"],
    "max_file_size": 10485760
  }
}
