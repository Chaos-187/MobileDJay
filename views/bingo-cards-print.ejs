<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bingo cards — <%= event.name %></title>
    <link href="/css/bingo.css?v=13" rel="stylesheet">
</head>
<body class="bingo-print-body">
    <div class="bingo-print-toolbar no-print">
        <p><strong><%= event.name %></strong> — batch <code><%= batchId %></code> (<%= cards.length %> cards)</p>
        <button type="button" onclick="window.print()">Print</button>
        <button type="button" onclick="window.close()">Close</button>
    </div>

    <% const perSheet = 4; %>
    <% for (let sheetStart = 0; sheetStart < cards.length; sheetStart += perSheet) { %>
    <% const sheetCards = cards.slice(sheetStart, sheetStart + perSheet); %>
    <section class="bingo-print-sheet" aria-label="Print sheet <%= Math.floor(sheetStart / perSheet) + 1 %>">
        <div class="bingo-print-grid">
            <% sheetCards.forEach(function(card) { %>
            <article class="bingo-print-card">
                <header class="bingo-print-header">
                    <div class="bingo-print-header__text">
                        <div class="bingo-print-brand">EYUP EVENTS — Bingo</div>
                        <div class="bingo-print-serial">Serial <strong><%= card.serial %></strong></div>
                        <div class="bingo-print-event"><%= event.name %></div>
                    </div>
                    <div class="bingo-print-barcode-wrap" title="Serial <%= card.serial %>">
                        <svg class="bingo-barcode" role="img" aria-label="Barcode <%= card.serial %>" data-serial="<%= card.serial %>"></svg>
                    </div>
                </header>
                <table class="bingo-card-table" aria-label="Bingo card <%= card.serial %>">
                    <thead>
                        <tr>
                            <th>1–9</th>
                            <th>10–19</th>
                            <th>20–29</th>
                            <th>30–39</th>
                            <th>40–49</th>
                            <th>50–59</th>
                            <th>60–69</th>
                            <th>70–79</th>
                            <th>80–90</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% card.grid.forEach(function(row) { %>
                        <tr>
                            <% row.forEach(function(cell) { %>
                            <td class="<%= cell == null ? 'bingo-cell-blank' : '' %>"><%= cell == null ? '' : cell %></td>
                            <% }); %>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                <p class="bingo-print-foot">Mark called numbers · line · two lines · house</p>
            </article>
            <% }); %>
        </div>
    </section>
    <% } %>

    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <script>
        document.querySelectorAll('.bingo-barcode').forEach(function (el) {
            var serial = el.getAttribute('data-serial') || '';
            if (!serial) return;
            try {
                JsBarcode(el, serial, {
                    format: 'CODE128',
                    width: 1.15,
                    height: 34,
                    displayValue: false,
                    margin: 0
                });
            } catch (e) {
                console.warn('Barcode skipped for', serial, e);
            }
        });
    </script>
</body>
</html>
