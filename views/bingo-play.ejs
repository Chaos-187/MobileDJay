<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0a0a12">
    <title>Bingo — <%= event.name %></title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="/css/bingo.css?v=20" rel="stylesheet">
    <link href="/css/guest-hub.css?v=5" rel="stylesheet">
    <% if (event) { %><%- include('partials/guest-event-theme', { event: event }) %><% } %>
</head>
<body class="mdj-eyup-brand mdj-guest-bingo-page">
    <main class="guest-bingo-main container">
        <header class="guest-bingo-header">
            <a href="/event/<%= eventSlug %>" class="guest-bingo-back"><i class="fas fa-arrow-left"></i> Hub</a>
            <h1 class="guest-bingo-title"><%= event.name %></h1>
            <p class="guest-bingo-sub" id="guestBingoGameTitle" data-bingo-game-title>Bingo</p>
        </header>

        <div id="guestBingoJoin" class="guest-bingo-panel" data-bingo-join>
            <p class="text-muted small mb-3">Grab a <strong>virtual card</strong> on your phone or link a <strong>paper card</strong> by serial.</p>
            <div id="guestBingoGamesList" class="guest-bingo-games-list" data-bingo-games-list></div>
        </div>

        <div id="guestBingoPlay" class="guest-bingo-panel" data-bingo-play hidden>
            <button type="button" class="btn btn-link guest-bingo-back-lobby px-0" data-bingo-back-lobby>
                <i class="fas fa-arrow-left me-1" aria-hidden="true"></i>All games &amp; cards
            </button>
            <p class="guest-bingo-meta" id="guestBingoMeta" data-bingo-meta></p>
            <label class="guest-bingo-auto-dab form-check form-switch">
                <input class="form-check-input" type="checkbox" data-bingo-auto-dab checked>
                <span>Auto-dabber (marks called numbers)</span>
            </label>
            <div class="guest-bingo-card-picks" data-bingo-card-picks hidden></div>
            <div class="guest-bingo-card-wrap" data-bingo-card-wrap>
                <header class="guest-bingo-card-head">
                    <div class="guest-bingo-card-head__top">
                        <div class="guest-bingo-card-head__serial">
                            <span class="guest-bingo-card-head__label">Your card</span>
                            <span class="guest-bingo-card-head__serial-row">
                                <span class="guest-bingo-card-head__mode" data-bingo-card-mode hidden></span>
                                <strong class="guest-bingo-card-head__serial-val" id="guestBingoSerial" data-bingo-serial title="">—</strong>
                            </span>
                        </div>
                        <div class="guest-bingo-card-head__togo guest-bingo-togo-block" data-bingo-togo-block>
                            <span class="guest-bingo-card-head__label">To go</span>
                            <span class="guest-bingo-card-head__togo-val guest-bingo-togo-value" data-bingo-progress aria-label="">—</span>
                        </div>
                    </div>
                    <div class="guest-bingo-card-recent" aria-label="Last five numbers called">
                        <span class="guest-bingo-card-head__label">Recent calls</span>
                        <div class="guest-bingo-card-recent__track" data-bingo-recent-balls>
                            <span class="guest-bingo-recent-empty">—</span></div>
                    </div>
                </header>
                <div id="guestBingoCard" class="guest-bingo-card-grid guest-bingo-card" data-bingo-card aria-label="Your bingo card"></div>
            </div>
            <span id="guestBingoLastBall" data-bingo-last-ball hidden aria-hidden="true">—</span>
            <p class="guest-bingo-playing-for" id="guestBingoPlayingFor" data-bingo-playing-for></p>
            <button type="button" class="btn btn-warning btn-lg w-100 guest-bingo-call-btn" data-bingo-call>Call</button>
            <details class="guest-bingo-more-claims small mt-2">
                <summary>Other claims</summary>
                <div class="guest-bingo-claim-row mt-2">
                    <button type="button" class="btn btn-outline-warning btn-sm guest-bingo-claim" data-bingo-claim data-claim="line">1 Line</button>
                    <button type="button" class="btn btn-outline-warning btn-sm guest-bingo-claim" data-bingo-claim data-claim="two-lines">2 Lines</button>
                    <button type="button" class="btn btn-outline-warning btn-sm guest-bingo-claim" data-bingo-claim data-claim="house">Full house</button>
                </div>
            </details>
            <p id="guestBingoClaimResult" class="guest-bingo-claim-result small" data-bingo-claim-result role="status"></p>
        </div>
    </main>
    <script src="/js/guest-session.js"></script>
    <script>
        window.eventSlug = '<%= eventSlug %>';
        window.guestBingoGameId = <%= typeof gameId !== 'undefined' && gameId ? gameId : 'null' %>;
    </script>
    <script src="/js/guest-bingo-play.js?v=10"></script>
    <script src="/js/guest-bingo.js?v=3"></script>
</body>
</html>