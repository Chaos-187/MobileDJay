<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0a0a12">
    <title>Bingo — <%= event.name %></title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="/css/bingo.css?v=38" rel="stylesheet">
    <link href="/css/guest-hub.css?v=5" rel="stylesheet">
    <% if (event) { %><%- include('partials/guest-event-theme', { event: event }) %><% } %>
</head>
<body class="mdj-eyup-brand mdj-guest-bingo-page">
    <main class="guest-bingo-main container">
        <header class="guest-bingo-header">
            <a href="/event/<%= eventSlug %>" class="guest-bingo-back"><i class="fas fa-arrow-left"></i> Hub</a>
            <h1 class="guest-bingo-title"><%= event.name %></h1>
            <p class="guest-bingo-sub" id="guestBingoGameTitle" data-bingo-game-title>Bingo</p>
        </header>

        <div id="guestBingoJoin" class="guest-bingo-panel" data-bingo-join>
            <p class="text-muted small mb-3">Buy <strong>virtual tickets</strong> on your phone or link a <strong>paper card</strong> by serial.</p>
            <div id="guestBingoGamesList" class="guest-bingo-games-list" data-bingo-games-list></div>
        </div>

        <div id="guestBingoPlay" class="guest-bingo-panel" data-bingo-play hidden>
            <div class="guest-bingo-play-head">
                <button type="button" class="guest-bingo-back-lobby" data-bingo-back-lobby>
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    <span>Games &amp; cards</span>
                </button>
                <p class="guest-bingo-meta" id="guestBingoMeta" data-bingo-meta></p>
            </div>
            <button type="button" class="btn btn-outline-light guest-bingo-buy-tickets mb-2 w-100" data-bingo-buy-tickets hidden>
                Buy tickets
            </button>
            <div class="guest-bingo-play-options" role="group" aria-label="Play options">
                <label class="guest-bingo-opt">
                    <span class="guest-bingo-opt__icon" aria-hidden="true"><i class="fas fa-highlighter"></i></span>
                    <span class="guest-bingo-opt__copy">
                        <span class="guest-bingo-opt__title">Auto-dabber</span>
                        <span class="guest-bingo-opt__hint">Marks called numbers</span>
                    </span>
                    <input class="guest-bingo-opt__input" type="checkbox" data-bingo-auto-dab checked>
                    <span class="guest-bingo-opt__switch" aria-hidden="true"></span>
                </label>
                <label class="guest-bingo-opt">
                    <span class="guest-bingo-opt__icon" aria-hidden="true"><i class="fas fa-volume-low"></i></span>
                    <span class="guest-bingo-opt__copy">
                        <span class="guest-bingo-opt__title">Caller sound</span>
                        <span class="guest-bingo-opt__hint">Speak each ball on this phone</span>
                    </span>
                    <input class="guest-bingo-opt__input" type="checkbox" data-bingo-caller-sound checked>
                    <span class="guest-bingo-opt__switch" aria-hidden="true"></span>
                </label>
            </div>
            <div class="guest-bingo-intro" data-bingo-intro hidden aria-live="polite">
                <div class="guest-bingo-intro__card">
                    <p class="guest-bingo-intro__eyebrow"><i class="fas fa-table-cells" aria-hidden="true"></i> Bingo starting soon</p>
                    <p class="guest-bingo-intro__prize" data-bingo-intro-prize>Playing for · 1 Line</p>
                    <div class="guest-bingo-intro__ring-wrap">
                        <svg class="guest-bingo-intro__ring" viewBox="0 0 120 120" aria-hidden="true">
                            <circle class="guest-bingo-intro__ring-track" cx="60" cy="60" r="52"></circle>
                            <circle class="guest-bingo-intro__ring-progress" data-bingo-intro-ring cx="60" cy="60" r="52"></circle>
                        </svg>
                        <div class="guest-bingo-intro__sec" data-bingo-intro-sec>30</div>
                    </div>
                    <p class="guest-bingo-intro__hint">Get your cards ready — numbers will be called when the countdown finishes.</p>
                </div>
            </div>
            <div class="guest-bingo-callboard" data-bingo-recent-strip aria-label="Called numbers and prizes">
                <div class="guest-bingo-callboard__main">
                    <div class="guest-bingo-callboard__balls" data-bingo-recent-balls>
                        <span class="guest-bingo-recent-empty">—</span>
                    </div>
                    <p class="guest-bingo-callboard__progress" data-bingo-call-progress hidden></p>
                </div>
                <div class="guest-bingo-prize-bar" data-bingo-prize-bar aria-label="Prizes"></div>
            </div>
            <div class="guest-bingo-cards-stack guest-bingo-tickets" data-bingo-cards-stack></div>
            <span id="guestBingoLastBall" data-bingo-last-ball hidden aria-hidden="true">—</span>
            <p class="guest-bingo-playing-for" id="guestBingoPlayingFor" data-bingo-playing-for></p>
            <div class="guest-bingo-call-dock" data-bingo-call-dock>
                <p id="guestBingoClaimResult" class="guest-bingo-claim-result guest-bingo-call-dock__status small" data-bingo-claim-result role="status"></p>
                <button type="button" class="btn btn-warning btn-lg w-100 guest-bingo-call-btn guest-bingo-call-dock__btn" data-bingo-call>Claim</button>
            </div>
            <details class="guest-bingo-more-claims small mt-2">
                <summary>Other claims</summary>
                <div class="guest-bingo-claim-row mt-2">
                    <button type="button" class="btn btn-outline-warning btn-sm guest-bingo-claim" data-bingo-claim data-claim="line">1 Line</button>
                    <button type="button" class="btn btn-outline-warning btn-sm guest-bingo-claim" data-bingo-claim data-claim="two-lines">2 Lines</button>
                    <button type="button" class="btn btn-outline-warning btn-sm guest-bingo-claim" data-bingo-claim data-claim="house">Full house</button>
                </div>
            </details>
        </div>
    </main>
    <script src="/js/guest-session.js"></script>
    <script>
        window.eventSlug = '<%= eventSlug %>';
        window.guestBingoGameId = <%= typeof gameId !== 'undefined' && gameId ? gameId : 'null' %>;
    </script>
    <script src="/js/guest-bingo-play.js?v=33"></script>
    <script src="/js/guest-bingo.js?v=3"></script>
</body>
</html>