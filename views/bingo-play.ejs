<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0a0a12">
    <title>Bingo — <%= event.name %></title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="/css/bingo.css?v=63" rel="stylesheet">
    <link href="/css/bingo-themes.css?v=8" rel="stylesheet">
    <link href="/css/guest-hub.css?v=5" rel="stylesheet">
    <% if (event) { %><%- include('partials/guest-event-theme', { event: event }) %><% } %>
</head>
<body class="mdj-eyup-brand mdj-guest-bingo-page">
    <main class="guest-bingo-main container">
        <header class="guest-bingo-header">
            <a href="/event/<%= eventSlug %>" class="guest-bingo-back"><i class="fas fa-arrow-left"></i> Hub</a>
            <h1 class="guest-bingo-title"><%= event.name %></h1>
            <p class="guest-bingo-sub" id="guestBingoGameTitle" data-bingo-game-title>Bingo</p>
        </header>

        <div id="guestBingoJoin" class="guest-bingo-panel" data-bingo-join>
            <p class="text-muted small mb-3">Pick a game and get <strong>virtual tickets</strong> on your phone.</p>
            <div id="guestBingoGamesList" class="guest-bingo-games-list" data-bingo-games-list></div>
        </div>

        <div id="guestBingoPlay" class="guest-bingo-panel guest-bingo-play-shell" data-bingo-play hidden>
            <div class="guest-bingo-play-toolbar">
                <div class="guest-bingo-play-toolbar__main">
                    <button type="button" class="guest-bingo-back-lobby guest-bingo-toolbar-btn" data-bingo-back-lobby>
                        <i class="fas fa-arrow-left" aria-hidden="true"></i>
                        <span>Back to lobby</span>
                    </button>
                    <button type="button" class="guest-bingo-toolbar-btn guest-bingo-toolbar-btn--buy btn btn-warning" data-bingo-buy-tickets>Buy tickets</button>
                    <button type="button" class="guest-bingo-settings-btn guest-bingo-toolbar-btn guest-bingo-toolbar-btn--icon" data-bingo-settings-open aria-label="Play settings">
                        <i class="fas fa-gear" aria-hidden="true"></i>
                    </button>
                </div>
                <p class="guest-bingo-play-status guest-bingo-meta" id="guestBingoMeta" data-bingo-meta>Waiting to start</p>
            </div>
            <div class="guest-bingo-countdown-bar" data-bingo-countdown hidden aria-live="polite">
                <span class="guest-bingo-countdown-bar__kind" data-bingo-countdown-kind">Starting</span>
                <span class="guest-bingo-countdown-bar__sec"><strong data-bingo-countdown-sec>0</strong><span class="guest-bingo-countdown-bar__s">s</span></span>
                <span class="guest-bingo-countdown-bar__extra" data-bingo-countdown-extra></span>
            </div>
            <div class="guest-bingo-resume" data-bingo-resume hidden aria-live="polite">
                <p class="guest-bingo-resume__eyebrow"><i class="fas fa-play-circle" aria-hidden="true"></i> Resuming</p>
                <p class="guest-bingo-resume__ball">Last call · <strong data-bingo-resume-ball>—</strong></p>
                <p class="guest-bingo-resume__sec"><span data-bingo-resume-sec>5</span> seconds</p>
            </div>
            <div class="guest-bingo-intro" data-bingo-intro hidden aria-live="polite">
                <div class="guest-bingo-intro__card">
                    <p class="guest-bingo-intro__eyebrow"><i class="fas fa-table-cells" aria-hidden="true"></i> Bingo starting soon</p>
                    <p class="guest-bingo-intro__prize" data-bingo-intro-prize>Playing for · 1 Line</p>
                    <div class="guest-bingo-intro__ring-wrap">
                        <svg class="guest-bingo-intro__ring" viewBox="0 0 120 120" aria-hidden="true">
                            <circle class="guest-bingo-intro__ring-track" cx="60" cy="60" r="52"></circle>
                            <circle class="guest-bingo-intro__ring-progress" data-bingo-intro-ring cx="60" cy="60" r="52"></circle>
                        </svg>
                        <div class="guest-bingo-intro__sec" data-bingo-intro-sec>30</div>
                    </div>
                    <p class="guest-bingo-intro__hint">Get your cards ready — numbers will be called when the countdown finishes.</p>
                </div>
            </div>
            <div class="guest-bingo-prize-row" data-bingo-prize-bar aria-label="Prizes playing for"></div>
            <div class="guest-bingo-cards-stack guest-bingo-tickets" data-bingo-cards-stack></div>
            <span id="guestBingoLastBall" data-bingo-last-ball hidden aria-hidden="true">—</span>
            <p class="guest-bingo-playing-for" id="guestBingoPlayingFor" data-bingo-playing-for></p>
            <details class="guest-bingo-more-claims small mt-2">
                <summary>Other claims</summary>
                <div class="guest-bingo-claim-row mt-2">
                    <button type="button" class="btn btn-outline-warning btn-sm guest-bingo-claim" data-bingo-claim data-claim="line">1 Line</button>
                    <button type="button" class="btn btn-outline-warning btn-sm guest-bingo-claim" data-bingo-claim data-claim="two-lines">2 Lines</button>
                    <button type="button" class="btn btn-outline-warning btn-sm guest-bingo-claim" data-bingo-claim data-claim="house">Full house</button>
                </div>
            </details>
        </div>
        <div class="guest-bingo-play-dock" data-bingo-play-dock hidden>
            <div class="guest-bingo-action-bar guest-bingo-call-dock" data-bingo-call-dock>
                <p id="guestBingoClaimResult" class="guest-bingo-claim-result guest-bingo-call-dock__status small" data-bingo-claim-result role="status"></p>
                <button type="button" class="btn btn-warning btn-lg w-100 guest-bingo-call-btn guest-bingo-call-dock__btn" data-bingo-call data-dock-mode="claim">Claim</button>
                <div class="guest-bingo-called-line" aria-label="Recent calls">
                    <span class="guest-bingo-called-line__count" data-bingo-call-progress hidden></span>
                    <div class="guest-bingo-called-line__track" data-bingo-recent-balls dir="ltr">
                        <span class="guest-bingo-recent-empty">—</span>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <script src="/js/guest-session.js"></script>
    <script>
        window.eventSlug = '<%= eventSlug %>';
        window.guestBingoGameId = <%= typeof gameId !== 'undefined' && gameId ? gameId : 'null' %>;
    </script>
    <script src="/js/bingo-theme.js?v=6"></script>
    <script src="/js/bingo-uk-calls.js?v=1"></script>
    <script src="/js/guest-bingo-play.js?v=72"></script>
    <script src="/js/guest-bingo.js?v=4"></script>
</body>
</html>