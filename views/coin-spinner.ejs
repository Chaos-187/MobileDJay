<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Heads or Tails - MobileDJay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="/css/spinner-show.css?v=2" rel="stylesheet">
</head>
<body class="spinner-page spinner-theme-coin">
    <div class="mdj-spinner-rays" aria-hidden="true"></div>

    <div class="control-panel" id="controlPanel">
        <div><strong>Heads or Tails</strong></div>
        <div>Waiting for DJ to trigger...</div>
        <div id="spinStatus">Ready</div>
    </div>

    <div class="spinner-container">
        <h1 class="spinner-title">
            <i class="fas fa-coins me-3"></i>
            Heads or Tails
            <i class="fas fa-scale-balanced ms-3"></i>
        </h1>
        <div class="spinner-window">
            <div class="spinner-slot" id="spinnerSlot">
                <div class="mdj-slot-vignette" aria-hidden="true"></div>
                <div class="mdj-slot-highlight" aria-hidden="true"></div>
                <div class="waiting-message" id="waitingMessage">
                    <i class="fas fa-dice"></i>
                    <div>Waiting for DJ to flip...</div>
                </div>
                <div class="binary-options-list" id="optionsList" style="display: none;"></div>
            </div>
        </div>
    </div>

    <div class="winner-display winner-display--coin" id="winnerDisplay">
        <div class="winner-label">The coin says</div>
        <div class="winner-icon"><i class="fas fa-coins"></i></div>
        <div class="winner-title" id="winnerTitle"></div>
        <div class="winner-artist" id="winnerSub"></div>
    </div>

    <script>
        window.MDJ_BINARY_SPINNER_CONFIG = {
            apiSegment: 'coin-spinner',
            confettiColors: ['#ffd54f', '#cfd8dc', '#fff', '#ffb300'],
            options: [
                { key: 'heads', label: 'Heads', icon: 'fa-face-smile', modifier: 'heads' },
                { key: 'tails', label: 'Tails', icon: 'fa-feather', modifier: 'tails' }
            ]
        };
        (function () {
            var params = new URLSearchParams(window.location.search);
            var slug = params.get('event') || params.get('eventSlug');
            if (slug) window.displayEventSlug = String(slug).trim();
        })();
    </script>
    <script src="/js/mdj-binary-spinner.js"></script>
    <script src="/js/binary-spinner-page.js?v=1"></script>
</body>
</html>
