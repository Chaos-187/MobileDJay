<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bingo caller · <%= event.name %> — MobileDJay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Orbitron:wght@400;700;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/eyup-site-chrome.css" rel="stylesheet">
    <link href="/css/dj-dash-theme.css?v=1" rel="stylesheet">
    <link href="/css/bingo.css?v=12" rel="stylesheet">
</head>
<body class="mdj-eyup-brand mdj-dash-tools dark-mode mdj-bingo-caller-page">
    <div class="mdj-scanlines" aria-hidden="true"></div>

    <nav class="mdj-site-navbar mdj-site-navbar--minimal" aria-label="Bingo caller">
        <div class="nav-container">
            <div class="logo" role="img" aria-label="EYUP EVENTS">
                <span class="logo-text">EYUP</span>
                <span class="logo-accent">EVENTS</span>
                <span class="logo-subtitle"><i class="fas fa-bullhorn" aria-hidden="true"></i> Bingo caller · <%= event.name %></span>
            </div>
            <div class="mdj-nav-controls d-flex flex-wrap gap-2">
                <a href="/dj" class="btn btn-outline-light btn-sm"><i class="fas fa-arrow-left me-1"></i>Dashboard</a>
                <a href="/dj/display/<%= event.slug %>" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm"><i class="fas fa-tv me-1"></i>Venue display</a>
                <a href="/dj?event=<%= event.id %>" class="btn btn-outline-secondary btn-sm d-none d-md-inline-flex"><i class="fas fa-layer-group me-1"></i>Prepare cards</a>
            </div>
        </div>
    </nav>

    <main class="mdj-bingo-caller-main container-fluid">
        <header class="mdj-bingo-caller-top">
            <div>
                <h1 class="mdj-bingo-caller-title">Live caller</h1>
                <p class="mdj-bingo-caller-lede mb-0">Run balls, claims and verification — the guest screen updates automatically.</p>
            </div>
            <div class="mdj-bingo-caller-top-status">
                <span id="bingoRunStatus" class="badge bg-secondary mdj-bingo-status-pill">Not running</span>
            </div>
        </header>

        <div class="mdj-bingo-surface mb-3 p-3" aria-label="Active game">
            <label class="mdj-bingo-field-label" for="bingoActiveGameSelect">Game</label>
            <select id="bingoActiveGameSelect" class="form-select form-select-lg mdj-bingo-input mb-2">
                <option value="">— Legacy / live game —</option>
            </select>
            <p id="bingoActiveGameMeta" class="small text-muted mb-0"></p>
            <p id="bingoTargetHint" class="mdj-bingo-hint small text-muted mt-2 mb-0"></p>
        </div>

        <div id="gamePanelBingo" class="mdj-bingo-console mdj-bingo-caller-console" data-game-panel="bingo">
            <input type="hidden" id="bingoBallCount" value="90">
            <input type="hidden" id="bingoCallInterval" value="5">
            <input type="hidden" id="bingoIntroSeconds" value="30">
            <input type="checkbox" id="bingoAutoCall" hidden>
            <input type="checkbox" id="bingoVoiceCall" hidden>

            <div class="mdj-bingo-caller-layout">
                <section class="mdj-bingo-surface mdj-bingo-surface--primary" aria-label="Run game">
                    <div class="mdj-bingo-run-hero mdj-bingo-run-hero--caller">
                        <div>
                            <span class="mdj-bingo-run-hero-label">Last ball called</span>
                            <div id="bingoLastBall" class="mdj-bingo-hero-ball">—</div>
                        </div>
                        <span id="bingoPausedHint" class="mdj-bingo-paused-chip" hidden><i class="fas fa-pause-circle"></i> Paused</span>
                    </div>

                    <p class="mdj-bingo-field-label">Playing for</p>
                    <div class="mdj-bingo-playing-for btn-group w-100 mb-3" role="group" aria-label="Playing for">
                        <button type="button" class="btn mdj-bingo-touch-seg active" data-playing-for="line">1 Line</button>
                        <button type="button" class="btn mdj-bingo-touch-seg" data-playing-for="two-lines">2 Lines</button>
                        <button type="button" class="btn mdj-bingo-touch-seg" data-playing-for="house">House</button>
                    </div>

                    <div class="mdj-bingo-action-grid mdj-bingo-action-grid--caller">
                        <button type="button" class="btn mdj-bingo-touch-action mdj-bingo-btn-go" id="bingoStartBtn"><i class="fas fa-play"></i> Start</button>
                        <button type="button" class="btn mdj-bingo-touch-action mdj-bingo-btn-stop" id="bingoStopBtn"><i class="fas fa-stop"></i> Stop</button>
                        <button type="button" class="btn mdj-bingo-touch-action mdj-bingo-touch-action--wide mdj-bingo-btn-call" id="bingoCallBtn"><i class="fas fa-bullhorn"></i> Next ball</button>
                        <button type="button" class="btn mdj-bingo-touch-action mdj-bingo-btn-secondary" id="bingoResumeBtn" hidden><i class="fas fa-play-circle"></i> Resume</button>
                        <button type="button" class="btn mdj-bingo-touch-action mdj-bingo-btn-secondary" id="bingoSkipIntroBtn" hidden><i class="fas fa-forward"></i> Skip intro</button>
                    </div>
                </section>

                <section class="mdj-bingo-surface mdj-bingo-surface--claims" aria-label="Claims">
                    <h3 class="mdj-bingo-surface-title"><i class="fas fa-bolt text-warning me-1" aria-hidden="true"></i>Claims</h3>
                    <p class="mdj-bingo-pane-lead mb-3">Flash the big screen. Calling pauses until you tap <strong>Resume</strong>.</p>
                    <div class="mdj-bingo-claim-btns mb-3">
                        <button type="button" class="btn mdj-bingo-touch-claim mdj-bingo-claim-line" id="bingoFlashLineBtn">1 Line</button>
                        <button type="button" class="btn mdj-bingo-touch-claim mdj-bingo-claim-two" id="bingoFlashTwoLinesBtn">2 Lines</button>
                        <button type="button" class="btn mdj-bingo-touch-claim mdj-bingo-claim-house" id="bingoFlashHouseBtn">Full house</button>
                    </div>
                    <label class="mdj-bingo-field-label" for="bingoVerifySerial">Verify serial</label>
                    <input type="text" class="form-control form-control-lg mdj-bingo-input mb-2" id="bingoVerifySerial" placeholder="Card serial" autocomplete="off" inputmode="text">
                    <input type="hidden" id="bingoVerifyClaimType" value="house">
                    <p class="mdj-bingo-field-label mb-1">Verify as</p>
                    <div class="mdj-bingo-verify-type btn-group w-100 mb-3" role="group" aria-label="Claim type">
                        <button type="button" class="btn mdj-bingo-touch-seg" data-verify-claim="line">1 Line</button>
                        <button type="button" class="btn mdj-bingo-touch-seg" data-verify-claim="two-lines">2 Lines</button>
                        <button type="button" class="btn mdj-bingo-touch-seg active" data-verify-claim="house">House</button>
                    </div>
                    <button type="button" class="btn w-100 mdj-bingo-touch-action mdj-bingo-btn-verify" id="bingoVerifyBtn"><i class="fas fa-check-double"></i> Verify &amp; flash</button>
                    <p id="bingoVerifyResult" class="mdj-bingo-verify-result small mb-0 mt-2"></p>
                </section>
            </div>

            <section class="mdj-bingo-surface mdj-bingo-surface--board mt-3" aria-label="Number board">
                <h3 class="mdj-bingo-surface-title mdj-bingo-surface-title--inline">Number board</h3>
                <div class="mdj-bingo-grid-scroll mdj-bingo-grid-scroll--caller" aria-label="Called numbers">
                    <div id="bingoAdminGrid" class="mdj-bingo-admin-grid"></div>
                </div>
            </section>
            <div id="bingoCalledStrip" class="mdj-bingo-called-strip mt-2" hidden aria-hidden="true"></div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.mdjGetPromptTargetSlug = function () { return <%- JSON.stringify(event.slug) %>; };
        window.mdjGetPromptTargetEventId = function () { return <%= event.id %>; };
        window.mdjGetPromptTargetName = function () { return <%- JSON.stringify(event.name) %>; };
    </script>
    <script src="/js/dj-api.js?v=1"></script>
    <script src="/js/dj-bingo.js?v=12"></script>
</body>
</html>
