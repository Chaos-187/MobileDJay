<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Bingo caller · <%= event.name %> — MobileDJay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/eyup-site-chrome.css" rel="stylesheet">
    <link href="/css/dj-dash-theme.css?v=1" rel="stylesheet">
    <link href="/css/bingo.css?v=14" rel="stylesheet">
</head>
<body class="mdj-eyup-brand mdj-dash-tools dark-mode mdj-bingo-caller-page">
    <header class="mdj-caller-header">
        <div class="mdj-caller-header__left">
            <a href="/dj" class="mdj-caller-back" title="Dashboard"><i class="fas fa-arrow-left" aria-hidden="true"></i></a>
            <div class="mdj-caller-brand">
                <span class="mdj-caller-eyebrow">Bingo caller</span>
                <span class="mdj-caller-event"><%= event.name %></span>
            </div>
        </div>
        <div class="mdj-caller-header__game">
            <label class="visually-hidden" for="bingoActiveGameSelect">Active game</label>
            <select id="bingoActiveGameSelect" class="form-select mdj-caller-game-select">
                <option value="">— Legacy / live game —</option>
            </select>
            <p id="bingoActiveGameMeta" class="mdj-caller-game-meta mb-0"></p>
        </div>
        <div class="mdj-caller-header__right">
            <span id="bingoRunStatus" class="badge bg-secondary mdj-bingo-status-pill mdj-caller-status">Not running</span>
            <a href="/dj/display/<%= event.slug %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-light mdj-caller-display-btn" title="Venue display">
                <i class="fas fa-tv" aria-hidden="true"></i><span class="d-none d-md-inline ms-1">Display</span>
            </a>
        </div>
        <p id="bingoTargetHint" class="mdj-caller-display-hint mb-0"></p>
    </header>

    <main class="mdj-bingo-caller-main" id="gamePanelBingo" data-game-panel="bingo">
        <input type="hidden" id="bingoBallCount" value="90">
        <input type="hidden" id="bingoCallInterval" value="5">
        <input type="hidden" id="bingoIntroSeconds" value="30">
        <input type="checkbox" id="bingoAutoCall" hidden>
        <input type="checkbox" id="bingoVoiceCall" hidden>

        <div class="mdj-caller-stage">
            <section class="mdj-caller-panel mdj-caller-panel--run" aria-label="Run game">
                <div class="mdj-caller-ball-spotlight">
                    <span class="mdj-bingo-run-hero-label">Last ball</span>
                    <div id="bingoLastBall" class="mdj-bingo-hero-ball mdj-caller-hero-ball">—</div>
                    <span id="bingoPausedHint" class="mdj-bingo-paused-chip mdj-caller-paused" hidden><i class="fas fa-pause-circle"></i> Paused</span>
                </div>

                <p class="mdj-bingo-field-label mb-1">Playing for</p>
                <div class="mdj-bingo-playing-for btn-group w-100 mdj-caller-segments" role="group" aria-label="Playing for">
                    <button type="button" class="btn mdj-bingo-touch-seg active" data-playing-for="line">1 Line</button>
                    <button type="button" class="btn mdj-bingo-touch-seg" data-playing-for="two-lines">2 Lines</button>
                    <button type="button" class="btn mdj-bingo-touch-seg" data-playing-for="house">House</button>
                </div>

                <div class="mdj-caller-controls">
                    <button type="button" class="btn mdj-caller-cta mdj-bingo-btn-call" id="bingoCallBtn">
                        <i class="fas fa-bullhorn" aria-hidden="true"></i> Next ball
                    </button>
                    <div class="mdj-caller-controls-row">
                        <button type="button" class="btn mdj-bingo-touch-action mdj-bingo-btn-go" id="bingoStartBtn"><i class="fas fa-play"></i> Start</button>
                        <button type="button" class="btn mdj-bingo-touch-action mdj-bingo-btn-stop" id="bingoStopBtn"><i class="fas fa-stop"></i> Stop</button>
                        <button type="button" class="btn mdj-bingo-touch-action mdj-bingo-btn-secondary" id="bingoResumeBtn" hidden><i class="fas fa-play-circle"></i> Resume</button>
                        <button type="button" class="btn mdj-bingo-touch-action mdj-bingo-btn-secondary" id="bingoSkipIntroBtn" hidden><i class="fas fa-forward"></i> Skip intro</button>
                    </div>
                </div>
            </section>

            <section class="mdj-caller-panel mdj-caller-panel--claims" aria-label="Claims and verification">
                <h2 class="mdj-caller-panel-title"><i class="fas fa-bolt text-warning" aria-hidden="true"></i> Claims</h2>
                <p class="mdj-caller-panel-lede">Flash the screen — calling pauses until <strong>Resume</strong>.</p>
                <div class="mdj-bingo-claim-btns mdj-caller-claims">
                    <button type="button" class="btn mdj-bingo-touch-claim mdj-bingo-claim-line" id="bingoFlashLineBtn">1 Line</button>
                    <button type="button" class="btn mdj-bingo-touch-claim mdj-bingo-claim-two" id="bingoFlashTwoLinesBtn">2 Lines</button>
                    <button type="button" class="btn mdj-bingo-touch-claim mdj-bingo-claim-house" id="bingoFlashHouseBtn">Full house</button>
                </div>

                <div class="mdj-caller-verify">
                    <label class="mdj-bingo-field-label" for="bingoVerifySerial">Card serial</label>
                    <input type="text" class="form-control form-control-lg mdj-bingo-input mdj-caller-serial-input" id="bingoVerifySerial" placeholder="Scan or type serial" autocomplete="off" inputmode="text">
                    <input type="hidden" id="bingoVerifyClaimType" value="house">
                    <p class="mdj-bingo-field-label mb-1 mt-2">Verify as</p>
                    <div class="mdj-bingo-verify-type btn-group w-100 mb-2" role="group" aria-label="Claim type">
                        <button type="button" class="btn mdj-bingo-touch-seg" data-verify-claim="line">Line</button>
                        <button type="button" class="btn mdj-bingo-touch-seg" data-verify-claim="two-lines">2 Lines</button>
                        <button type="button" class="btn mdj-bingo-touch-seg active" data-verify-claim="house">House</button>
                    </div>
                    <button type="button" class="btn w-100 mdj-bingo-touch-action mdj-bingo-btn-verify mdj-caller-verify-btn" id="bingoVerifyBtn">
                        <i class="fas fa-check-double"></i> Verify &amp; flash
                    </button>
                    <p id="bingoVerifyResult" class="mdj-bingo-verify-result small mb-0 mt-2"></p>
                </div>
            </section>
        </div>

        <section class="mdj-caller-board" aria-label="Number board">
            <div class="mdj-caller-board-head">
                <h2 class="mdj-caller-board-title">Number board</h2>
            </div>
            <div class="mdj-bingo-grid-scroll mdj-bingo-grid-scroll--caller">
                <div id="bingoAdminGrid" class="mdj-bingo-admin-grid mdj-caller-admin-grid"></div>
            </div>
        </section>
        <div id="bingoCalledStrip" class="mdj-bingo-called-strip" hidden aria-hidden="true"></div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.mdjGetPromptTargetSlug = function () { return <%- JSON.stringify(event.slug) %>; };
        window.mdjGetPromptTargetEventId = function () { return <%= event.id %>; };
        window.mdjGetPromptTargetName = function () { return <%- JSON.stringify(event.name) %>; };
    </script>
    <script src="/js/dj-api.js?v=1"></script>
    <script src="/js/dj-bingo.js?v=14"></script>
</body>
</html>
