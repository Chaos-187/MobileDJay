        const screenKaraokeSpinBtn = document.getElementById('screenKaraokeSpinBtn');
        const screenGuestSpinBtn = document.getElementById('screenGuestSpinBtn');
        if (screenKaraokeSpinBtn) {
            screenKaraokeSpinBtn.addEventListener('click', () =>
                triggerScreenKaraokeSpin(screenKaraokeSpinBtn)
            );
        }
        if (screenGuestSpinBtn) {
