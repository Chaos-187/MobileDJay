                            <div class="col-md-2 d-flex gap-1">
                                <button type="submit" class="btn btn-primary flex-grow-1" title="Add track">
                                    <i class="fas fa-plus"></i>
                                </button>
                                <button type="button" id="logNowPlayingBtn" class="btn btn-outline-info" title="Log current now playing">
