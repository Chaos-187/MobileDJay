        // ── Tracks played tab ──────────────────────────────────────────
        const tracksList = document.getElementById('tracksList');
        const trackCount = document.getElementById('trackCount');
        const addTrackForm = document.getElementById('addTrackForm');

        function getTrackEventId() {
            const id = eventSelect.value;
            if (id === 'all') {
                if (firstActiveOption) return firstActiveOption.value;
                return allEventOptions[0] ? allEventOptions[0].value : null;
            }
            return id;
        }

        function escapeTrackText(text) {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }

        function renderTrackRow(track, showEventName) {
            const card = document.createElement('div');
            card.className = 'card track-row mb-2';
            card.dataset.trackId = track.id;
            card.dataset.eventId = track.eventId || '';
            const when = new Date(track.playedAt).toLocaleString();
            const sourceLabel = track.source === 'now-playing' ? 'VirtualDJ' : 'Manual';
            card.innerHTML = `
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex align-items-center flex-wrap gap-1 mb-1">
                                <strong class="text-truncate">"${escapeTrackText(track.title)}"</strong>
                                ${showEventName && track.eventName ? `<span class="badge bg-dark">${escapeTrackText(track.eventName)}</span>` : ''}
                                <span class="badge bg-secondary track-source">${sourceLabel}</span>
                            </div>
                            ${track.artist ? `<div class="small">${escapeTrackText(track.artist)}</div>` : ''}
                            <small class="text-muted"><i class="fas fa-clock me-1"></i>${when}</small>
                        </div>
                        <button type="button" class="btn btn-outline-danger btn-sm track-delete" title="Remove">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            `;
            card.querySelector('.track-delete').addEventListener('click', async () => {
                if (!confirm('Remove this track from the played list?')) return;
                try {
                    const res = await mdjFetch(`/api/tracks-played/${track.id}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.success) loadTracks();
                } catch (err) {
                    console.error('Failed to delete track:', err);
                }
            });
            return card;
        }

        async function loadTracks() {
            const selected = eventSelect.value;
            tracksList.innerHTML = '<span class="text-muted small">Loading…</span>';
            try {
                const eventIds = selected === 'all' ? Object.keys(eventNames) : [selected];
                if (eventIds.length === 0) {
                    tracksList.innerHTML = '<span class="text-muted small">Select an event to view tracks.</span>';
                    trackCount.textContent = '0';
                    return;
                }
                const lists = await Promise.all(eventIds.map(id =>
                    mdjFetch(`/api/events/${id}/tracks-played`).then(r => r.ok ? r.json() : [])
                ));
                const tracks = lists.flat().sort((a, b) => new Date(b.playedAt) - new Date(a.playedAt));
                trackCount.textContent = tracks.length;
                tracksList.innerHTML = '';
                if (tracks.length === 0) {
                    tracksList.innerHTML = '<span class="text-muted small">No tracks logged yet.</span>';
                    return;
                }
                tracks.forEach(track => tracksList.appendChild(renderTrackRow(track, selected === 'all')));
            } catch (err) {
                console.error('Failed to load tracks:', err);
                tracksList.innerHTML = '<span class="text-danger small">Could not load tracks.</span>';
            }
        }

        addTrackForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const eventId = getTrackEventId();
            if (!eventId) {
                alert('Select an event first.');
                return;
            }
            const title = document.getElementById('trackTitle').value.trim();
            const artist = document.getElementById('trackArtist').value.trim();
            const playedAtRaw = document.getElementById('trackPlayedAt').value;
            let played_at = null;
            if (playedAtRaw) {
                played_at = new Date(playedAtRaw).toISOString();
            }
            try {
                const res = await mdjFetch(`/api/events/${eventId}/tracks-played`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, artist, played_at })
                });
                const data = await res.json();
                if (data.success) {
                    document.getElementById('trackTitle').value = '';
                    document.getElementById('trackArtist').value = '';
                    document.getElementById('trackPlayedAt').value = '';
                    loadTracks();
                } else {
                    alert(data.error || 'Failed to add track');
                }
            } catch (err) {
                console.error('Failed to add track:', err);
            }
        });

        document.getElementById('logNowPlayingBtn').addEventListener('click', async () => {
            const eventId = getTrackEventId();
            if (!eventId) {
                alert('Select an event first.');
                return;
            }
            try {
                const res = await mdjFetch(`/api/events/${eventId}/tracks-played/from-now-playing`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    loadTracks();
                } else {
                    alert(data.error || 'Nothing playing');
                }
            } catch (err) {
                console.error('Failed to log now playing:', err);
            }
        });

        document.getElementById('refreshTracksBtn').addEventListener('click', loadTracks);
        loadTracks();

        // ── Guests tab ───────────────────────────────────────────────
        const guestsList = document.getElementById('guestsList');
        const guestCount = document.getElementById('guestCount');

        function getGuestEventId() {
            return getTrackEventId();
        }

        function escapeGuestText(text) {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }

        function formatGuestStatus(guest) {
            if (guest.status === 'banned') {
                return '<span class="badge bg-danger">Banned</span>';
            }
            if (guest.status === 'silenced') {
                const until = guest.silencedUntil ? new Date(guest.silencedUntil).toLocaleString() : '';
                return `<span class="badge bg-warning text-dark" title="Until ${until}">Silenced</span>`;
            }
            return '<span class="badge bg-success">Active</span>';
        }

        async function moderateGuest(eventId, customerName, action, durationMinutes) {
            const body = { customerName, action };
            if (durationMinutes) body.durationMinutes = durationMinutes;
            const res = await mdjFetch(`/api/events/${eventId}/guests/moderate`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Moderation failed');
            return data;
        }

        async function removeGuestFromEvent(eventId, customerName) {
            const res = await mdjFetch(`/api/events/${eventId}/guests/remove`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ customerName })
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Could not remove guest');
            return data;
        }

        function renderGuestRow(guest, eventId, showEventName) {
            const card = document.createElement('div');
            card.className = 'card guest-row guest-row-clickable mb-2' + (guest.status === 'silenced' ? ' guest-row--silenced' : guest.status === 'banned' ? ' guest-row--banned' : '');
            card.dataset.guestName = guest.customerName;
            card.dataset.eventId = eventId;
            const lastSeen = guest.lastSeenAt ? new Date(guest.lastSeenAt).toLocaleString() : '—';
            const silencedNote = guest.status === 'silenced' && guest.silencedUntil
                ? `<div class="small text-warning">Silenced until ${new Date(guest.silencedUntil).toLocaleString()}</div>` : '';

            card.innerHTML = `
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex align-items-center flex-wrap gap-1 mb-1">
                                <strong>${escapeGuestText(guest.customerName)}</strong>
                                ${formatGuestStatus(guest)}
                            </div>
                            <div class="guest-stats text-muted">
                                <span class="me-2"><i class="fas fa-music me-1"></i>${guest.requestCount}</span>
                                <span class="me-2"><i class="fas fa-envelope me-1"></i>${guest.messageCount}</span>
                                <span class="me-2"><i class="fas fa-camera me-1"></i>${guest.photoCount}</span>
                                <span><i class="fas fa-clock me-1"></i>${lastSeen}</span>
                            </div>
                            ${silencedNote}
                        </div>
                        <div class="d-flex flex-wrap gap-1 guest-actions"></div>
                    </div>
                    <div class="guest-silence-panel" hidden></div>
                </div>
            `;

            const actions = card.querySelector('.guest-actions');
            const silencePanel = card.querySelector('.guest-silence-panel');

            function closeSilencePanel() {
                silencePanel.classList.remove('is-open');
                silencePanel.hidden = true;
                silencePanel.innerHTML = '';
            }

            if (guest.status !== 'banned') {
                const silenceBtn = document.createElement('button');
                silenceBtn.type = 'button';
                silenceBtn.className = 'btn btn-outline-warning btn-sm';
                silenceBtn.textContent = 'Silence';
                silenceBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isOpen = silencePanel.classList.contains('is-open');
                    document.querySelectorAll('.guest-silence-panel.is-open').forEach(panel => {
                        if (panel !== silencePanel) {
                            panel.classList.remove('is-open');
                            panel.hidden = true;
                            panel.innerHTML = '';
                        }
                    });
                    if (isOpen) {
                        closeSilencePanel();
                        return;
                    }
                    silencePanel.hidden = false;
                    silencePanel.classList.add('is-open');
                    silencePanel.innerHTML = '';
                    [
                        { minutes: 15, label: '15 min' },
                        { minutes: 30, label: '30 min' },
                        { minutes: 60, label: '1 hour' },
                        { minutes: 120, label: '2 hours' },
                        { minutes: 240, label: '4 hours' }
                    ].forEach(({ minutes, label }) => {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'btn btn-sm btn-outline-warning';
                        btn.textContent = label;
                        btn.addEventListener('click', async () => {
                            try {
                                await moderateGuest(eventId, guest.customerName, 'silence', minutes);
                                closeSilencePanel();
                                loadGuests();
                            } catch (err) {
                                alert(err.message);
                            }
                        });
                        silencePanel.appendChild(btn);
                    });
                });
                actions.appendChild(silenceBtn);
            }

            if (guest.status !== 'banned') {
                const banBtn = document.createElement('button');
                banBtn.type = 'button';
                banBtn.className = 'btn btn-outline-danger btn-sm';
                banBtn.textContent = 'Ban';
                banBtn.addEventListener('click', async (e) => {
                    e.stopPropagation();
                    if (!confirm(`Ban ${guest.customerName}? They will not be able to submit requests or messages.`)) return;
                    try {
                        await moderateGuest(eventId, guest.customerName, 'ban');
                        loadGuests();
                    } catch (err) {
                        alert(err.message);
                    }
                });
                actions.appendChild(banBtn);
            } else {
                const reinstateBtn = document.createElement('button');
                reinstateBtn.type = 'button';
                reinstateBtn.className = 'btn btn-outline-success btn-sm';
                reinstateBtn.textContent = 'Reinstate';
                reinstateBtn.addEventListener('click', async (e) => {
                    e.stopPropagation();
                    try {
                        await moderateGuest(eventId, guest.customerName, 'active');
                        loadGuests();
                    } catch (err) {
                        alert(err.message);
                    }
                });
                actions.appendChild(reinstateBtn);
            }

            if (guest.status === 'silenced') {
                const unmuteBtn = document.createElement('button');
                unmuteBtn.type = 'button';
                unmuteBtn.className = 'btn btn-outline-secondary btn-sm';
                unmuteBtn.textContent = 'Unsilence';
                unmuteBtn.addEventListener('click', async (e) => {
                    e.stopPropagation();
                    try {
                        await moderateGuest(eventId, guest.customerName, 'active');
                        loadGuests();
                    } catch (err) {
                        alert(err.message);
                    }
                });
                actions.prepend(unmuteBtn);
            }

            const removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.className = 'btn btn-outline-secondary btn-sm';
            removeBtn.title = 'Remove from guest list';
            removeBtn.innerHTML = '<i class="fas fa-user-minus"></i>';
            removeBtn.addEventListener('click', async (e) => {
                e.stopPropagation();
                const msg =
                    `Remove ${guest.customerName} from this event's guest list?\n\n` +
                    'Their past requests and messages stay in the system; they can appear again if they interact with the event.';
                if (!confirm(msg)) return;
                try {
                    await removeGuestFromEvent(eventId, guest.customerName);
                    loadGuests();
                } catch (err) {
                    alert(err.message);
                }
            });
            actions.appendChild(removeBtn);

            card.addEventListener('click', (e) => {
                if (e.target.closest('.guest-actions') || e.target.closest('.guest-silence-panel')) return;
                openGuestConversation(eventId, guest.customerName);
            });

            return card;
        }

        const guestConversationModal = new bootstrap.Modal(document.getElementById('guestConversationModal'));
        const guestConversationTimeline = document.getElementById('guestConversationTimeline');
        let activeGuestConv = { eventId: null, customerName: null };

        function renderConversationItem(item, guestName) {
            const when = new Date(item.timestamp).toLocaleString();
            if (item.kind === 'message') {
                return `
                    <div class="guest-conv-item from-guest">
                        <div class="guest-conv-bubble">
                            <div class="fw-semibold mb-1"><i class="fas fa-user me-1"></i>${escapeGuestText(guestName)}${item.private ? ' <span class="badge bg-purple-pill">DJ Only</span>' : ''}</div>
                            <div class="guest-conv-body">${item.body}</div>
                            <div class="guest-conv-meta"><i class="fas fa-clock me-1"></i>${when}</div>
                        </div>
                    </div>`;
            }
            if (item.kind === 'reply') {
                return `
                    <div class="guest-conv-item from-dj">
                        <div class="guest-conv-bubble">
                            <div class="fw-semibold mb-1"><i class="fas fa-user-tie me-1"></i>DJ${item.direct ? ' <span class="badge bg-dark">Direct</span>' : ''}</div>
                            <div>${escapeGuestText(item.body)}</div>
                            <div class="guest-conv-meta"><i class="fas fa-clock me-1"></i>${when}</div>
                        </div>
                    </div>`;
            }
            const isKaraoke = (item.type || '').indexOf('karaoke') !== -1;
            const icon = isKaraoke ? 'microphone' : 'music';
            return `
                <div class="guest-conv-item from-request">
                    <div class="guest-conv-bubble">
                        <div class="fw-semibold mb-1"><i class="fas fa-${icon} me-1"></i>${isKaraoke ? 'Karaoke' : 'Song'} request</div>
                        <div>"${escapeGuestText(item.title || 'Unknown')}"${item.artist ? ` — ${escapeGuestText(item.artist)}` : ''}</div>
                        ${item.note ? `<div class="small mt-1">${escapeGuestText(item.note)}</div>` : ''}
                        <div class="guest-conv-meta"><i class="fas fa-clock me-1"></i>${when}</div>
                    </div>
                </div>`;
        }

        async function openGuestConversation(eventId, customerName) {
            activeGuestConv = { eventId, customerName };
            document.getElementById('guestConvName').textContent = customerName;
            document.getElementById('guestConvEventHint').textContent = eventNames[eventId]
                ? `Event: ${eventNames[eventId]}`
                : '';
            guestConversationTimeline.innerHTML = '<span class="text-muted small">Loading…</span>';
            guestConversationModal.show();
            try {
                const res = await mdjFetch(`/api/events/${eventId}/guests/${encodeURIComponent(customerName)}/conversation`);
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Failed to load conversation');
                if (!data.items || data.items.length === 0) {
                    guestConversationTimeline.innerHTML = '<p class="text-muted text-center py-4 mb-0">No conversation yet.</p>';
                    return;
                }
                guestConversationTimeline.innerHTML = data.items
                    .map(item => renderConversationItem(item, customerName))
                    .join('');
                guestConversationTimeline.scrollTop = guestConversationTimeline.scrollHeight;
            } catch (err) {
                console.error('Failed to load guest conversation:', err);
                guestConversationTimeline.innerHTML = '<p class="text-danger small">Could not load conversation.</p>';
            }
        }

        document.getElementById('guestConvReplyBtn').addEventListener('click', () => {
            if (!activeGuestConv.customerName) return;
            guestConversationModal.hide();
            document.dispatchEvent(new CustomEvent('mdj-open-reply', {
                detail: {
                    customerName: activeGuestConv.customerName,
                    originalType: 'message',
                    originalId: ''
                }
            }));
        });

        async function loadGuests() {
            const selected = eventSelect.value;
            guestsList.innerHTML = '<span class="text-muted small">Loading…</span>';
            try {
                const eventIds = selected === 'all' ? Object.keys(eventNames) : [selected];
                if (eventIds.length === 0) {
                    guestsList.innerHTML = '<span class="text-muted small">Select an event to view guests.</span>';
                    guestCount.textContent = '0';
                    return;
                }
                const lists = await Promise.all(eventIds.map(id =>
                    mdjFetch(`/api/events/${id}/guests`).then(r => r.ok ? r.json() : [])
                ));
                const guests = lists.flat().sort((a, b) => new Date(b.lastSeenAt) - new Date(a.lastSeenAt));
                guestCount.textContent = guests.length;
                guestsList.innerHTML = '';
                if (guests.length === 0) {
                    guestsList.innerHTML = '<span class="text-muted small">No guests yet.</span>';
                    return;
                }
                guests.forEach(guest => {
                    guestsList.appendChild(renderGuestRow(guest, guest.eventId, selected === 'all'));
                });
            } catch (err) {
                console.error('Failed to load guests:', err);
                guestsList.innerHTML = '<span class="text-danger small">Could not load guests.</span>';
            }
        }

        document.getElementById('refreshGuestsBtn').addEventListener('click', loadGuests);

        document.addEventListener('click', (e) => {
            if (e.target.closest('.guest-silence-panel') ||
                e.target.closest('.guest-actions .btn-outline-warning')) {
                return;
            }
            document.querySelectorAll('.guest-silence-panel.is-open').forEach(panel => {
                panel.classList.remove('is-open');
                panel.hidden = true;
                panel.innerHTML = '';
            });
        });

        loadGuests();
    });
    </script>
</body>
</html>
