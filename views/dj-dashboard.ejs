    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
    <script src="/js/dj-dashboard.js"></script>

    <script>
    // Dark mode toggle and Event management
    document.addEventListener('DOMContentLoaded', function() {
        const toggle = document.getElementById('darkModeToggle');
        const label = document.getElementById('darkModeLabel');
        if (toggle) {
            function setMode(enabled) {
                if (enabled) {
                    document.body.classList.add('dark-mode');
                    if (label) label.textContent = 'Dark';
                    const icon = toggle.querySelector('i');
                    if (icon) { icon.classList.remove('fa-moon'); icon.classList.add('fa-sun'); }
                } else {
                    document.body.classList.remove('dark-mode');
                    if (label) label.textContent = 'Light';
                    const icon = toggle.querySelector('i');
                    if (icon) { icon.classList.remove('fa-sun'); icon.classList.add('fa-moon'); }
                }
            }

            const saved = localStorage.getItem('djDashboardDarkMode') === 'true';
            setMode(saved);

            toggle.addEventListener('click', function() {
                const enabled = document.body.classList.toggle('dark-mode');
                localStorage.setItem('djDashboardDarkMode', enabled ? 'true' : 'false');
                setMode(enabled);
            });
        }

        // Active Event Filter
        const eventSelect = document.getElementById('activeEventSelect');
        
        // Load saved event selection — default to first active event so screen prompts work out of the box
        let savedEventId = localStorage.getItem('djActiveEventId') || 'all';
        const allEventOptions = Array.from(eventSelect.options).filter(o => o.value !== 'all');
        const firstActiveOption = allEventOptions.find(o => !o.classList.contains('mdj-dash-event-opt--inactive'));
        if (savedEventId === 'all' && firstActiveOption) {
            savedEventId = firstActiveOption.value;
        }
        if (savedEventId !== 'all' && !allEventOptions.some(o => o.value === savedEventId)) {
            savedEventId = firstActiveOption ? firstActiveOption.value : 'all';
        }
        eventSelect.value = savedEventId;
        
        function filterByEvent(eventId) {
            const requestCards = document.querySelectorAll('.request-card');
            const messageCards = document.querySelectorAll('#messagesList > .card[data-message-id]');
            
            let visibleRequests = 0;
            let visibleMessages = 0;
            let awaitingReply = 0;
            
            // Filter requests
            requestCards.forEach(card => {
                const cardEventId = card.dataset.eventId;
                if (eventId === 'all' || cardEventId === eventId || (!cardEventId && eventId === 'all')) {
                    card.style.display = '';
                    visibleRequests++;
                } else {
                    card.style.display = 'none';
                }
            });
            
            // Filter messages
            messageCards.forEach(card => {
                const cardEventId = card.dataset.eventId;
                if (eventId === 'all' || cardEventId === eventId || (!cardEventId && eventId === 'all')) {
                    card.style.display = '';
                    visibleMessages++;
                    if (card.dataset.needsReply === '1') awaitingReply++;
                } else {
                    card.style.display = 'none';
                }
            });
            
            // Update counts in tabs
            document.getElementById('requestCount').textContent = visibleRequests;
            document.getElementById('messageCount').textContent = awaitingReply;
            
            // Save selection
            localStorage.setItem('djActiveEventId', eventId);
        }
        
        // Apply initial filter
        filterByEvent(savedEventId);

        document.addEventListener('mdj-dashboard-refreshed', function() {
            filterByEvent(eventSelect.value);
        });
        
        // Listen for changes
        eventSelect.addEventListener('change', function() {
            filterByEvent(this.value);
            loadPhotos();
            loadTracks();
            loadGuests();
            updateDisplayLink();
            updatePromptButtonsState();
        });

        // ── Photos tab ────────────────────────────────────────────────
        const photosGrid = document.getElementById('photosGrid');
        const photoCount = document.getElementById('photoCount');

        // Event id → name/slug maps from the selector options
        const eventNames = {};
        const eventSlugs = {};
        allEventOptions.forEach(opt => {
            eventNames[opt.value] = opt.textContent.trim().replace(/ \(inactive\)$/, '');
            // dataset.slug is unreliable on <option> in some browsers — use getAttribute
            eventSlugs[opt.value] = opt.getAttribute('data-slug') || '';
        });

        function getSelectedEventSlug() {
            const id = eventSelect.value;
            if (id === 'all') return null;
            return eventSlugs[id] || null;
        }

        // Slug used for screen prompts: selected event, or first active event as fallback
        function getPromptTargetSlug() {
            const direct = getSelectedEventSlug();
            if (direct) return direct;
            if (firstActiveOption) {
                return eventSlugs[firstActiveOption.value] || firstActiveOption.getAttribute('data-slug') || null;
            }
            const any = allEventOptions[0];
            return any ? (eventSlugs[any.value] || any.getAttribute('data-slug') || null) : null;
        }

        function getPromptTargetName() {
            const id = eventSelect.value;
            if (id !== 'all') return eventNames[id] || null;
            if (firstActiveOption) return eventNames[firstActiveOption.value] || null;
            return allEventOptions[0] ? eventNames[allEventOptions[0].value] : null;
        }

        function getPromptTargetEventId() {
            const id = eventSelect.value;
            if (id !== 'all') return id;
            if (firstActiveOption) return firstActiveOption.value;
            return allEventOptions[0] ? allEventOptions[0].value : null;
        }

        window.mdjGetPromptTargetSlug = getPromptTargetSlug;
        window.mdjGetPromptTargetEventId = getPromptTargetEventId;
        window.mdjGetPromptTargetName = getPromptTargetName;

        function updateDisplayLink() {
            const link = document.getElementById('openDisplayLink');
            const slug = getSelectedEventSlug() || getPromptTargetSlug();
            const spinnerLink = document.getElementById('karaokeSpinnerDisplayLink');
            const guestSpinnerLink = document.getElementById('guestSpinnerDisplayLink');
            if (slug) {
                link.href = '/dj/display/' + slug;
                link.style.display = '';
                if (spinnerLink) {
                    spinnerLink.href =
                        '/karaoke-spinner?event=' + encodeURIComponent(slug);
                }
                if (guestSpinnerLink) {
                    guestSpinnerLink.href =
                        '/guest-spinner?event=' + encodeURIComponent(slug);
                }
            } else {
                link.style.display = 'none';
                if (spinnerLink) spinnerLink.href = '/karaoke-spinner';
                if (guestSpinnerLink) guestSpinnerLink.href = '/guest-spinner';
            }
        }

        function escapePhotoText(text) {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }

        function renderPhotoCard(photo, showEventName) {
            const card = document.createElement('div');
            card.className = 'dash-photo-card' + (photo.hidden ? ' hidden-photo' : '');
            card.dataset.photoId = photo.id;
            const who = escapePhotoText(photo.customerName || 'Anonymous');
            const eventLabel = showEventName ? `<div class="text-warning">${escapePhotoText(eventNames[photo.eventId] || '')}</div>` : '';
            card.innerHTML = `
                <img src="${photo.url}" alt="${escapePhotoText(photo.caption || 'Event photo')}" loading="lazy">
                ${photo.hidden ? '<span class="badge bg-secondary dash-photo-hidden-badge"><i class="fas fa-eye-slash me-1"></i>Hidden</span>' : ''}
                <div class="dash-photo-actions">
                    <button type="button" class="btn btn-sm btn-warning photo-showcase" title="Show on display screen">
                        <i class="fas fa-tv"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-dark photo-toggle-hidden" title="${photo.hidden ? 'Unhide' : 'Hide'}">
                        <i class="fas fa-eye${photo.hidden ? '' : '-slash'}"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-danger photo-delete" title="Delete permanently">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
                <div class="dash-photo-meta">
                    ${eventLabel}
                    <span><i class="fas fa-user me-1"></i>${who}</span>
                    ${photo.caption ? `<div>${escapePhotoText(photo.caption)}</div>` : ''}
                    <div class="text-muted">${new Date(photo.timestamp).toLocaleString()}</div>
                </div>
            `;
            card.querySelector('img').addEventListener('click', () => window.open(photo.url, '_blank'));
            card.querySelector('.photo-showcase').addEventListener('click', async function() {
                const icon = this.querySelector('i');
                try {
                    const res = await fetch(`/api/photos/${photo.id}/showcase`, { method: 'POST' });
                    const data = await res.json();
                    if (data.success) {
                        icon.classList.replace('fa-tv', 'fa-check');
                        setTimeout(() => icon.classList.replace('fa-check', 'fa-tv'), 2000);
                    }
                } catch (err) {
                    console.error('Failed to showcase photo:', err);
                }
            });
            card.querySelector('.photo-toggle-hidden').addEventListener('click', async () => {
                try {
                    const res = await fetch(`/api/photos/${photo.id}/hidden`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ hidden: !photo.hidden })
                    });
                    const data = await res.json();
                    if (data.success) loadPhotos();
                } catch (err) {
                    console.error('Failed to update photo:', err);
                }
            });
            card.querySelector('.photo-delete').addEventListener('click', async () => {
                if (!confirm('Delete this photo permanently? This cannot be undone.')) return;
                try {
                    const res = await fetch(`/api/photos/${photo.id}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.success) {
                        card.remove();
                        photoCount.textContent = Math.max(0, parseInt(photoCount.textContent, 10) - 1);
                    }
                } catch (err) {
                    console.error('Failed to delete photo:', err);
                }
            });
            return card;
        }

        async function loadPhotos() {
            const selected = eventSelect.value;
            photosGrid.innerHTML = '<span class="text-muted small">Loading…</span>';
            try {
                const eventIds = selected === 'all' ? Object.keys(eventNames) : [selected];
                const lists = await Promise.all(eventIds.map(id =>
                    fetch(`/api/events/${id}/photos`).then(r => r.ok ? r.json() : [])
                ));
                const photos = lists.flat().sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
                photoCount.textContent = photos.length;
                photosGrid.innerHTML = '';
                if (photos.length === 0) {
                    photosGrid.innerHTML = '<span class="text-muted small">No photos yet — guest photos will appear here.</span>';
                    return;
                }
                photos.forEach(photo => photosGrid.appendChild(renderPhotoCard(photo, selected === 'all')));
            } catch (err) {
                console.error('Failed to load photos:', err);
                photosGrid.innerHTML = '<span class="text-danger small">Could not load photos.</span>';
            }
        }

        document.getElementById('refreshPhotosBtn').addEventListener('click', loadPhotos);
        loadPhotos();

        // ── Screen prompts tab ───────────────────────────────────────
        const promptBtnGrid = document.getElementById('promptBtnGrid');
        const styleClassMap = {
            'great-moves': 'prompt-great-moves',
            'dance-floor': 'prompt-dance-floor',
            'dad-dancing': 'prompt-dad-dancing',
            'slow-dance': 'prompt-slow-dance',
            'last-orders': 'prompt-last-orders',
            'applause': 'prompt-applause',
            'selfie': 'prompt-selfie'
        };

        function updatePromptButtonsState() {
            const slug = getPromptTargetSlug();
            const name = getPromptTargetName();
            const hint = document.getElementById('promptTargetHint');
            const hasEvent = !!slug;

            if (hint) {
                if (!hasEvent) {
                    hint.innerHTML = '<span class="text-warning"><i class="fas fa-triangle-exclamation me-1"></i>No events configured — create an event first.</span>';
                } else if (eventSelect.value === 'all') {
                    hint.innerHTML = `<span class="text-info"><i class="fas fa-tv me-1"></i>Sending to <strong>${name}</strong> (select a specific event above to choose another)</span>`;
                } else {
                    hint.innerHTML = `<span class="text-success"><i class="fas fa-tv me-1"></i>Display: <strong>${name}</strong></span>`;
                }
            }

            promptBtnGrid.querySelectorAll('.prompt-trigger-btn').forEach(btn => {
                btn.disabled = !hasEvent;
                btn.title = hasEvent ? 'Show on display screen' : 'Create an event first';
            });

            const karaokeSpinBtn = document.getElementById('screenKaraokeSpinBtn');
            const guestSpinBtn = document.getElementById('screenGuestSpinBtn');
            [karaokeSpinBtn, guestSpinBtn].forEach(btn => {
                if (!btn) return;
                btn.disabled = !hasEvent;
                btn.title = hasEvent
                    ? 'Trigger on event display'
                    : 'Select or create an event first';
            });
        }

        async function loadPromptButtons() {
            try {
                const prompts = await fetch('/api/display-prompts').then(r => r.json());
                promptBtnGrid.innerHTML = '';
                Object.entries(prompts).forEach(([id, p]) => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'btn prompt-trigger-btn ' + (styleClassMap[p.style] || '');
                    btn.dataset.promptId = id;
                    btn.innerHTML = `
                        <span class="prompt-btn-icon"><i class="fas ${p.icon}"></i></span>
                        <span class="prompt-btn-label">${p.label}</span>
                        <span class="prompt-btn-sub">${p.subtext || ''}</span>
                    `;
                    btn.addEventListener('click', () => triggerScreenPrompt(id, btn));
                    promptBtnGrid.appendChild(btn);
                });
                updatePromptButtonsState();
            } catch (err) {
                console.error('Failed to load prompts:', err);
                promptBtnGrid.innerHTML = '<span class="text-danger small">Could not load screen prompts.</span>';
            }
        }

        async function triggerScreenPrompt(promptId, btn) {
            const slug = getPromptTargetSlug();
            if (!slug) {
                alert('No events available. Create an event first.');
                return;
            }
            const wasDisabled = btn.disabled;
            btn.disabled = true;
            try {
                const res = await fetch(`/api/display/${encodeURIComponent(slug)}/prompt/${encodeURIComponent(promptId)}`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    btn.classList.add('triggered');
                    setTimeout(() => btn.classList.remove('triggered'), 2000);
                } else {
                    alert(data.error || 'Failed to trigger prompt');
                }
            } catch (err) {
                console.error('Prompt trigger failed:', err);
                alert('Could not reach the server.');
            } finally {
                btn.disabled = wasDisabled || !getPromptTargetSlug();
                updatePromptButtonsState();
            }
        }

        loadPromptButtons();
        updateDisplayLink();

        async function triggerScreenKaraokeSpin(btn) {
            const slug = getPromptTargetSlug();
            if (!slug) {
                alert('No events available. Create an event first.');
                return;
            }
            btn.disabled = true;
            try {
                const res = await fetch(
                    `/api/display/${encodeURIComponent(slug)}/karaoke/trigger-spin`,
                    { method: 'POST' }
                );
                const data = await res.json();
                if (data.success && data.song) {
                    btn.classList.add('triggered');
                    setTimeout(() => btn.classList.remove('triggered'), 2000);
                } else {
                    alert(data.error || 'Could not trigger karaoke spinner');
                }
            } catch (err) {
                console.error('Karaoke spin failed:', err);
                alert('Could not reach the server.');
            } finally {
                updatePromptButtonsState();
            }
        }

        async function triggerScreenGuestSpin(btn) {
            const slug = getPromptTargetSlug();
            if (!slug) {
                alert('No events available. Create an event first.');
                return;
            }
            btn.disabled = true;
            try {
                const res = await fetch(
                    `/api/display/${encodeURIComponent(slug)}/guest-spinner/trigger`,
                    { method: 'POST' }
                );
                const data = await res.json();
                if (data.success) {
                    btn.classList.add('triggered');
                    setTimeout(() => btn.classList.remove('triggered'), 2000);
                } else {
                    alert(data.error || 'Could not pick a guest');
                }
            } catch (err) {
                console.error('Guest spin failed:', err);
                alert('Could not reach the server.');
            } finally {
                updatePromptButtonsState();
            }
        }

        const screenKaraokeSpinBtn = document.getElementById('screenKaraokeSpinBtn');
        const screenGuestSpinBtn = document.getElementById('screenGuestSpinBtn');
        if (screenKaraokeSpinBtn) {
            screenKaraokeSpinBtn.addEventListener('click', () =>
                triggerScreenKaraokeSpin(screenKaraokeSpinBtn)
            );
        }
        if (screenGuestSpinBtn) {
            screenGuestSpinBtn.addEventListener('click', () =>
                triggerScreenGuestSpin(screenGuestSpinBtn)
            );
        }

        // ── Tracks played tab ──────────────────────────────────────────
        const tracksList = document.getElementById('tracksList');
        const trackCount = document.getElementById('trackCount');
        const addTrackForm = document.getElementById('addTrackForm');

        function getTrackEventId() {
            const id = eventSelect.value;
            if (id === 'all') {
                if (firstActiveOption) return firstActiveOption.value;
                return allEventOptions[0] ? allEventOptions[0].value : null;
            }
            return id;
        }

        function escapeTrackText(text) {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }

        function renderTrackRow(track, showEventName) {
            const card = document.createElement('div');
            card.className = 'card track-row mb-2';
            card.dataset.trackId = track.id;
            card.dataset.eventId = track.eventId || '';
            const when = new Date(track.playedAt).toLocaleString();
            const sourceLabel = track.source === 'now-playing' ? 'VirtualDJ' : 'Manual';
            card.innerHTML = `
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex align-items-center flex-wrap gap-1 mb-1">
                                <strong class="text-truncate">"${escapeTrackText(track.title)}"</strong>
                                ${showEventName && track.eventName ? `<span class="badge bg-dark">${escapeTrackText(track.eventName)}</span>` : ''}
                                <span class="badge bg-secondary track-source">${sourceLabel}</span>
                            </div>
                            ${track.artist ? `<div class="small">${escapeTrackText(track.artist)}</div>` : ''}
                            <small class="text-muted"><i class="fas fa-clock me-1"></i>${when}</small>
                        </div>
                        <button type="button" class="btn btn-outline-danger btn-sm track-delete" title="Remove">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            `;
            card.querySelector('.track-delete').addEventListener('click', async () => {
                if (!confirm('Remove this track from the played list?')) return;
                try {
                    const res = await fetch(`/api/tracks-played/${track.id}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.success) loadTracks();
                } catch (err) {
                    console.error('Failed to delete track:', err);
                }
            });
            return card;
        }

        async function loadTracks() {
            const selected = eventSelect.value;
            tracksList.innerHTML = '<span class="text-muted small">Loading…</span>';
            try {
                const eventIds = selected === 'all' ? Object.keys(eventNames) : [selected];
                if (eventIds.length === 0) {
                    tracksList.innerHTML = '<span class="text-muted small">Select an event to view tracks.</span>';
                    trackCount.textContent = '0';
                    return;
                }
                const lists = await Promise.all(eventIds.map(id =>
                    fetch(`/api/events/${id}/tracks-played`).then(r => r.ok ? r.json() : [])
                ));
                const tracks = lists.flat().sort((a, b) => new Date(b.playedAt) - new Date(a.playedAt));
                trackCount.textContent = tracks.length;
                tracksList.innerHTML = '';
                if (tracks.length === 0) {
                    tracksList.innerHTML = '<span class="text-muted small">No tracks logged yet.</span>';
                    return;
                }
                tracks.forEach(track => tracksList.appendChild(renderTrackRow(track, selected === 'all')));
            } catch (err) {
                console.error('Failed to load tracks:', err);
                tracksList.innerHTML = '<span class="text-danger small">Could not load tracks.</span>';
            }
        }

        addTrackForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const eventId = getTrackEventId();
            if (!eventId) {
                alert('Select an event first.');
                return;
            }
            const title = document.getElementById('trackTitle').value.trim();
            const artist = document.getElementById('trackArtist').value.trim();
            const playedAtRaw = document.getElementById('trackPlayedAt').value;
            let played_at = null;
            if (playedAtRaw) {
                played_at = new Date(playedAtRaw).toISOString();
            }
            try {
                const res = await fetch(`/api/events/${eventId}/tracks-played`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, artist, played_at })
                });
                const data = await res.json();
                if (data.success) {
                    document.getElementById('trackTitle').value = '';
                    document.getElementById('trackArtist').value = '';
                    document.getElementById('trackPlayedAt').value = '';
                    loadTracks();
                } else {
                    alert(data.error || 'Failed to add track');
                }
            } catch (err) {
                console.error('Failed to add track:', err);
            }
        });

        document.getElementById('logNowPlayingBtn').addEventListener('click', async () => {
            const eventId = getTrackEventId();
            if (!eventId) {
                alert('Select an event first.');
                return;
            }
            try {
                const res = await fetch(`/api/events/${eventId}/tracks-played/from-now-playing`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    loadTracks();
                } else {
                    alert(data.error || 'Nothing playing');
                }
            } catch (err) {
                console.error('Failed to log now playing:', err);
            }
        });

        document.getElementById('refreshTracksBtn').addEventListener('click', loadTracks);
        loadTracks();

        // ── Guests tab ───────────────────────────────────────────────
        const guestsList = document.getElementById('guestsList');
        const guestCount = document.getElementById('guestCount');

        function getGuestEventId() {
            return getTrackEventId();
        }

        function escapeGuestText(text) {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }

        function formatGuestStatus(guest) {
            if (guest.status === 'banned') {
                return '<span class="badge bg-danger">Banned</span>';
            }
            if (guest.status === 'silenced') {
                const until = guest.silencedUntil ? new Date(guest.silencedUntil).toLocaleString() : '';
                return `<span class="badge bg-warning text-dark" title="Until ${until}">Silenced</span>`;
            }
            return '<span class="badge bg-success">Active</span>';
        }

        async function moderateGuest(eventId, customerName, action, durationMinutes) {
            const body = { customerName, action };
            if (durationMinutes) body.durationMinutes = durationMinutes;
            const res = await fetch(`/api/events/${eventId}/guests/moderate`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Moderation failed');
            return data;
        }

        function renderGuestRow(guest, eventId, showEventName) {
            const card = document.createElement('div');
            card.className = 'card guest-row guest-row-clickable mb-2' + (guest.status === 'silenced' ? ' guest-row--silenced' : guest.status === 'banned' ? ' guest-row--banned' : '');
            card.dataset.guestName = guest.customerName;
            card.dataset.eventId = eventId;
            const lastSeen = guest.lastSeenAt ? new Date(guest.lastSeenAt).toLocaleString() : '—';
            const silencedNote = guest.status === 'silenced' && guest.silencedUntil
                ? `<div class="small text-warning">Silenced until ${new Date(guest.silencedUntil).toLocaleString()}</div>` : '';

            card.innerHTML = `
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex align-items-center flex-wrap gap-1 mb-1">
                                <strong>${escapeGuestText(guest.customerName)}</strong>
                                ${formatGuestStatus(guest)}
                            </div>
                            <div class="guest-stats text-muted">
                                <span class="me-2"><i class="fas fa-music me-1"></i>${guest.requestCount}</span>
                                <span class="me-2"><i class="fas fa-envelope me-1"></i>${guest.messageCount}</span>
                                <span class="me-2"><i class="fas fa-camera me-1"></i>${guest.photoCount}</span>
                                <span><i class="fas fa-clock me-1"></i>${lastSeen}</span>
                            </div>
                            ${silencedNote}
                        </div>
                        <div class="d-flex flex-wrap gap-1 guest-actions"></div>
                    </div>
                    <div class="guest-silence-panel" hidden></div>
                </div>
            `;

            const actions = card.querySelector('.guest-actions');
            const silencePanel = card.querySelector('.guest-silence-panel');

            function closeSilencePanel() {
                silencePanel.classList.remove('is-open');
                silencePanel.hidden = true;
                silencePanel.innerHTML = '';
            }

            if (guest.status !== 'banned') {
                const silenceBtn = document.createElement('button');
                silenceBtn.type = 'button';
                silenceBtn.className = 'btn btn-outline-warning btn-sm';
                silenceBtn.textContent = 'Silence';
                silenceBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isOpen = silencePanel.classList.contains('is-open');
                    document.querySelectorAll('.guest-silence-panel.is-open').forEach(panel => {
                        if (panel !== silencePanel) {
                            panel.classList.remove('is-open');
                            panel.hidden = true;
                            panel.innerHTML = '';
                        }
                    });
                    if (isOpen) {
                        closeSilencePanel();
                        return;
                    }
                    silencePanel.hidden = false;
                    silencePanel.classList.add('is-open');
                    silencePanel.innerHTML = '';
                    [
                        { minutes: 15, label: '15 min' },
                        { minutes: 30, label: '30 min' },
                        { minutes: 60, label: '1 hour' },
                        { minutes: 120, label: '2 hours' },
                        { minutes: 240, label: '4 hours' }
                    ].forEach(({ minutes, label }) => {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'btn btn-sm btn-outline-warning';
                        btn.textContent = label;
                        btn.addEventListener('click', async () => {
                            try {
                                await moderateGuest(eventId, guest.customerName, 'silence', minutes);
                                closeSilencePanel();
                                loadGuests();
                            } catch (err) {
                                alert(err.message);
                            }
                        });
                        silencePanel.appendChild(btn);
                    });
                });
                actions.appendChild(silenceBtn);
            }

            if (guest.status !== 'banned') {
                const banBtn = document.createElement('button');
                banBtn.type = 'button';
                banBtn.className = 'btn btn-outline-danger btn-sm';
                banBtn.textContent = 'Ban';
                banBtn.addEventListener('click', async (e) => {
                    e.stopPropagation();
                    if (!confirm(`Ban ${guest.customerName}? They will not be able to submit requests or messages.`)) return;
                    try {
                        await moderateGuest(eventId, guest.customerName, 'ban');
                        loadGuests();
                    } catch (err) {
                        alert(err.message);
                    }
                });
                actions.appendChild(banBtn);
            } else {
                const reinstateBtn = document.createElement('button');
                reinstateBtn.type = 'button';
                reinstateBtn.className = 'btn btn-outline-success btn-sm';
                reinstateBtn.textContent = 'Reinstate';
                reinstateBtn.addEventListener('click', async (e) => {
                    e.stopPropagation();
                    try {
                        await moderateGuest(eventId, guest.customerName, 'active');
                        loadGuests();
                    } catch (err) {
                        alert(err.message);
                    }
                });
                actions.appendChild(reinstateBtn);
            }

            if (guest.status === 'silenced') {
                const unmuteBtn = document.createElement('button');
                unmuteBtn.type = 'button';
                unmuteBtn.className = 'btn btn-outline-secondary btn-sm';
                unmuteBtn.textContent = 'Unsilence';
                unmuteBtn.addEventListener('click', async (e) => {
                    e.stopPropagation();
                    try {
                        await moderateGuest(eventId, guest.customerName, 'active');
                        loadGuests();
                    } catch (err) {
                        alert(err.message);
                    }
                });
                actions.prepend(unmuteBtn);
            }

            card.addEventListener('click', (e) => {
                if (e.target.closest('.guest-actions') || e.target.closest('.guest-silence-panel')) return;
                openGuestConversation(eventId, guest.customerName);
            });

            return card;
        }

        const guestConversationModal = new bootstrap.Modal(document.getElementById('guestConversationModal'));
        const guestConversationTimeline = document.getElementById('guestConversationTimeline');
        let activeGuestConv = { eventId: null, customerName: null };

        function renderConversationItem(item, guestName) {
            const when = new Date(item.timestamp).toLocaleString();
            if (item.kind === 'message') {
                return `
                    <div class="guest-conv-item from-guest">
                        <div class="guest-conv-bubble">
                            <div class="fw-semibold mb-1"><i class="fas fa-user me-1"></i>${escapeGuestText(guestName)}${item.private ? ' <span class="badge bg-purple-pill">DJ Only</span>' : ''}</div>
                            <div class="guest-conv-body">${item.body}</div>
                            <div class="guest-conv-meta"><i class="fas fa-clock me-1"></i>${when}</div>
                        </div>
                    </div>`;
            }
            if (item.kind === 'reply') {
                return `
                    <div class="guest-conv-item from-dj">
                        <div class="guest-conv-bubble">
                            <div class="fw-semibold mb-1"><i class="fas fa-user-tie me-1"></i>DJ${item.direct ? ' <span class="badge bg-dark">Direct</span>' : ''}</div>
                            <div>${escapeGuestText(item.body)}</div>
                            <div class="guest-conv-meta"><i class="fas fa-clock me-1"></i>${when}</div>
                        </div>
                    </div>`;
            }
            const isKaraoke = (item.type || '').indexOf('karaoke') !== -1;
            const icon = isKaraoke ? 'microphone' : 'music';
            return `
                <div class="guest-conv-item from-request">
                    <div class="guest-conv-bubble">
                        <div class="fw-semibold mb-1"><i class="fas fa-${icon} me-1"></i>${isKaraoke ? 'Karaoke' : 'Song'} request</div>
                        <div>"${escapeGuestText(item.title || 'Unknown')}"${item.artist ? ` — ${escapeGuestText(item.artist)}` : ''}</div>
                        ${item.note ? `<div class="small mt-1">${escapeGuestText(item.note)}</div>` : ''}
                        <div class="guest-conv-meta"><i class="fas fa-clock me-1"></i>${when}</div>
                    </div>
                </div>`;
        }

        async function openGuestConversation(eventId, customerName) {
            activeGuestConv = { eventId, customerName };
            document.getElementById('guestConvName').textContent = customerName;
            document.getElementById('guestConvEventHint').textContent = eventNames[eventId]
                ? `Event: ${eventNames[eventId]}`
                : '';
            guestConversationTimeline.innerHTML = '<span class="text-muted small">Loading…</span>';
            guestConversationModal.show();
            try {
                const res = await fetch(`/api/events/${eventId}/guests/${encodeURIComponent(customerName)}/conversation`);
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Failed to load conversation');
                if (!data.items || data.items.length === 0) {
                    guestConversationTimeline.innerHTML = '<p class="text-muted text-center py-4 mb-0">No conversation yet.</p>';
                    return;
                }
                guestConversationTimeline.innerHTML = data.items
                    .map(item => renderConversationItem(item, customerName))
                    .join('');
                guestConversationTimeline.scrollTop = guestConversationTimeline.scrollHeight;
            } catch (err) {
                console.error('Failed to load guest conversation:', err);
                guestConversationTimeline.innerHTML = '<p class="text-danger small">Could not load conversation.</p>';
            }
        }

        document.getElementById('guestConvReplyBtn').addEventListener('click', () => {
            if (!activeGuestConv.customerName) return;
            guestConversationModal.hide();
            document.dispatchEvent(new CustomEvent('mdj-open-reply', {
                detail: {
                    customerName: activeGuestConv.customerName,
                    originalType: 'message',
                    originalId: ''
                }
            }));
        });

        async function loadGuests() {
            const selected = eventSelect.value;
            guestsList.innerHTML = '<span class="text-muted small">Loading…</span>';
            try {
                const eventIds = selected === 'all' ? Object.keys(eventNames) : [selected];
                if (eventIds.length === 0) {
                    guestsList.innerHTML = '<span class="text-muted small">Select an event to view guests.</span>';
                    guestCount.textContent = '0';
                    return;
                }
                const lists = await Promise.all(eventIds.map(id =>
                    fetch(`/api/events/${id}/guests`).then(r => r.ok ? r.json() : [])
                ));
                const guests = lists.flat().sort((a, b) => new Date(b.lastSeenAt) - new Date(a.lastSeenAt));
                guestCount.textContent = guests.length;
                guestsList.innerHTML = '';
                if (guests.length === 0) {
                    guestsList.innerHTML = '<span class="text-muted small">No guests yet.</span>';
                    return;
                }
                guests.forEach(guest => {
                    guestsList.appendChild(renderGuestRow(guest, guest.eventId, selected === 'all'));
                });
            } catch (err) {
                console.error('Failed to load guests:', err);
                guestsList.innerHTML = '<span class="text-danger small">Could not load guests.</span>';
            }
        }

        document.getElementById('refreshGuestsBtn').addEventListener('click', loadGuests);

        document.addEventListener('click', (e) => {
            if (e.target.closest('.guest-silence-panel') ||
                e.target.closest('.guest-actions .btn-outline-warning')) {
                return;
            }
            document.querySelectorAll('.guest-silence-panel.is-open').forEach(panel => {
                panel.classList.remove('is-open');
                panel.hidden = true;
                panel.innerHTML = '';
            });
        });

        loadGuests();
    });
    </script>
</body>
</html>
