                    <h4 class="mb-0"><i class="fas fa-tv me-2"></i>Screen Prompts</h4>
                    <a id="openDisplayLink" href="#" target="_blank" class="btn btn-outline-primary btn-sm" style="display:none;">
                        <i class="fas fa-external-link-alt me-1"></i>Open Display
                    </a>
                </div>
                <p class="text-muted small mb-3">
                    <i class="fas fa-circle-info me-1"></i>
                    Tap a button to flash an animated announcement on the event display screen.
                    <span id="promptTargetHint" class="d-block mt-1"></span>
                </p>
                <div id="promptBtnGrid" class="prompt-btn-grid">
                    <span class="text-muted small">Loading prompts…</span>
                </div>

                <hr class="my-4 opacity-25">

                <h5 class="h6 text-uppercase text-muted mb-2">
                    <i class="fas fa-dice me-1"></i>Spinners
                </h5>
                <p class="text-muted small mb-3">
                    Karaoke spinner runs on the event display and adds the winning track to this event's request queue.
                    Guest spinner uses the same wheel animation and picks from guests who have already interacted with this event.
                </p>
                <div id="spinnerBtnGrid" class="prompt-btn-grid">
                    <button type="button" id="screenKaraokeSpinBtn" class="btn prompt-trigger-btn prompt-karaoke-spinner" disabled>
                        <span class="prompt-btn-icon"><i class="fas fa-microphone-lines"></i></span>
                        <span class="prompt-btn-label">Karaoke spinner</span>
                        <span class="prompt-btn-sub">Random track on display</span>
                    </button>
                    <button type="button" id="screenGuestSpinBtn" class="btn prompt-trigger-btn prompt-guest-spinner" disabled>
                        <span class="prompt-btn-icon"><i class="fas fa-user-check"></i></span>
                        <span class="prompt-btn-label">Guest spinner</span>
                        <span class="prompt-btn-sub">Random guest on screen</span>
                    </button>
                </div>
            </div>
        </div>
        </div>

        <aside class="mdj-dash-messages-panel" aria-label="Guest messages">
            <div class="mdj-dash-messages-header d-flex justify-content-between align-items-center gap-2">
                <h4><i class="fas fa-envelope me-2"></i>Messages (<span id="messageCount"><%= messages.filter(function(m){ return m.needsReply; }).length %></span>)</h4>
                <button id="markAllDisplayed" class="btn btn-outline-secondary btn-sm flex-shrink-0">
                    <i class="fas fa-check me-1"></i><span class="d-none d-xl-inline">Mark All</span>
                </button>
            </div>
            <div id="messagesList" class="mdj-dash-messages-list">
                <% if (messages.length === 0) { %>
                    <div class="card text-center">
                        <div class="card-body py-4">
                            <i class="fas fa-comments fa-2x text-muted mb-2"></i>
                            <p class="text-muted mb-0">No messages</p>
                        </div>
                    </div>
                <% } else { %>
                    <% let sortedMessages = messages.slice().sort(function(a,b){ return new Date(b.timestamp) - new Date(a.timestamp); }); %>
                    <% sortedMessages.forEach(function(message) { %>
                        <div class="card mb-2<%= message.needsReply ? ' message-needs-reply' : (message.displayed ? ' bg-light' : '') %>" data-message-id="<%= message.id %>" data-event-id="<%= message.eventId || '' %>" data-needs-reply="<%= message.needsReply ? '1' : '0' %>">
                            <div class="card-body py-2 message-card-body">
                                <div class="message-card-top">
                                    <div class="message-card-meta">
                                        <div class="d-flex align-items-center mb-1 flex-wrap gap-1">
                                            <strong class="me-1"><%= message.customerName %></strong>
                                            <% if (message.eventName) { %>
                                                <span class="badge bg-dark" title="Event"><%= message.eventName %></span>
                                            <% } %>
                                            <% if (message.needsReply) { %>
                                                <span class="badge bg-primary">Awaiting reply</span>
                                            <% } %>
                                            <% if (message.private) { %>
                                                <span class="badge bg-purple-pill" title="Not shown on the display screen"><i class="fas fa-user-lock me-1"></i>DJ Only</span>
                                            <% } %>
                                        </div>
                                        <small class="text-muted d-block">
                                            <i class="fas fa-clock me-1"></i>
                                            <%= new Date(message.timestamp).toLocaleString() %>
                                        </small>
                                    </div>
                                    <div class="message-card-actions">
                                        <% if (!message.displayed) { %>
                                            <button class="btn btn-outline-primary btn-sm mark-displayed" 
                                                    data-message-id="<%= message.id %>"
                                                    title="Mark displayed">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        <% } %>
                                        <button class="btn btn-success btn-sm reply-message" 
                                                data-customer-name="<%= message.customerName %>"
                                                data-message-id="<%= message.id %>"
                                                data-original-type="message"
                                                title="Reply">
                                            <i class="fas fa-reply"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="message-text small"><%- message.message %></div>
                                <div class="message-card-actions-bottom">
                                    <button class="btn btn-success btn-sm reply-message" 
                                            data-customer-name="<%= message.customerName %>"
                                            data-message-id="<%= message.id %>"
                                            data-original-type="message">
                                        <i class="fas fa-reply me-1"></i>Reply to <%= message.customerName %>
                                    </button>
                                </div>
                            </div>
