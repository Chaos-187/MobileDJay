                </p>
                <div id="photosGrid" class="dash-photo-grid" style="max-height: 60vh; overflow-y: auto;">
                    <span class="text-muted small">Loading…</span>
                </div>
            </div>

            <!-- Tracks Played Tab -->
            <div class="tab-pane fade" id="tracks" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h4 class="mb-0"><i class="fas fa-compact-disc me-2"></i>Tracks Played</h4>
                    <button id="refreshTracksBtn" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-sync-alt me-1"></i>Refresh
                    </button>
                </div>
                <p class="text-muted small mb-3">
                    <i class="fas fa-circle-info me-1"></i>
                    Tracks are logged automatically from VirtualDJ now playing (assigned to the active event). You can also add or remove entries manually below.
                </p>
                <div class="card mb-3">
                    <div class="card-body">
                        <form id="addTrackForm" class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label for="trackTitle" class="form-label small mb-1">Title *</label>
                                <input type="text" class="form-control" id="trackTitle" required maxlength="200" placeholder="Song title">
                            </div>
                            <div class="col-md-3">
                                <label for="trackArtist" class="form-label small mb-1">Artist</label>
                                <input type="text" class="form-control" id="trackArtist" maxlength="200" placeholder="Artist">
