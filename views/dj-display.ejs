<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DJ Message Display - MobileDJay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="/css/spinner-show.css?v=2" rel="stylesheet">
    <style>
        :root{
            --bg1: #000428;
            --bg2: #004e92;
            --card-bg: rgba(255,255,255,0.65); /* stronger transparency so background peeks through */
            --accent: #ff6b6b;
            --accent-2: #6be7ff;
            --bg-image: url('/images/dj-bg.jpg'); /* change path or place image in public/images/ */
        }

        body {
            margin: 0;
            overflow: hidden;
            font-family: 'Arial', sans-serif;
            cursor: none;
            background: #000;
        }

        .display-bg-stack {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
        }
        .display-bg-gradient {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, var(--bg1), var(--bg2));
        }
        .display-bg-slide {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            opacity: 0;
            transition: opacity 1.4s ease-in-out;
        }
        .display-bg-slide.is-visible {
            opacity: 1;
        }

        /* Original body content paints above the fixed background stack (DOM order). */

        .message-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px; /* keep comfortable safe-area gutters */
            box-sizing: border-box;
            z-index: 1000;
            pointer-events: none; /* messages shouldn't block clicks */
        }

        /* Message card enhanced with 3D pop, glow and smooth easing */
        .message-display {
            background: var(--card-bg);
            -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
            background-clip: padding-box; /* prevents the border from being blurred into the content */
            border-radius: 14px; /* slightly reduced to better suit edge-to-edge */
            padding: 3rem;
            /* allow the card to expand to the full viewport width while keeping comfortable gutters */
            width: min(100%, 1200px);
            max-width: calc(100vw - 48px);
            box-sizing: border-box;
            text-align: center;
            box-shadow: 0 30px 60px rgba(0,0,0,0.45), 0 0 30px rgba(107,231,255,0.04) inset;
            border: 1px solid rgba(255, 255, 255, 0.12);
            transform-origin: center center; /* center origin keeps motion symmetric */
            transform: translateZ(0) scale(0.98) translateY(0); /* remove default offset so flex centering is exact */
            margin: 0 auto; /* ensure horizontal centering when width constrained */
            align-self: center; /* ensure vertical centering inside flex container */
            opacity: 0;
            transition: box-shadow 250ms ease;
            will-change: transform, opacity, box-shadow;
        }

        /* Entrance animation - more lively pop with a tiny rotation */
        .message-display.show {
            animation: messageIn 650ms cubic-bezier(0.22, 1, 0.36, 1) both;
        }

        /* Exit animation - smooth fade and drop */
        .message-display.hide {
            animation: messageOut 480ms cubic-bezier(0.4, 0, 1, 1) both;
        }

        .message-content {
            font-size: 2.8rem; /* increased from 2.5rem */
            font-weight: 800;
            color: #111;
            margin-bottom: 1rem;
            line-height: 1.05;
            text-shadow: 0 6px 18px rgba(0,0,0,0.12);
            letter-spacing: -0.5px;
            opacity: 0;
            transform: translateY(8px);
            animation: contentReveal 420ms cubic-bezier(0.2, 0.9, 0.2, 1) both 160ms;
        }

        .message-from {
            font-size: 1.75rem; /* increased from 1.5rem */
            color: #666;
            font-style: italic;
            margin-top: 1rem;
            opacity: 0;
            transform: translateY(6px);
            animation: contentReveal 420ms cubic-bezier(0.2, 0.9, 0.2, 1) both 240ms;
        }

        /* Reply variant keeps bright gradient but participates in the same animations */
        .message-display.reply {
            background: linear-gradient(135deg, rgba(40, 167, 69, 0.95), rgba(25, 135, 84, 0.95));
            color: white;
            border: 2px solid rgba(255, 255, 255, 0.25);
        }

        .message-display.reply .message-content,
        .message-display.reply .message-from{
            text-shadow: 0 6px 22px rgba(0,0,0,0.28);
        }

        /* Media message styles */
        .message-display.has-media {
            background: linear-gradient(135deg, rgba(255, 107, 107, 0.95), rgba(255, 165, 0, 0.95));
            color: white;
            border: 2px solid rgba(255, 255, 255, 0.25);
        }

        .message-display.has-media .message-content,
        .message-display.has-media .message-from {
            text-shadow: 0 6px 22px rgba(0,0,0,0.28);
        }

        /* Style images within messages */
        .message-content img {
            max-width: 100%;
            max-height: 300px;
            height: auto;
            border-radius: 12px;
            margin: 0.5rem 0;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
            display: block;
            margin-left: auto;
            margin-right: auto;
        }

        /* Icon, gives nice pop + gentle float while visible */
        .message-icon{
            font-size: 2.2rem;
            margin-bottom: 0.6rem;
            color: var(--accent-2);
            display: inline-block;
            transform-origin: center;
            opacity: 0;
            animation: iconPop 420ms cubic-bezier(0.2, 0.9, 0.2, 1) both 80ms;
        }

        /* subtle ongoing movement for icon when fully shown */
        .message-display.show .message-icon i{
            animation: iconFloat 2200ms ease-in-out infinite 700ms;
        }

        /* small neon-style glow pulse across the card while visible */
        .message-display.show{
            box-shadow: 0 40px 90px rgba(0,0,0,0.6), 0 0 18px rgba(107,231,255,0.07) inset;
        }

        @keyframes messageIn{
            0%{
                opacity: 0;
                transform: translateY(28px) scale(0.88) rotate(-1.5deg);
            }
            60%{
                transform: translateY(-10px) scale(1.04) rotate(1deg);
                opacity: 1;
            }
            100%{
                transform: translateY(0) scale(1) rotate(0deg);
                opacity: 1;
            }
        }

        @keyframes messageOut{
            0%{
                opacity: 1;
                transform: translateY(0) scale(1);
            }
            100%{
                opacity: 0;
                transform: translateY(30px) scale(0.96);
            }
        }

        @keyframes contentReveal{
            0%{ opacity: 0; transform: translateY(8px); }
            100%{ opacity: 1; transform: translateY(0); }
        }

        @keyframes iconPop{
            0%{ opacity: 0; transform: scale(0.6) translateY(6px); }
            70%{ transform: scale(1.08) translateY(-4px); }
            100%{ opacity: 1; transform: scale(1) translateY(0); }
        }

        @keyframes iconFloat{
            0%{ transform: translateY(0) rotate(0deg); }
            50%{ transform: translateY(-6px) rotate(6deg); }
            100%{ transform: translateY(0) rotate(0deg); }
        }

        /* Waiting message and misc styles unchanged */
        .waiting-message {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            color: rgba(255, 255, 255, 0.8);
        }

        .waiting-message h2 {
            font-size: 3rem;
            margin-bottom: 1rem;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
        }

        .waiting-message p {
            font-size: 1.5rem;
            opacity: 0.7;
        }

        .floating-icons {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
        }

        .floating-icon {
            position: absolute;
            color: rgba(255, 255, 255, 0.06);
            font-size: 2.4rem;
            animation: float 6s ease-in-out infinite;
            will-change: transform;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(10deg); }
        }

        .control-panel {
            position: fixed;
            top: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.8);
            color: white;
            padding: 10px;
            border-radius: 10px;
            font-size: 0.9rem;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .control-panel:hover { opacity: 1; }
        .control-panel.show { opacity: 0.7; }

        /* Version Display */
        .version-display {
            position: fixed;
            bottom: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.5);
            color: rgba(255, 255, 255, 0.7);
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 500;
            z-index: 100;
            pointer-events: none;
        }

        /* QR Code Overlay */
        .qr-overlay {
            position: fixed;
            background: rgba(255, 255, 255, 0.95);
            padding: 12px;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            z-index: 500;
            text-align: center;
            transition: opacity 0.3s ease;
        }
        .qr-overlay.top-left { top: 20px; left: 20px; }
        .qr-overlay.top-right { top: 20px; right: 20px; }
        .qr-overlay.bottom-left { bottom: 20px; left: 20px; }
        .qr-overlay.bottom-right { bottom: 20px; right: 20px; }
        .qr-overlay canvas {
            display: block;
            border-radius: 4px;
        }
        .qr-overlay .qr-label {
            font-size: 0.85rem;
            color: #333;
            margin-top: 8px;
            font-weight: 600;
            max-width: 150px;
        }

        @media (max-width: 768px) {
            .message-content { font-size: 2.4rem; }
            .message-from { font-size: 1.4rem; }
            .message-display { padding: 2rem; max-width: 90vw; }
        }

        /* Respect user preference for reduced motion */
        @media (prefers-reduced-motion: reduce) {
            .message-display, .message-content, .message-from, .message-icon { animation: none !important; transition: none !important; }
        }

        /* ============================================
           PHOTO SHOWCASE STYLES
           ============================================ */
        .photo-showcase-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.78);
            backdrop-filter: blur(6px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2500;
        }
        .photo-showcase-overlay.active { display: flex; }

        .photo-showcase-frame {
            position: relative;
            background: #fff;
            padding: 16px 16px 22px;
            border-radius: 10px;
            box-shadow: 0 40px 120px rgba(0, 0, 0, 0.7), 0 0 60px rgba(255, 215, 0, 0.25);
            max-width: min(94vw, 1700px);
            max-height: 94vh;
            transform: scale(0.4) rotate(-6deg);
            opacity: 0;
        }
        .photo-showcase-overlay.active .photo-showcase-frame {
            animation: photoFrameIn 900ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }
        .photo-showcase-overlay.closing .photo-showcase-frame {
            /* !important so style variants (e.g. neon's pulse) can't override the exit */
            animation: photoFrameOut 500ms cubic-bezier(0.4, 0, 1, 1) forwards !important;
        }
        @keyframes photoFrameIn {
            0% { transform: scale(0.4) rotate(-6deg); opacity: 0; }
            60% { transform: scale(1.05) rotate(1.5deg); opacity: 1; }
            100% { transform: scale(1) rotate(0deg); opacity: 1; }
        }
        @keyframes photoFrameOut {
            0% { transform: scale(1) rotate(0deg); opacity: 1; }
            100% { transform: scale(0.5) rotate(5deg) translateY(60px); opacity: 0; }
        }

        .photo-showcase-frame img {
            display: block;
            max-width: 100%;
            max-height: calc(94vh - 120px);
            min-height: 40vh;
            border-radius: 6px;
            object-fit: contain;
        }

        /* Ribbon banner across the top of the frame */
        .photo-showcase-banner {
            position: absolute;
            top: -26px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, #ff6b00 0%, #ffb340 100%);
            color: #fff;
            font-weight: 800;
            font-size: clamp(1.1rem, 2.4vw, 1.8rem);
            padding: 0.55rem 2.4rem;
            border-radius: 50px;
            white-space: nowrap;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
            animation: bannerBounce 2.2s ease-in-out infinite;
        }
        @keyframes bannerBounce {
            0%, 100% { transform: translateX(-50%) translateY(0) rotate(-1deg); }
            50% { transform: translateX(-50%) translateY(-6px) rotate(1deg); }
        }

        /* Banner style variants (chosen in Global Settings → Photos) */
        .photo-showcase-banner.banner-neon {
            background: #12001a;
            border: 2px solid #ff00e6;
            color: #ff9df3;
            box-shadow: 0 0 22px rgba(255, 0, 230, 0.85), inset 0 0 12px rgba(255, 0, 230, 0.35);
            text-shadow: 0 0 10px #ff00e6;
            animation: bannerBounce 2.2s ease-in-out infinite, neonFlicker 3.5s linear infinite;
        }
        @keyframes neonFlicker {
            0%, 91%, 94%, 97%, 100% { opacity: 1; }
            92%, 95% { opacity: 0.7; }
        }
        .photo-showcase-banner.banner-elegant {
            background: linear-gradient(135deg, #8a6d1d, #d4af37 45%, #f5e28a);
            color: #fff;
            font-family: Georgia, 'Times New Roman', serif;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
            animation: none;
        }
        .photo-showcase-banner.banner-minimal {
            background: rgba(15, 23, 32, 0.92);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: #fff;
            font-weight: 600;
            text-shadow: none;
            animation: none;
        }

        .photo-showcase-caption {
            text-align: center;
            color: #333;
            font-size: clamp(1rem, 2vw, 1.5rem);
            font-weight: 600;
            margin-top: 14px;
        }
        .photo-showcase-caption .who {
            color: #ff6b00;
            font-weight: 800;
        }

        /* Sparkles floating around the frame */
        .photo-sparkle {
            position: absolute;
            color: #ffd700;
            pointer-events: none;
            animation: sparkleTwinkle 1.6s ease-in-out infinite;
            filter: drop-shadow(0 0 6px rgba(255, 215, 0, 0.8));
        }
        @keyframes sparkleTwinkle {
            0%, 100% { opacity: 0; transform: scale(0.4) rotate(0deg); }
            50% { opacity: 1; transform: scale(1.15) rotate(25deg); }
        }

        /* Full-screen ambient effects behind the frame */
        .photo-showcase-ambient {
            position: absolute;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
        }
        .photo-showcase-frame { z-index: 1; }

        /* ── Party: rotating rainbow edge + falling confetti ── */
        .photo-showcase-overlay.style-party .photo-showcase-frame::before {
            content: '';
            position: absolute;
            inset: -7px;
            border-radius: 14px;
            background: conic-gradient(#ff6b6b, #ffb340, #ffe45c, #6bff8f, #6be7ff, #b06bff, #ff6bd8, #ff6b6b);
            z-index: -1;
            animation: partyHue 4s linear infinite;
        }
        @keyframes partyHue {
            0% { filter: hue-rotate(0deg); }
            100% { filter: hue-rotate(360deg); }
        }
        .showcase-confetti {
            position: absolute;
            top: -4vh;
            width: 12px;
            height: 12px;
            opacity: 0;
            animation: showcaseConfettiFall linear forwards;
        }
        @keyframes showcaseConfettiFall {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(110vh) rotate(720deg); opacity: 0.4; }
        }

        /* ── Neon: dark frame, pulsing glow, drifting orbs ── */
        .photo-showcase-overlay.style-neon .photo-showcase-frame {
            background: #0b0b14;
            border: 2px solid #ff00e6;
            box-shadow: 0 0 40px rgba(255, 0, 230, 0.55), 0 0 90px rgba(107, 231, 255, 0.25);
        }
        .photo-showcase-overlay.style-neon.active .photo-showcase-frame {
            animation: photoFrameIn 900ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
                       neonFramePulse 2.4s ease-in-out infinite 900ms;
        }
        @keyframes neonFramePulse {
            0%, 100% { box-shadow: 0 0 40px rgba(255, 0, 230, 0.55), 0 0 90px rgba(107, 231, 255, 0.25); }
            50% { box-shadow: 0 0 70px rgba(107, 231, 255, 0.6), 0 0 110px rgba(255, 0, 230, 0.35); }
        }
        .photo-showcase-overlay.style-neon .photo-showcase-caption { color: #9fe8ff; }
        .photo-showcase-overlay.style-neon .photo-showcase-caption .who { color: #ff6bd8; }
        .photo-showcase-overlay.style-neon .photo-sparkle {
            color: #6be7ff;
            filter: drop-shadow(0 0 8px rgba(107, 231, 255, 0.9));
        }
        .neon-orb {
            position: absolute;
            width: 45vmin;
            height: 45vmin;
            border-radius: 50%;
            filter: blur(12px);
            animation: neonOrbPulse ease-in-out infinite;
        }
        @keyframes neonOrbPulse {
            0%, 100% { opacity: 0.15; transform: scale(0.8); }
            50% { opacity: 0.55; transform: scale(1.15); }
        }

        /* ── Elegant: ivory frame, gold double border, shimmer + rising motes ── */
        .photo-showcase-overlay.style-elegant .photo-showcase-frame {
            background: #fffdf4;
            border: 6px double #d4af37;
            box-shadow: 0 40px 120px rgba(0, 0, 0, 0.7), 0 0 50px rgba(212, 175, 55, 0.3);
        }
        .photo-showcase-overlay.style-elegant .photo-showcase-frame::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 8px;
            background: linear-gradient(115deg, transparent 42%, rgba(255, 245, 200, 0.35) 50%, transparent 58%);
            background-size: 250% 100%;
            pointer-events: none;
            animation: elegantShimmer 4.5s ease-in-out infinite;
        }
        @keyframes elegantShimmer {
            0%, 20% { background-position: 120% 0; }
            60%, 100% { background-position: -120% 0; }
        }
        .photo-showcase-overlay.style-elegant .photo-showcase-caption { color: #6b5b1e; }
        .photo-showcase-overlay.style-elegant .photo-showcase-caption .who { color: #a8842c; }
        .gold-mote {
            position: absolute;
            bottom: -12px;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #ffd700;
            box-shadow: 0 0 10px 2px rgba(255, 215, 0, 0.7);
            opacity: 0;
            animation: moteRise linear forwards;
        }
        @keyframes moteRise {
            0% { transform: translateY(0) translateX(0); opacity: 0; }
            10% { opacity: 0.9; }
            100% { transform: translateY(-105vh) translateX(6vw); opacity: 0; }
        }

        /* ── Minimal: quiet dark frame, no extras ── */
        .photo-showcase-overlay.style-minimal .photo-showcase-frame {
            background: #141a22;
            border: 1px solid rgba(255, 255, 255, 0.22);
            box-shadow: 0 40px 120px rgba(0, 0, 0, 0.8);
        }
        .photo-showcase-overlay.style-minimal .photo-showcase-caption { color: #c9d4e0; }
        .photo-showcase-overlay.style-minimal .photo-showcase-caption .who { color: #6be7ff; }

        /* Karaoke + guest spinner chrome: /css/spinner-show.css */

        /* ============================================
           DJ SCREEN PROMPTS — animated announcements
           ============================================ */
        .screen-prompt-overlay {
            position: fixed;
            inset: 0;
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2800;
            pointer-events: none;
            overflow: hidden;
        }
        .screen-prompt-overlay.active { display: flex; }

        .screen-prompt-ambient {
            position: absolute;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .screen-prompt-card {
            position: relative;
            z-index: 2;
            text-align: center;
            padding: clamp(2rem, 5vw, 4rem) clamp(2.5rem, 8vw, 6rem);
            border-radius: 24px;
            transform: scale(0.3) rotate(-8deg);
            opacity: 0;
            max-width: 92vw;
        }
        .screen-prompt-overlay.active .screen-prompt-card {
            animation: promptCardIn 850ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }
        .screen-prompt-overlay.closing .screen-prompt-card {
            animation: promptCardOut 480ms cubic-bezier(0.4, 0, 1, 1) forwards !important;
        }
        @keyframes promptCardIn {
            0% { transform: scale(0.3) rotate(-8deg); opacity: 0; }
            55% { transform: scale(1.08) rotate(2deg); opacity: 1; }
            100% { transform: scale(1) rotate(0deg); opacity: 1; }
        }
        @keyframes promptCardOut {
            0% { transform: scale(1); opacity: 1; }
            100% { transform: scale(0.4) translateY(80px); opacity: 0; }
        }

        .screen-prompt-icon {
            font-size: clamp(3.5rem, 10vw, 7rem);
            margin-bottom: 0.5rem;
            display: block;
            line-height: 1;
        }
        .screen-prompt-overlay.active .screen-prompt-icon i {
            animation: promptIconBounce 1.2s ease-in-out infinite 600ms;
        }
        @keyframes promptIconBounce {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-12px) scale(1.08); }
        }

        .screen-prompt-title {
            font-size: clamp(2.8rem, 8vw, 6.5rem);
            font-weight: 900;
            line-height: 1.05;
            margin: 0;
            letter-spacing: -1px;
        }
        .screen-prompt-sub {
            font-size: clamp(1.2rem, 3vw, 2.2rem);
            margin-top: 0.75rem;
            opacity: 0.92;
            font-weight: 600;
        }

        /* ── Great Moves: disco burst, rainbow shimmer ── */
        .screen-prompt-overlay.style-great-moves {
            background: radial-gradient(ellipse at center, rgba(255, 0, 128, 0.35) 0%, rgba(0, 0, 0, 0.82) 70%);
        }
        .screen-prompt-overlay.style-great-moves .screen-prompt-card {
            background: linear-gradient(135deg, #ff006e, #8338ec, #3a86ff);
            color: #fff;
            border: 4px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 0 80px rgba(255, 0, 110, 0.6), 0 0 120px rgba(131, 56, 236, 0.4);
            animation: promptCardIn 850ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
                       greatMovesPulse 1.8s ease-in-out infinite 850ms;
        }
        @keyframes greatMovesPulse {
            0%, 100% { box-shadow: 0 0 80px rgba(255, 0, 110, 0.6), 0 0 120px rgba(131, 56, 236, 0.4); }
            50% { box-shadow: 0 0 120px rgba(58, 134, 255, 0.7), 0 0 160px rgba(255, 0, 110, 0.5); }
        }
        .screen-prompt-overlay.style-great-moves .screen-prompt-title {
            text-shadow: 0 0 30px rgba(255, 255, 255, 0.8), 0 4px 20px rgba(0, 0, 0, 0.4);
            animation: rainbowShift 3s linear infinite;
        }
        @keyframes rainbowShift {
            0% { filter: hue-rotate(0deg); }
            100% { filter: hue-rotate(360deg); }
        }
        .prompt-star-burst {
            position: absolute;
            color: #ffd700;
            font-size: 2rem;
            animation: starBurst 1.4s ease-out forwards;
            filter: drop-shadow(0 0 8px #ffd700);
        }
        @keyframes starBurst {
            0% { transform: scale(0) rotate(0deg); opacity: 1; }
            100% { transform: scale(2.5) rotate(180deg); opacity: 0; }
        }

        /* ── Dance Floor Open: green spotlight sweep ── */
        .screen-prompt-overlay.style-dance-floor {
            background: rgba(0, 0, 0, 0.75);
        }
        .screen-prompt-overlay.style-dance-floor::before {
            content: '';
            position: absolute;
            inset: 0;
            background: conic-gradient(from 0deg, transparent 0deg, rgba(0, 255, 100, 0.15) 30deg, transparent 60deg);
            animation: spotlightSweep 3s linear infinite;
        }
        @keyframes spotlightSweep {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .screen-prompt-overlay.style-dance-floor .screen-prompt-card {
            background: linear-gradient(160deg, #0a3d1a, #1db954 40%, #0a3d1a);
            color: #fff;
            border: 3px solid #7fff9e;
            box-shadow: 0 0 60px rgba(29, 185, 84, 0.7), inset 0 0 40px rgba(127, 255, 158, 0.15);
        }
        .screen-prompt-overlay.style-dance-floor .screen-prompt-title {
            animation: danceFloorGlow 1.5s ease-in-out infinite;
        }
        @keyframes danceFloorGlow {
            0%, 100% { text-shadow: 0 0 20px #7fff9e; }
            50% { text-shadow: 0 0 50px #7fff9e, 0 0 80px #1db954; }
        }
        .prompt-floor-light {
            position: absolute;
            bottom: 0;
            width: 8px;
            height: 40vh;
            background: linear-gradient(to top, rgba(0, 255, 100, 0.6), transparent);
            animation: floorLightPulse 1.2s ease-in-out infinite;
        }
        @keyframes floorLightPulse {
            0%, 100% { opacity: 0.4; transform: scaleY(0.8); }
            50% { opacity: 1; transform: scaleY(1.1); }
        }

        /* ── Dad Dancing: retro cheesy wobble ── */
        .screen-prompt-overlay.style-dad-dancing {
            background: repeating-linear-gradient(
                45deg,
                rgba(255, 200, 0, 0.08) 0px, rgba(255, 200, 0, 0.08) 20px,
                rgba(255, 100, 0, 0.08) 20px, rgba(255, 100, 0, 0.08) 40px
            ), rgba(0, 0, 0, 0.8);
        }
        .screen-prompt-overlay.style-dad-dancing .screen-prompt-card {
            background: linear-gradient(180deg, #ff9500, #ffcc00);
            color: #4a2800;
            border: 5px dashed #fff;
            font-family: 'Comic Sans MS', 'Chalkboard SE', cursive, sans-serif;
            animation: promptCardIn 850ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
                       dadWobble 0.6s ease-in-out infinite 850ms;
        }
        @keyframes dadWobble {
            0%, 100% { transform: rotate(-2deg) scale(1); }
            25% { transform: rotate(3deg) scale(1.02); }
            75% { transform: rotate(-3deg) scale(0.98); }
        }
        .screen-prompt-overlay.style-dad-dancing .screen-prompt-icon i {
            animation: dadPoint 0.8s ease-in-out infinite 600ms !important;
        }
        @keyframes dadPoint {
            0%, 100% { transform: rotate(-15deg); }
            50% { transform: rotate(25deg) scale(1.2); }
        }

        /* ── Slow Dance: romantic hearts ── */
        .screen-prompt-overlay.style-slow-dance {
            background: radial-gradient(ellipse at center, rgba(255, 105, 180, 0.25) 0%, rgba(80, 0, 60, 0.85) 100%);
        }
        .screen-prompt-overlay.style-slow-dance .screen-prompt-card {
            background: linear-gradient(135deg, rgba(255, 105, 180, 0.95), rgba(199, 21, 133, 0.95));
            color: #fff;
            border: 3px solid rgba(255, 200, 220, 0.6);
            box-shadow: 0 0 60px rgba(255, 105, 180, 0.5);
            animation: promptCardIn 850ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
                       slowDanceFloat 3s ease-in-out infinite 850ms;
        }
        @keyframes slowDanceFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        .prompt-heart {
            position: absolute;
            color: #ff69b4;
            animation: heartFloat linear forwards;
            filter: drop-shadow(0 0 6px rgba(255, 105, 180, 0.8));
        }
        @keyframes heartFloat {
            0% { transform: translateY(0) scale(0.5); opacity: 0; }
            10% { opacity: 1; }
            100% { transform: translateY(-110vh) scale(1.2); opacity: 0; }
        }

        /* ── Last Orders: urgent amber flash ── */
        .screen-prompt-overlay.style-last-orders {
            background: rgba(0, 0, 0, 0.88);
        }
        .screen-prompt-overlay.style-last-orders .screen-prompt-card {
            background: #1a1200;
            color: #ffb340;
            border: 4px solid #ff6b00;
            box-shadow: 0 0 40px rgba(255, 107, 0, 0.5);
            animation: promptCardIn 850ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
                       lastOrdersFlash 1s ease-in-out infinite 850ms;
        }
        @keyframes lastOrdersFlash {
            0%, 100% { border-color: #ff6b00; box-shadow: 0 0 40px rgba(255, 107, 0, 0.5); }
            50% { border-color: #ffb340; box-shadow: 0 0 80px rgba(255, 179, 64, 0.8); }
        }
        .screen-prompt-overlay.style-last-orders .screen-prompt-title {
            animation: lastOrdersBlink 0.8s step-end infinite;
        }
        @keyframes lastOrdersBlink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        /* ── Round of Applause: gold burst ── */
        .screen-prompt-overlay.style-applause {
            background: radial-gradient(ellipse at center, rgba(255, 215, 0, 0.2) 0%, rgba(0, 0, 0, 0.82) 70%);
        }
        .screen-prompt-overlay.style-applause .screen-prompt-card {
            background: linear-gradient(135deg, #b8860b, #ffd700, #daa520);
            color: #3d2800;
            border: 4px solid #fff8dc;
            box-shadow: 0 0 70px rgba(255, 215, 0, 0.6);
        }
        .screen-prompt-overlay.style-applause .screen-prompt-icon i {
            animation: clapHands 0.4s ease-in-out infinite 600ms !important;
        }
        @keyframes clapHands {
            0%, 100% { transform: scaleX(1); }
            50% { transform: scaleX(0.85); }
        }
        .prompt-applause-confetti {
            position: absolute;
            width: 10px;
            height: 10px;
            animation: applauseConfettiFall linear forwards;
        }
        @keyframes applauseConfettiFall {
            0% { transform: translateY(-5vh) rotate(0deg); opacity: 1; }
            100% { transform: translateY(110vh) rotate(540deg); opacity: 0.6; }
        }

        /* ── Selfie Time: camera flash + polaroid ── */
        .screen-prompt-overlay.style-selfie {
            background: rgba(0, 0, 0, 0.8);
        }
        .screen-prompt-overlay.style-selfie .screen-prompt-card {
            background: #fff;
            color: #222;
            border: 12px solid #fff;
            border-bottom: 48px solid #fff;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5), 0 0 0 2px #ddd;
            transform-origin: center bottom;
        }
        .screen-prompt-overlay.style-selfie.active .screen-prompt-card {
            animation: promptCardIn 850ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
                       polaroidTilt 2.5s ease-in-out infinite 850ms;
        }
        @keyframes polaroidTilt {
            0%, 100% { transform: rotate(-1deg); }
            50% { transform: rotate(1.5deg); }
        }
        .screen-prompt-overlay.style-selfie .screen-prompt-title { color: #111; }
        .screen-prompt-overlay.style-selfie .screen-prompt-sub { color: #555; }

        .prompt-camera-flash {
            position: absolute;
            inset: 0;
            background: #fff;
            opacity: 0;
            pointer-events: none;
            z-index: 10;
        }
        .prompt-camera-flash.flash {
            animation: cameraFlash 0.35s ease-out forwards;
        }
        @keyframes cameraFlash {
            0% { opacity: 0.95; }
            100% { opacity: 0; }
        }
    </style>
</head>
<body>
    <div class="display-bg-stack" aria-hidden="true">
        <div id="displayBgGradient" class="display-bg-gradient"></div>
        <div id="displayBgSlideA" class="display-bg-slide"></div>
        <div id="displayBgSlideB" class="display-bg-slide"></div>
    </div>
    <!-- Floating Background Icons -->
    <div class="floating-icons">
        <i class="fas fa-music floating-icon" style="top: 10%; left: 10%; animation-delay: 0s;"></i>
        <i class="fas fa-microphone floating-icon" style="top: 20%; right: 15%; animation-delay: 1s;"></i>
        <i class="fas fa-headphones floating-icon" style="bottom: 30%; left: 20%; animation-delay: 2s;"></i>
        <i class="fas fa-heart floating-icon" style="top: 60%; right: 10%; animation-delay: 3s;"></i>
        <i class="fas fa-star floating-icon" style="bottom: 20%; right: 25%; animation-delay: 4s;"></i>
        <i class="fas fa-note-musical floating-icon" style="top: 80%; left: 30%; animation-delay: 5s;"></i>
    </div>

    <!-- Version Display -->
    <div class="version-display" id="versionDisplay">v1.5.0</div>

    <!-- Control Panel -->
    <div class="control-panel" id="controlPanel">
        <div><strong>DJ Message Display</strong></div>
        <div>Press 'H' to toggle this panel</div>
        <div>Press 'C' to configure display</div>
        <div>Messages auto-refresh every 3 seconds</div>
        <div>Karaoke spinner integrated</div>
        <div id="messageStatus">Waiting for messages...</div>
        <div id="spinnerStatus" style="color: #ffc107;">Spinner: Ready</div>
    </div>

    <!-- QR Code Overlay -->
    <div class="qr-overlay top-right" id="qrOverlay" style="display: none;">
        <canvas id="qrCanvas"></canvas>
        <div class="qr-label" id="qrLabel">Scan to Request Songs!</div>
    </div>

    <!-- Waiting Message -->
    <div class="waiting-message" id="waitingMessage">
        <h2><i class="fas fa-satellite-dish me-3"></i>DJ Message Display</h2>
        <p>Waiting for customer messages...</p>
        <div class="mt-4">
            <i class="fas fa-spinner fa-spin fa-2x"></i>
        </div>
    </div>

    <!-- Message Container -->
    <div class="message-container" id="messageContainer" style="display: none;">
        <div class="message-display" id="messageDisplay">
            <div class="message-icon">
                <i class="fas fa-envelope"></i>
            </div>
            <div class="message-content" id="messageContent"></div>
            <div class="message-from" id="messageFrom"></div>
        </div>
    </div>

    <!-- Photo Showcase Overlay -->
    <div class="photo-showcase-overlay" id="photoShowcaseOverlay">
        <div class="photo-showcase-ambient" id="photoShowcaseAmbient" aria-hidden="true"></div>
        <div class="photo-showcase-frame" id="photoShowcaseFrame">
            <div class="photo-showcase-banner" id="photoShowcaseBanner">
                <i class="fas fa-camera me-2"></i>Guest Photo!
            </div>
            <img id="photoShowcaseImg" src="" alt="Guest photo">
            <div class="photo-showcase-caption" id="photoShowcaseCaption"></div>
        </div>
    </div>

    <!-- DJ Screen Prompt Overlay -->
    <div class="screen-prompt-overlay" id="screenPromptOverlay">
        <div class="screen-prompt-ambient" id="screenPromptAmbient" aria-hidden="true"></div>
        <div class="prompt-camera-flash" id="promptCameraFlash"></div>
        <div class="screen-prompt-card" id="screenPromptCard">
            <span class="screen-prompt-icon" id="screenPromptIcon"><i class="fas fa-star"></i></span>
            <h1 class="screen-prompt-title" id="screenPromptTitle"></h1>
            <p class="screen-prompt-sub" id="screenPromptSub"></p>
        </div>
    </div>

    <!-- Karaoke Spinner Overlay -->
    <div class="spinner-overlay mdj-spinner-root spinner-theme-karaoke" id="spinnerOverlay">
        <div class="mdj-spinner-rays" aria-hidden="true"></div>
        <div class="spinner-container">
            <h1 class="spinner-title">
                <i class="fas fa-microphone-alt me-3"></i>
                Random Karaoke Selector
                <i class="fas fa-music ms-3"></i>
            </h1>

            <div class="spinner-window">
                <div class="spinner-slot" id="spinnerSlot">
                    <div class="mdj-slot-vignette" aria-hidden="true"></div>
                    <div class="mdj-slot-highlight" aria-hidden="true"></div>
                    <div class="spinner-waiting" id="spinnerWaiting">
                        <i class="fas fa-dice"></i>
                        <div>Spinning...</div>
                    </div>
                    <div class="songs-list" id="songsList" style="display: none;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Winner Display -->
    <div class="winner-display" id="winnerDisplay">
        <div class="winner-label">It&apos;s karaoke time</div>
        <div class="winner-icon">
            <i class="fas fa-trophy"></i>
        </div>
        <div class="winner-title-text" id="winnerTitle"></div>
        <div class="winner-artist" id="winnerArtist"></div>
        <div class="winner-difficulty" id="winnerDifficulty"></div>
    </div>

    <!-- Guest Spinner Overlay -->
    <div class="guest-spinner-overlay mdj-spinner-root spinner-theme-guest" id="guestSpinnerOverlay">
        <div class="mdj-spinner-rays" aria-hidden="true"></div>
        <div class="spinner-container">
            <h1 class="spinner-title">
                <i class="fas fa-users me-3"></i>
                Random Guest Selector
                <i class="fas fa-user-check ms-3"></i>
            </h1>
            <div class="guest-spinner-window">
                <div class="guest-spinner-slot" id="guestSpinnerSlot">
                    <div class="mdj-slot-vignette" aria-hidden="true"></div>
                    <div class="mdj-slot-highlight" aria-hidden="true"></div>
                    <div class="spinner-waiting" id="guestSpinnerWaiting">
                        <i class="fas fa-dice"></i>
                        <div>Spinning...</div>
                    </div>
                    <div class="guests-list" id="guestsList" style="display: none;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="guest-winner-display" id="guestWinnerDisplay">
        <div class="winner-label">Selected guest</div>
        <div class="winner-icon">
            <i class="fas fa-user-check"></i>
        </div>
        <div class="guest-winner-name" id="guestWinnerName"></div>
        <div class="guest-winner-sub" id="guestWinnerSub"></div>
    </div>

    <!-- Coin (heads/tails) spinner -->
    <div class="coin-spinner-overlay mdj-spinner-root spinner-theme-coin" id="coinSpinnerOverlay">
        <div class="mdj-spinner-rays" aria-hidden="true"></div>
        <div class="spinner-container">
            <h1 class="spinner-title">
                <i class="fas fa-coins me-3"></i>
                Heads or Tails
                <i class="fas fa-scale-balanced ms-3"></i>
            </h1>
            <div class="spinner-window">
                <div class="spinner-slot" id="coinSpinnerSlot">
                    <div class="mdj-slot-vignette" aria-hidden="true"></div>
                    <div class="mdj-slot-highlight" aria-hidden="true"></div>
                    <div class="spinner-waiting" id="coinSpinnerWaiting">
                        <i class="fas fa-dice"></i>
                        <div>Flipping...</div>
                    </div>
                    <div class="binary-options-list" id="coinOptionsList" style="display: none;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="winner-display winner-display--coin" id="coinWinnerDisplay">
        <div class="winner-label">The coin says</div>
        <div class="winner-icon" id="coinWinnerIcon"><i class="fas fa-coins"></i></div>
        <div class="winner-title-text" id="coinWinnerTitle"></div>
    </div>

    <!-- Yes / No spinner -->
    <div class="yesno-spinner-overlay mdj-spinner-root spinner-theme-yesno" id="yesNoSpinnerOverlay">
        <div class="mdj-spinner-rays" aria-hidden="true"></div>
        <div class="spinner-container">
            <h1 class="spinner-title">
                <i class="fas fa-circle-question me-3"></i>
                Yes or No
                <i class="fas fa-bolt ms-3"></i>
            </h1>
            <div class="spinner-window">
                <div class="spinner-slot" id="yesNoSpinnerSlot">
                    <div class="mdj-slot-vignette" aria-hidden="true"></div>
                    <div class="mdj-slot-highlight" aria-hidden="true"></div>
                    <div class="spinner-waiting" id="yesNoSpinnerWaiting">
                        <i class="fas fa-dice"></i>
                        <div>Spinning...</div>
                    </div>
                    <div class="binary-options-list" id="yesNoOptionsList" style="display: none;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="winner-display winner-display--yesno" id="yesNoWinnerDisplay">
        <div class="winner-label">The answer is</div>
        <div class="winner-icon" id="yesNoWinnerIcon"><i class="fas fa-thumbs-up"></i></div>
        <div class="winner-title-text" id="yesNoWinnerTitle"></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
    <script>
    // Load and apply display configuration from database
    (function() {
        <% if (event) { %>
        const config = {
            showQrCode: <%= event.display_show_qr !== 0 %>,
            qrPosition: '<%= event.display_qr_position || 'top-right' %>',
            qrSize: <%= event.display_qr_size || 120 %>,
            qrLabel: '<%= (event.display_qr_label || 'Scan to Request Songs!').replace(/'/g, "\\'") %>',
            bgColor1: '<%= event.display_bg_color1 || '#000428' %>',
            bgColor2: '<%= event.display_bg_color2 || '#004e92' %>',
            bgImage: '<%= event.display_bg_image || '' %>',
            bgSlideshowEnabled: <%= event.display_bg_slideshow_enabled ? 'true' : 'false' %>,
            bgSlideshowSeconds: <%= event.display_bg_slideshow_seconds || 15 %>,
            bgSlideshowImages: <%- JSON.stringify((typeof displaySlides !== 'undefined' ? displaySlides : []).map(function(s) { return s.imageUrl; })) %>,
            cardColor: '<%= event.display_card_color || '#ffffff' %>',
            cardOpacity: <%= event.display_card_opacity || 85 %>,
            eventSlug: '<%= event.slug %>'
        };
        <% } else { %>
        // No event - use defaults
        const config = {
            showQrCode: false,
            qrPosition: 'top-right',
            qrSize: 120,
            qrLabel: 'Scan to Request Songs!',
            bgColor1: '#000428',
            bgColor2: '#004e92',
            bgImage: '',
            bgSlideshowEnabled: false,
            bgSlideshowSeconds: 15,
            bgSlideshowImages: [],
            cardColor: '#ffffff',
            cardOpacity: 85,
            eventSlug: null
        };
        <% } %>
        
        const qrOverlay = document.getElementById('qrOverlay');
        const qrCanvas = document.getElementById('qrCanvas');
        const qrLabel = document.getElementById('qrLabel');

        const bg1 = config.bgColor1;
        const bg2 = config.bgColor2;
        document.documentElement.style.setProperty('--bg1', bg1);
        document.documentElement.style.setProperty('--bg2', bg2);

        const slideA = document.getElementById('displayBgSlideA');
        const slideB = document.getElementById('displayBgSlideB');
        const gradientOverlay = 'linear-gradient(180deg, ' + bg1 + 'aa, ' + bg2 + 'aa)';

        function setSlideLayer(layer, imageUrl) {
            layer.style.backgroundImage = gradientOverlay + (imageUrl ? ", url('" + imageUrl + "')" : '');
            layer.classList.add('is-visible');
        }

        function clearSlideLayer(layer) {
            layer.classList.remove('is-visible');
        }

        const slideshowImages = (config.bgSlideshowEnabled && config.bgSlideshowImages.length)
            ? config.bgSlideshowImages
            : (config.bgImage ? [config.bgImage] : []);

        if (slideshowImages.length > 0) {
            let slideIndex = 0;
            let useA = true;
            setSlideLayer(slideA, slideshowImages[0]);
            if (slideshowImages.length > 1) {
                const intervalMs = Math.max(5, config.bgSlideshowSeconds) * 1000;
                setInterval(function() {
                    slideIndex = (slideIndex + 1) % slideshowImages.length;
                    const nextLayer = useA ? slideB : slideA;
                    const prevLayer = useA ? slideA : slideB;
                    setSlideLayer(nextLayer, slideshowImages[slideIndex]);
                    setTimeout(function() { clearSlideLayer(prevLayer); }, 1400);
                    useA = !useA;
                }, intervalMs);
            }
        }
        
        // Apply card styling via CSS custom property
        const color = config.cardColor;
        const opacity = config.cardOpacity / 100;
        const r = parseInt(color.slice(1,3), 16);
        const g = parseInt(color.slice(3,5), 16);
        const b = parseInt(color.slice(5,7), 16);
        document.documentElement.style.setProperty('--card-bg', `rgba(${r},${g},${b},${opacity})`);
        
        // Show QR code if configured
        if (config.showQrCode && config.eventSlug) {
            qrOverlay.style.display = 'block';
            qrOverlay.className = 'qr-overlay ' + config.qrPosition;
            qrLabel.textContent = config.qrLabel;
            
            const url = window.location.origin + '/event/' + config.eventSlug;
            
            QRCode.toCanvas(qrCanvas, url, { 
                width: config.qrSize,
                margin: 1
            }, function(error) {
                if (error) console.error('QR Error:', error);
            });
        }
        
        // Expose the event slug for dj-display.js (photo showcase polling)
        window.displayEventSlug = config.eventSlug;

        // Keyboard shortcut to open config
        document.addEventListener('keydown', function(e) {
            if (e.key === 'c' || e.key === 'C') {
                <% if (event) { %>
                window.open('/dj/display-config/<%= event.slug %>', '_blank');
                <% } else { %>
                alert('No event selected. Please use event-specific display.');
                <% } %>
            }
        });
    })();
    </script>
    <script src="/js/mdj-binary-spinner.js"></script>
    <script src="/js/dj-display.js?v=6"></script>
</body>
</html>
