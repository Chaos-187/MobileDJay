<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DJ Message Display - MobileDJay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <style>
        :root{
            --bg1: #000428;
            --bg2: #004e92;
            --card-bg: rgba(255,255,255,0.65); /* stronger transparency so background peeks through */
            --accent: #ff6b6b;
            --accent-2: #6be7ff;
            --bg-image: url('/images/dj-bg.jpg'); /* change path or place image in public/images/ */
        }

        body {
            /* lighter gradient overlay so the photo is more visible while keeping readable tint */
            background: linear-gradient(180deg, rgba(0,4,40,0.25), rgba(0,78,146,0.12)), var(--bg-image);
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            margin: 0;
            overflow: hidden;
            font-family: 'Arial', sans-serif;
            cursor: none;
        }

        .message-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px; /* keep comfortable safe-area gutters */
            box-sizing: border-box;
            z-index: 1000;
            pointer-events: none; /* messages shouldn't block clicks */
        }

        /* Message card enhanced with 3D pop, glow and smooth easing */
        .message-display {
            background: var(--card-bg);
            -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
            background-clip: padding-box; /* prevents the border from being blurred into the content */
            border-radius: 14px; /* slightly reduced to better suit edge-to-edge */
            padding: 3rem;
            /* allow the card to expand to the full viewport width while keeping comfortable gutters */
            width: min(100%, 1200px);
            max-width: calc(100vw - 48px);
            box-sizing: border-box;
            text-align: center;
            box-shadow: 0 30px 60px rgba(0,0,0,0.45), 0 0 30px rgba(107,231,255,0.04) inset;
            border: 1px solid rgba(255, 255, 255, 0.12);
            transform-origin: center center; /* center origin keeps motion symmetric */
            transform: translateZ(0) scale(0.98) translateY(0); /* remove default offset so flex centering is exact */
            margin: 0 auto; /* ensure horizontal centering when width constrained */
            align-self: center; /* ensure vertical centering inside flex container */
            opacity: 0;
            transition: box-shadow 250ms ease;
            will-change: transform, opacity, box-shadow;
        }

        /* Entrance animation - more lively pop with a tiny rotation */
        .message-display.show {
            animation: messageIn 650ms cubic-bezier(0.22, 1, 0.36, 1) both;
        }

        /* Exit animation - smooth fade and drop */
        .message-display.hide {
            animation: messageOut 480ms cubic-bezier(0.4, 0, 1, 1) both;
        }

        .message-content {
            font-size: 2.8rem; /* increased from 2.5rem */
            font-weight: 800;
            color: #111;
            margin-bottom: 1rem;
            line-height: 1.05;
            text-shadow: 0 6px 18px rgba(0,0,0,0.12);
            letter-spacing: -0.5px;
            opacity: 0;
            transform: translateY(8px);
            animation: contentReveal 420ms cubic-bezier(0.2, 0.9, 0.2, 1) both 160ms;
        }

        .message-from {
            font-size: 1.75rem; /* increased from 1.5rem */
            color: #666;
            font-style: italic;
            margin-top: 1rem;
            opacity: 0;
            transform: translateY(6px);
            animation: contentReveal 420ms cubic-bezier(0.2, 0.9, 0.2, 1) both 240ms;
        }

        /* Reply variant keeps bright gradient but participates in the same animations */
        .message-display.reply {
            background: linear-gradient(135deg, rgba(40, 167, 69, 0.95), rgba(25, 135, 84, 0.95));
            color: white;
            border: 2px solid rgba(255, 255, 255, 0.25);
        }

        .message-display.reply .message-content,
        .message-display.reply .message-from{
            text-shadow: 0 6px 22px rgba(0,0,0,0.28);
        }

        /* Media message styles */
        .message-display.has-media {
            background: linear-gradient(135deg, rgba(255, 107, 107, 0.95), rgba(255, 165, 0, 0.95));
            color: white;
            border: 2px solid rgba(255, 255, 255, 0.25);
        }

        .message-display.has-media .message-content,
        .message-display.has-media .message-from {
            text-shadow: 0 6px 22px rgba(0,0,0,0.28);
        }

        /* Style images within messages */
        .message-content img {
            max-width: 100%;
            max-height: 300px;
            height: auto;
            border-radius: 12px;
            margin: 0.5rem 0;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
            display: block;
            margin-left: auto;
            margin-right: auto;
        }

        /* Icon, gives nice pop + gentle float while visible */
        .message-icon{
            font-size: 2.2rem;
            margin-bottom: 0.6rem;
            color: var(--accent-2);
            display: inline-block;
            transform-origin: center;
            opacity: 0;
            animation: iconPop 420ms cubic-bezier(0.2, 0.9, 0.2, 1) both 80ms;
        }

        /* subtle ongoing movement for icon when fully shown */
        .message-display.show .message-icon i{
            animation: iconFloat 2200ms ease-in-out infinite 700ms;
        }

        /* small neon-style glow pulse across the card while visible */
        .message-display.show{
            box-shadow: 0 40px 90px rgba(0,0,0,0.6), 0 0 18px rgba(107,231,255,0.07) inset;
        }

        @keyframes messageIn{
            0%{
                opacity: 0;
                transform: translateY(28px) scale(0.88) rotate(-1.5deg);
            }
            60%{
                transform: translateY(-10px) scale(1.04) rotate(1deg);
                opacity: 1;
            }
            100%{
                transform: translateY(0) scale(1) rotate(0deg);
                opacity: 1;
            }
        }

        @keyframes messageOut{
            0%{
                opacity: 1;
                transform: translateY(0) scale(1);
            }
            100%{
                opacity: 0;
                transform: translateY(30px) scale(0.96);
            }
        }

        @keyframes contentReveal{
            0%{ opacity: 0; transform: translateY(8px); }
            100%{ opacity: 1; transform: translateY(0); }
        }

        @keyframes iconPop{
            0%{ opacity: 0; transform: scale(0.6) translateY(6px); }
            70%{ transform: scale(1.08) translateY(-4px); }
            100%{ opacity: 1; transform: scale(1) translateY(0); }
        }

        @keyframes iconFloat{
            0%{ transform: translateY(0) rotate(0deg); }
            50%{ transform: translateY(-6px) rotate(6deg); }
            100%{ transform: translateY(0) rotate(0deg); }
        }

        /* Waiting message and misc styles unchanged */
        .waiting-message {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            color: rgba(255, 255, 255, 0.8);
        }

        .waiting-message h2 {
            font-size: 3rem;
            margin-bottom: 1rem;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
        }

        .waiting-message p {
            font-size: 1.5rem;
            opacity: 0.7;
        }

        .floating-icons {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
        }

        .floating-icon {
            position: absolute;
            color: rgba(255, 255, 255, 0.06);
            font-size: 2.4rem;
            animation: float 6s ease-in-out infinite;
            will-change: transform;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(10deg); }
        }

        .control-panel {
            position: fixed;
            top: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.8);
            color: white;
            padding: 10px;
            border-radius: 10px;
            font-size: 0.9rem;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .control-panel:hover { opacity: 1; }
        .control-panel.show { opacity: 0.7; }

        /* Version Display */
        .version-display {
            position: fixed;
            bottom: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.5);
            color: rgba(255, 255, 255, 0.7);
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 500;
            z-index: 100;
            pointer-events: none;
        }

        /* QR Code Overlay */
        .qr-overlay {
            position: fixed;
            background: rgba(255, 255, 255, 0.95);
            padding: 12px;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            z-index: 500;
            text-align: center;
            transition: opacity 0.3s ease;
        }
        .qr-overlay.top-left { top: 20px; left: 20px; }
        .qr-overlay.top-right { top: 20px; right: 20px; }
        .qr-overlay.bottom-left { bottom: 20px; left: 20px; }
        .qr-overlay.bottom-right { bottom: 20px; right: 20px; }
        .qr-overlay canvas {
            display: block;
            border-radius: 4px;
        }
        .qr-overlay .qr-label {
            font-size: 0.85rem;
            color: #333;
            margin-top: 8px;
            font-weight: 600;
            max-width: 150px;
        }

        @media (max-width: 768px) {
            .message-content { font-size: 2.4rem; }
            .message-from { font-size: 1.4rem; }
            .message-display { padding: 2rem; max-width: 90vw; }
        }

        /* Respect user preference for reduced motion */
        @media (prefers-reduced-motion: reduce) {
            .message-display, .message-content, .message-from, .message-icon { animation: none !important; transition: none !important; }
        }

        /* ============================================
           KARAOKE SPINNER STYLES
           ============================================ */
        .spinner-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: linear-gradient(135deg, rgba(26, 26, 46, 0.95) 0%, rgba(22, 33, 62, 0.95) 100%);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
        }

        .spinner-overlay.active {
            display: flex;
        }

        .spinner-container {
            width: 100%;
            max-width: 1200px;
            padding: 2rem;
            position: relative;
        }

        .spinner-title {
            text-align: center;
            color: white;
            font-size: 3rem;
            font-weight: bold;
            margin-bottom: 2rem;
            text-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
            animation: spinnerPulse 2s ease-in-out infinite;
        }

        @keyframes spinnerPulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.9; transform: scale(1.02); }
        }

        .spinner-window {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 2rem;
            border: 3px solid #ffc107;
            box-shadow: 0 0 40px rgba(255, 193, 7, 0.3);
            position: relative;
            overflow: hidden;
            min-height: 400px;
        }

        .spinner-slot {
            background: rgba(0, 0, 0, 0.4);
            border-radius: 15px;
            padding: 2rem;
            margin: 1rem 0;
            position: relative;
            overflow: hidden;
            height: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid rgba(255, 193, 7, 0.3);
        }

        .spinner-slot::before,
        .spinner-slot::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            height: 2px;
            background: #ffc107;
            box-shadow: 0 0 10px #ffc107;
            z-index: 10;
        }

        .spinner-slot::before { top: calc(50% - 150px); }
        .spinner-slot::after { bottom: calc(50% - 150px); }

        .songs-list {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            transition: transform 0.1s linear;
        }

        .song-item {
            padding: 2rem;
            text-align: center;
            color: white;
            height: 300px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
        }

        .song-title {
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
        }

        .song-artist {
            font-size: 1.8rem;
            color: #ffc107;
            margin-bottom: 0.5rem;
        }

        .song-difficulty {
            display: inline-block;
            padding: 0.5rem 1.5rem;
            background: #ff6b6b;
            border-radius: 20px;
            font-size: 1.2rem;
            margin-top: 0.5rem;
        }

        .spinner-waiting {
            text-align: center;
            color: rgba(255, 255, 255, 0.7);
            font-size: 2rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
        }

        .spinner-waiting i {
            font-size: 5rem;
            margin-bottom: 2rem;
            animation: spinnerPulse 2s ease-in-out infinite;
        }

        /* Winner display - fullscreen overlay */
        .winner-display {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100vw;
            height: 100vh;
            background: linear-gradient(135deg, rgba(255, 193, 7, 0.97), rgba(255, 107, 107, 0.97));
            backdrop-filter: blur(30px);
            padding: 4rem;
            text-align: center;
            z-index: 3000;
            transform: scale(0.5);
            opacity: 0;
        }

        .winner-display.show {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            animation: winnerFullscreen 1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        @keyframes winnerFullscreen {
            0% { transform: scale(0.3); opacity: 0; }
            60% { transform: scale(1.08); opacity: 1; }
            100% { transform: scale(1); opacity: 1; }
        }

        .winner-icon {
            font-size: 10rem;
            color: white;
            margin-bottom: 3rem;
            animation: iconBounce 1s ease-in-out infinite;
            filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.5));
        }

        @keyframes iconBounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        .winner-title-text {
            font-size: 7rem;
            font-weight: bold;
            color: white;
            margin-bottom: 2rem;
            text-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
            animation: titlePulse 2s ease-in-out infinite;
            line-height: 1.2;
        }

        @keyframes titlePulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        .winner-artist {
            font-size: 4.5rem;
            color: rgba(255, 255, 255, 0.95);
            margin-bottom: 2rem;
            text-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
        }

        .winner-difficulty {
            display: inline-block;
            padding: 1.5rem 3rem;
            background: rgba(255, 255, 255, 0.35);
            border-radius: 50px;
            font-size: 2.5rem;
            color: white;
            margin-top: 2rem;
            border: 3px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
        }

        .confetti {
            position: fixed;
            width: 10px;
            height: 10px;
            position: absolute;
            animation: confettiFall 3s linear forwards;
            opacity: 0;
        }

        @keyframes confettiFall {
            0% { transform: translateY(-100vh) rotate(0deg); opacity: 1; }
            100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
        }
    </style>
</head>
<body>
    <!-- Floating Background Icons -->
    <div class="floating-icons">
        <i class="fas fa-music floating-icon" style="top: 10%; left: 10%; animation-delay: 0s;"></i>
        <i class="fas fa-microphone floating-icon" style="top: 20%; right: 15%; animation-delay: 1s;"></i>
        <i class="fas fa-headphones floating-icon" style="bottom: 30%; left: 20%; animation-delay: 2s;"></i>
        <i class="fas fa-heart floating-icon" style="top: 60%; right: 10%; animation-delay: 3s;"></i>
        <i class="fas fa-star floating-icon" style="bottom: 20%; right: 25%; animation-delay: 4s;"></i>
        <i class="fas fa-note-musical floating-icon" style="top: 80%; left: 30%; animation-delay: 5s;"></i>
    </div>

    <!-- Version Display -->
    <div class="version-display" id="versionDisplay">v1.5.0</div>

    <!-- Control Panel -->
    <div class="control-panel" id="controlPanel">
        <div><strong>DJ Message Display</strong></div>
        <div>Press 'H' to toggle this panel</div>
        <div>Press 'C' to configure display</div>
        <div>Messages auto-refresh every 3 seconds</div>
        <div>Karaoke spinner integrated</div>
        <div id="messageStatus">Waiting for messages...</div>
        <div id="spinnerStatus" style="color: #ffc107;">Spinner: Ready</div>
    </div>

    <!-- QR Code Overlay -->
    <div class="qr-overlay top-right" id="qrOverlay" style="display: none;">
        <canvas id="qrCanvas"></canvas>
        <div class="qr-label" id="qrLabel">Scan to Request Songs!</div>
    </div>

    <!-- Waiting Message -->
    <div class="waiting-message" id="waitingMessage">
        <h2><i class="fas fa-satellite-dish me-3"></i>DJ Message Display</h2>
        <p>Waiting for customer messages...</p>
        <div class="mt-4">
            <i class="fas fa-spinner fa-spin fa-2x"></i>
        </div>
    </div>

    <!-- Message Container -->
    <div class="message-container" id="messageContainer" style="display: none;">
        <div class="message-display" id="messageDisplay">
            <div class="message-icon">
                <i class="fas fa-envelope"></i>
            </div>
            <div class="message-content" id="messageContent"></div>
            <div class="message-from" id="messageFrom"></div>
        </div>
    </div>

    <!-- Karaoke Spinner Overlay -->
    <div class="spinner-overlay" id="spinnerOverlay">
        <div class="spinner-container">
            <h1 class="spinner-title">
                <i class="fas fa-microphone-alt me-3"></i>
                Random Karaoke Selector
                <i class="fas fa-music ms-3"></i>
            </h1>

            <div class="spinner-window">
                <div class="spinner-slot" id="spinnerSlot">
                    <div class="spinner-waiting" id="spinnerWaiting">
                        <i class="fas fa-dice"></i>
                        <div>Spinning...</div>
                    </div>
                    <div class="songs-list" id="songsList" style="display: none;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Winner Display -->
    <div class="winner-display" id="winnerDisplay">
        <div class="winner-icon">
            <i class="fas fa-trophy"></i>
        </div>
        <div class="winner-title-text" id="winnerTitle"></div>
        <div class="winner-artist" id="winnerArtist"></div>
        <div class="winner-difficulty" id="winnerDifficulty"></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
    <script>
    // Load and apply display configuration from database
    (function() {
        <% if (event) { %>
        const config = {
            showQrCode: <%= event.display_show_qr !== 0 %>,
            qrPosition: '<%= event.display_qr_position || 'top-right' %>',
            qrSize: <%= event.display_qr_size || 120 %>,
            qrLabel: '<%= (event.display_qr_label || 'Scan to Request Songs!').replace(/'/g, "\\'") %>',
            bgColor1: '<%= event.display_bg_color1 || '#000428' %>',
            bgColor2: '<%= event.display_bg_color2 || '#004e92' %>',
            bgImage: '<%= event.display_bg_image || '' %>',
            cardColor: '<%= event.display_card_color || '#ffffff' %>',
            cardOpacity: <%= event.display_card_opacity || 85 %>,
            eventSlug: '<%= event.slug %>'
        };
        <% } else { %>
        // No event - use defaults
        const config = {
            showQrCode: false,
            qrPosition: 'top-right',
            qrSize: 120,
            qrLabel: 'Scan to Request Songs!',
            bgColor1: '#000428',
            bgColor2: '#004e92',
            bgImage: '',
            cardColor: '#ffffff',
            cardOpacity: 85,
            eventSlug: null
        };
        <% } %>
        
        const qrOverlay = document.getElementById('qrOverlay');
        const qrCanvas = document.getElementById('qrCanvas');
        const qrLabel = document.getElementById('qrLabel');
        
        // Apply background colors
        const bg1 = config.bgColor1;
        const bg2 = config.bgColor2;
        
        if (config.bgImage) {
            document.body.style.background = `linear-gradient(180deg, ${bg1}aa, ${bg2}aa), url('${config.bgImage}')`;
        } else {
            document.body.style.background = `linear-gradient(180deg, ${bg1}, ${bg2})`;
        }
        document.body.style.backgroundSize = 'cover';
        document.body.style.backgroundPosition = 'center';
        document.body.style.backgroundAttachment = 'fixed';
        
        // Apply card styling via CSS custom property
        const color = config.cardColor;
        const opacity = config.cardOpacity / 100;
        const r = parseInt(color.slice(1,3), 16);
        const g = parseInt(color.slice(3,5), 16);
        const b = parseInt(color.slice(5,7), 16);
        document.documentElement.style.setProperty('--card-bg', `rgba(${r},${g},${b},${opacity})`);
        
        // Show QR code if configured
        if (config.showQrCode && config.eventSlug) {
            qrOverlay.style.display = 'block';
            qrOverlay.className = 'qr-overlay ' + config.qrPosition;
            qrLabel.textContent = config.qrLabel;
            
            const url = window.location.origin + '/event/' + config.eventSlug;
            
            QRCode.toCanvas(qrCanvas, url, { 
                width: config.qrSize,
                margin: 1
            }, function(error) {
                if (error) console.error('QR Error:', error);
            });
        }
        
        // Keyboard shortcut to open config
        document.addEventListener('keydown', function(e) {
            if (e.key === 'c' || e.key === 'C') {
                <% if (event) { %>
                window.open('/dj/display-config/<%= event.slug %>', '_blank');
                <% } else { %>
                alert('No event selected. Please use event-specific display.');
                <% } %>
            }
        });
    })();
    </script>
    <script src="/js/dj-display.js"></script>
</body>
</html>
