<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex,nofollow">
    <title>DJ sign-in | EYUP EVENTS</title>
    <meta name="theme-color" content="#0a0a0a">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Orbitron:wght@400;700;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/eyup-site-chrome.css" rel="stylesheet">
    <% if (turnstileSiteKey) { %>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <% } %>
</head>
<body class="mdj-eyup-brand mdj-dash-tools mdj-dj-login-page">
    <div class="mdj-scanlines" aria-hidden="true"></div>
    <div class="mdj-dj-login-card">
        <div class="text-center mb-4">
            <div class="logo" role="img" aria-label="EYUP EVENTS">
                <span class="logo-text">EYUP</span>
                <span class="logo-accent">EVENTS</span>
                <span class="logo-subtitle"><i class="fas fa-headphones me-1"></i> Mobile DJ requests</span>
            </div>
        </div>
        <p class="text-muted small text-center mb-3">Sign in with your EYUP portal DJ / crew account.</p>
        <% if (error === 'role') { %>
        <div class="alert alert-warning py-2 small">Customer accounts cannot access the DJ dashboard. Use the <a href="https://eyupevents.uk/events/login.html" class="alert-link">customer portal</a>.</div>
        <% } %>
        <div id="loginError" class="alert alert-danger py-2 small d-none" role="alert"></div>
        <form id="djLoginForm" novalidate>
            <div class="mb-3">
                <label for="loginEmail" class="form-label">Email</label>
                <input type="email" class="form-control" id="loginEmail" autocomplete="username" required>
            </div>
            <div class="mb-3">
                <label for="loginPassword" class="form-label">Password</label>
                <input type="password" class="form-control" id="loginPassword" autocomplete="current-password" required>
            </div>
            <% if (turnstileSiteKey) { %>
            <div class="mb-3 turnstile-wrap">
                <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="dark"></div>
            </div>
            <% } %>
            <button type="submit" class="btn btn-primary w-100" id="loginSubmitBtn">
                <i class="fas fa-sign-in-alt me-1"></i> Sign in
            </button>
        </form>
        <p class="small text-muted text-center mt-3 mb-0">
            <a href="https://eyupevents.uk/events/forgot-password.html">Forgot password?</a>
            · <a href="https://eyupevents.uk/events/dj.html">Crew portal</a>
        </p>
    </div>
    <script>
        window.__MDJ_LOGIN_NEXT__ = <%- JSON.stringify(nextUrl || '/dj') %>;
    </script>
    <script src="/js/dj-login.js?v=1"></script>
</body>
</html>
