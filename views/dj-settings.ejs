<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Global Settings - MobileDJay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Orbitron:wght@400;700;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/eyup-site-chrome.css" rel="stylesheet">
    <style>
        /* Theme surfaces: dj-dash-theme.css */
        .banner-preview {
            display: inline-block;
            padding: 0.35rem 1.3rem;
            border-radius: 50px;
            font-weight: 800;
            font-size: 0.85rem;
            color: #fff;
            white-space: nowrap;
        }
        .banner-preview.party { background: linear-gradient(135deg, #ff6b00 0%, #ffb340 100%); text-shadow: 0 1px 3px rgba(0,0,0,0.3); }
        .banner-preview.neon { background: #12001a; border: 2px solid #ff00e6; color: #ff9df3; box-shadow: 0 0 10px rgba(255,0,230,0.7); text-shadow: 0 0 6px #ff00e6; }
        .banner-preview.elegant { background: linear-gradient(135deg, #8a6d1d, #d4af37 45%, #f5e28a); font-family: Georgia, serif; letter-spacing: 1px; }
        .banner-preview.minimal { background: rgba(15,23,32,0.92); border: 1px solid rgba(255,255,255,0.35); }
        .banner-style-option {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem 0.75rem;
            border: 2px solid transparent;
            border-radius: 0.6rem;
            cursor: pointer;
            margin-bottom: 0.4rem;
        }
        .banner-style-option:hover { background: rgba(128,128,128,0.08); }
        .banner-style-option.selected { border-color: #0d6efd; background: rgba(13,110,253,0.08); }
        .settings-section-icon {
            width: 2.2rem;
            height: 2.2rem;
            border-radius: 0.5rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 0.6rem;
        }
    </style>
    <link href="/css/dj-dash-theme.css?v=1" rel="stylesheet">
</head>
<body class="mdj-eyup-brand mdj-dash-tools dark-mode">
    <div class="mdj-scanlines" aria-hidden="true"></div>
    <h1 class="visually-hidden">Global Settings</h1>

    <nav class="mdj-site-navbar mdj-site-navbar--minimal" aria-label="Global settings">
        <div class="nav-container">
            <div class="logo" role="img" aria-label="EYUP EVENTS">
                <span class="logo-text">EYUP</span>
                <span class="logo-accent">EVENTS</span>
                <span class="logo-subtitle"><i class="fas fa-gear" aria-hidden="true"></i> Global Settings</span>
            </div>
            <div class="mdj-nav-controls">
                <a href="/dj" class="btn btn-outline-light btn-sm" title="Back to Dashboard">
                    <i class="fas fa-arrow-left me-1"></i><span class="d-none d-md-inline">Dashboard</span>
                </a>
                <a href="/dj/events" class="btn btn-info btn-sm" title="Event Management">
                    <i class="fas fa-calendar-alt me-1"></i><span class="d-none d-md-inline">Events</span>
                </a>
                <button id="darkModeToggle" class="btn btn-outline-light btn-sm" title="Toggle dark mode" type="button">
                    <i class="fas fa-moon"></i>
                </button>
            </div>
        </div>
    </nav>

    <main class="container mdj-dash-main">
        <div class="mdj-dash-scroll">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="alert alert-info small" role="note">
                    <i class="fas fa-circle-info me-2"></i>
                    These settings apply to <strong>every event</strong>. Per-event options (features, theming, tips, display) live in
                    <a href="/dj/events" class="alert-link">Event Management</a>.
                </div>

                <form id="settingsForm">
                    <ul class="nav nav-tabs mb-4" id="settingsTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="tabGeneralBtn" data-bs-toggle="tab" data-bs-target="#tabGeneral" type="button" role="tab">
                                <i class="fas fa-user-tie me-1"></i>General
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tabMusicBtn" data-bs-toggle="tab" data-bs-target="#tabMusic" type="button" role="tab">
                                <i class="fas fa-compact-disc me-1"></i>Music &amp; VirtualDJ
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tabEventsBtn" data-bs-toggle="tab" data-bs-target="#tabEvents" type="button" role="tab">
                                <i class="fas fa-sliders me-1"></i>Event Defaults
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tabPhotosBtn" data-bs-toggle="tab" data-bs-target="#tabPhotos" type="button" role="tab">
                                <i class="fas fa-images me-1"></i>Photos
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content">
                    <div class="tab-pane fade show active" id="tabGeneral" role="tabpanel">
                    <!-- DJ identity -->
                    <div class="card mb-4">
                        <div class="card-header d-flex align-items-center">
                            <span class="settings-section-icon bg-primary bg-opacity-25 text-primary"><i class="fas fa-user-tie"></i></span>
                            <strong>DJ Identity</strong>
                        </div>
                        <div class="card-body">
                            <div class="mb-0">
                                <label for="djName" class="form-label">DJ display name</label>
                                <input type="text" class="form-control" id="djName" maxlength="50"
                                       value="<%= settings.dj_name %>" placeholder="e.g., DJ Chaos">
                                <div class="form-text">Shown to guests on replies and displays.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Sharing -->
                    <div class="card mb-4">
                        <div class="card-header d-flex align-items-center">
                            <span class="settings-section-icon bg-info bg-opacity-25 text-info"><i class="fas fa-share-nodes"></i></span>
                            <strong>Sharing &amp; Links</strong>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label for="publicBaseUrl" class="form-label">Public base URL</label>
                                <input type="url" class="form-control font-monospace" id="publicBaseUrl"
                                       value="<%= settings.public_base_url %>" placeholder="https://requests.eyupevents.uk">
                                <div class="form-text">
                                    Used to build guest/gallery share links and QR codes. Leave blank to use whatever
                                    address you're browsing from (fine unless you're behind a proxy).
                                </div>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="enablePublicEventsPage"
                                       <%= settings.enable_public_events_page ? 'checked' : '' %>>
                                <label class="form-check-label" for="enablePublicEventsPage">
                                    Enable public events page
                                </label>
                            </div>
                            <div class="form-text mb-0">
                                When enabled, guests can browse and pick an event at the site root (<code>/</code>).
                                Each event must also be marked <strong>Show public</strong> in event settings.
                            </div>
                        </div>
                    </div>

                    </div><!-- /tabGeneral -->

                    <div class="tab-pane fade" id="tabMusic" role="tabpanel">
                    <!-- VirtualDJ integration -->
                    <div class="card mb-4">
                        <div class="card-header d-flex align-items-center">
                            <span class="settings-section-icon bg-warning bg-opacity-25 text-warning"><i class="fas fa-compact-disc"></i></span>
                            <strong>VirtualDJ Integration</strong>
                        </div>
                        <div class="card-body">
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="virtualdjEnabled"
                                       <%= settings.virtualdj_enabled ? 'checked' : '' %>>
                                <label class="form-check-label" for="virtualdjEnabled">Forward requests and messages to VirtualDJ</label>
                            </div>
                            <div class="mb-3">
                                <label for="virtualdjAskPath" class="form-label">VirtualDJ ask path</label>
                                <input type="text" class="form-control font-monospace" id="virtualdjAskPath"
                                       value="<%= settings.virtualdj_ask_path %>" placeholder="/ask/YourChannel">
                                <div class="form-text">The path on virtualdj.com where requests are posted (e.g. <code>/ask/HawaiianNight</code>).</div>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-0">
                                <button type="button" class="btn btn-sm btn-outline-warning" id="testVdjBtn">
                                    <i class="fas fa-paper-plane me-1"></i>Send test message
                                </button>
                                <span id="testVdjStatus" class="small" aria-live="polite"></span>
                            </div>
                            <div class="form-text">Uses the last <em>saved</em> settings — save first if you've changed the path.</div>
                        </div>
                    </div>

                    <!-- Music catalogues -->
                    <div class="card mb-4">
                        <div class="card-header d-flex align-items-center">
                            <span class="settings-section-icon bg-danger bg-opacity-25 text-danger"><i class="fas fa-file-audio"></i></span>
                            <strong>Music Catalogues</strong>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">
                                Upload replacements for the song and karaoke catalogues. Files are validated and
                                take effect immediately — no restart needed.
                            </p>

                            <div class="mb-4">
                                <label for="songDbFile" class="form-label">
                                    <i class="fas fa-database me-1 text-primary"></i>VirtualDJ song database (XML)
                                </label>
                                <div class="small text-muted mb-2" id="songDbInfo">Loading…</div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <input type="file" class="form-control" id="songDbFile" accept=".xml,text/xml,application/xml" style="max-width: 380px;">
                                    <button type="button" class="btn btn-sm btn-outline-primary" id="songDbUploadBtn">
                                        <i class="fas fa-upload me-1"></i>Upload
                                    </button>
                                    <span id="songDbStatus" class="small" aria-live="polite"></span>
                                </div>
                                <div class="form-text">Your VirtualDJ <code>database.xml</code> export — used for the guest song request search.</div>
                            </div>

                            <div class="mb-0">
                                <label for="karaokeFile" class="form-label">
                                    <i class="fas fa-microphone me-1 text-info"></i>Karaoke catalogue (CSV)
                                </label>
                                <div class="small text-muted mb-2" id="karaokeInfo">Loading…</div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <input type="file" class="form-control" id="karaokeFile" accept=".csv,text/csv" style="max-width: 380px;">
                                    <button type="button" class="btn btn-sm btn-outline-info" id="karaokeUploadBtn">
                                        <i class="fas fa-upload me-1"></i>Upload
                                    </button>
                                    <span id="karaokeStatus" class="small" aria-live="polite"></span>
                                </div>
                                <div class="form-text">CSV with <code>Title</code>, <code>Artist</code> and optional <code>Genre</code> columns — used for karaoke requests and the spinner.</div>
                            </div>
                        </div>
                    </div>

                    </div><!-- /tabMusic -->

                    <div class="tab-pane fade" id="tabEvents" role="tabpanel">
                    <!-- New event defaults -->
                    <div class="card mb-4">
                        <div class="card-header d-flex align-items-center">
                            <span class="settings-section-icon bg-success bg-opacity-25 text-success"><i class="fas fa-sliders"></i></span>
                            <strong>New Event Defaults</strong>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">Feature toggles pre-selected when creating a new event.</p>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="defaultSongs" <%= settings.default_enable_song_requests ? 'checked' : '' %>>
                                <label class="form-check-label" for="defaultSongs"><i class="fas fa-music me-1 text-success"></i>Song requests</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="defaultKaraoke" <%= settings.default_enable_karaoke_requests ? 'checked' : '' %>>
                                <label class="form-check-label" for="defaultKaraoke"><i class="fas fa-microphone me-1 text-info"></i>Karaoke requests</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="defaultMessages" <%= settings.default_enable_messages ? 'checked' : '' %>>
                                <label class="form-check-label" for="defaultMessages"><i class="fas fa-envelope me-1 text-warning"></i>Messages</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="defaultPhotos" <%= settings.default_enable_photos ? 'checked' : '' %>>
                                <label class="form-check-label" for="defaultPhotos"><i class="fas fa-camera me-1" style="color:#c084fc;"></i>Guest photos</label>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="defaultTips" <%= settings.default_enable_tips ? 'checked' : '' %>>
                                <label class="form-check-label" for="defaultTips"><i class="fas fa-hand-holding-dollar me-1 text-success"></i>Tips</label>
                            </div>
                        </div>
                    </div>

                    </div><!-- /tabEvents -->

                    <div class="tab-pane fade" id="tabPhotos" role="tabpanel">
                    <!-- Photos -->
                    <div class="card mb-4">
                        <div class="card-header d-flex align-items-center">
                            <span class="settings-section-icon bg-opacity-25" style="background: rgba(168,85,247,0.25); color: #c084fc;"><i class="fas fa-images"></i></span>
                            <strong>Guest Photos</strong>
                        </div>
                        <div class="card-body">
                            <div class="mb-4">
                                <label for="photoMaxPerGuest" class="form-label">Max photos per guest per event</label>
                                <input type="number" class="form-control" id="photoMaxPerGuest" min="1" max="500"
                                       value="<%= settings.photo_max_per_guest %>" style="max-width: 160px;">
                                <div class="form-text">Soft limit to prevent one guest flooding the album.</div>
                            </div>

                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="photoSlideshowEnabled"
                                       <%= settings.photo_slideshow_enabled ? 'checked' : '' %>>
                                <label class="form-check-label" for="photoSlideshowEnabled">
                                    <i class="fas fa-images me-1" style="color:#c084fc;"></i>Photo slideshow on display screens
                                </label>
                            </div>
                            <div class="mb-0">
                                <label for="photoSlideshowMinutes" class="form-label">Show a random photo every</label>
                                <div class="input-group" style="max-width: 200px;">
                                    <input type="number" class="form-control" id="photoSlideshowMinutes" min="1" max="120"
                                           value="<%= settings.photo_slideshow_minutes %>">
                                    <span class="input-group-text">minutes</span>
                                </div>
                                <div class="form-text">
                                    Display screens pop up a random guest photo at this interval (only for events with
                                    photos enabled). DJ-triggered photos always take priority.
                                </div>
                            </div>

                            <div class="mt-4 mb-0">
                                <label class="form-label">Photo popup banner style</label>
                                <div id="bannerStyleOptions">
                                    <div class="banner-style-option" data-value="party">
                                        <input type="radio" name="bannerStyle" value="party" class="form-check-input mt-0">
                                        <span class="banner-preview party"><i class="fas fa-camera me-1"></i>Guest Photo!</span>
                                        <span class="small text-muted">Party — bouncy orange ribbon (default)</span>
                                    </div>
                                    <div class="banner-style-option" data-value="neon">
                                        <input type="radio" name="bannerStyle" value="neon" class="form-check-input mt-0">
                                        <span class="banner-preview neon"><i class="fas fa-camera me-1"></i>Guest Photo!</span>
                                        <span class="small text-muted">Neon — glowing club vibes</span>
                                    </div>
                                    <div class="banner-style-option" data-value="elegant">
                                        <input type="radio" name="bannerStyle" value="elegant" class="form-check-input mt-0">
                                        <span class="banner-preview elegant"><i class="fas fa-camera me-1"></i>Guest Photo!</span>
                                        <span class="small text-muted">Elegant — gold, weddings &amp; formal events</span>
                                    </div>
                                    <div class="banner-style-option" data-value="minimal">
                                        <input type="radio" name="bannerStyle" value="minimal" class="form-check-input mt-0">
                                        <span class="banner-preview minimal"><i class="fas fa-camera me-1"></i>Guest Photo!</span>
                                        <span class="small text-muted">Minimal — clean and understated</span>
                                    </div>
                                </div>
                                <div class="form-text">The banner shown around photos popped up on display screens.</div>
                            </div>
                        </div>
                    </div>

                    </div><!-- /tabPhotos -->
                    </div><!-- /tab-content -->

                    <div class="d-flex align-items-center gap-3 mb-5">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Save Settings
                        </button>
                        <span id="saveStatus" class="small" aria-live="polite"></span>
                    </div>
                </form>
            </div>
        </div>
        </div>

        <footer class="mdj-eyup-footer mdj-eyup-footer--compact" aria-label="Company">
            <div class="mdj-footer-container">
                <div class="mdj-company-foot">
                    <p class="mdj-company-foot__legal">&copy; 2026 EYUP EVENTS UK LTD · Co. no. 17186451 · All rights reserved</p>
                </div>
            </div>
        </footer>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // Dark mode toggle (same behavior/storage key as other DJ pages)
        const toggle = document.getElementById('darkModeToggle');
        function setMode(enabled) {
            document.body.classList.toggle('dark-mode', enabled);
            const icon = toggle.querySelector('i');
            icon.classList.toggle('fa-moon', !enabled);
            icon.classList.toggle('fa-sun', enabled);
        }
        const saved = localStorage.getItem('djDashboardDarkMode');
        const enabled = saved === null ? true : saved === 'true';
        setMode(enabled);
        toggle.addEventListener('click', function () {
            const enabled = !document.body.classList.contains('dark-mode');
            localStorage.setItem('djDashboardDarkMode', enabled ? 'true' : 'false');
            setMode(enabled);
        });

        // VirtualDJ connection test
        const testVdjBtn = document.getElementById('testVdjBtn');
        const testVdjStatus = document.getElementById('testVdjStatus');
        testVdjBtn.addEventListener('click', async function () {
            testVdjBtn.disabled = true;
            testVdjStatus.textContent = 'Sending…';
            testVdjStatus.className = 'small text-muted';
            try {
                const res = await fetch('/api/settings/test-virtualdj', { method: 'POST' });
                const data = await res.json();
                if (!res.ok || !data.success) throw new Error(data.error || 'Test failed');
                testVdjStatus.textContent = 'Test message sent ✓ — check your VirtualDJ ask channel';
                testVdjStatus.className = 'small text-success';
            } catch (err) {
                testVdjStatus.textContent = err.message || 'Test failed';
                testVdjStatus.className = 'small text-danger';
            } finally {
                testVdjBtn.disabled = false;
            }
        });

        // Catalogue uploads (song database XML / karaoke CSV)
        function formatFileInfo(label, data) {
            if (!data.file.exists) {
                return `${label}: <span class="text-warning">no file uploaded yet — using sample data</span>`;
            }
            const date = new Date(data.file.modified).toLocaleString();
            const sizeMb = (data.file.size / (1024 * 1024)).toFixed(1);
            return `${label}: <strong>${data.count.toLocaleString()}</strong> songs loaded · ${data.file.filename} (${sizeMb} MB, updated ${date})`;
        }

        async function refreshCatalogueInfo() {
            try {
                const res = await fetch('/api/settings/catalogues');
                const data = await res.json();
                document.getElementById('songDbInfo').innerHTML = formatFileInfo('Current', data.songs);
                document.getElementById('karaokeInfo').innerHTML = formatFileInfo('Current', data.karaoke);
            } catch (err) {
                document.getElementById('songDbInfo').textContent = 'Could not load catalogue status';
                document.getElementById('karaokeInfo').textContent = 'Could not load catalogue status';
            }
        }
        refreshCatalogueInfo();

        function wireCatalogueUpload(inputId, btnId, statusId, endpoint) {
            const input = document.getElementById(inputId);
            const btn = document.getElementById(btnId);
            const status = document.getElementById(statusId);
            btn.addEventListener('click', async function () {
                if (!input.files || input.files.length === 0) {
                    status.textContent = 'Choose a file first';
                    status.className = 'small text-warning';
                    return;
                }
                btn.disabled = true;
                status.textContent = 'Uploading…';
                status.className = 'small text-muted';
                try {
                    const fd = new FormData();
                    fd.append('file', input.files[0]);
                    const res = await fetch(endpoint, { method: 'POST', body: fd });
                    const data = await res.json();
                    if (!res.ok || !data.success) throw new Error(data.error || 'Upload failed');
                    status.textContent = `Uploaded ✓ — ${data.count.toLocaleString()} songs loaded`;
                    status.className = 'small text-success';
                    input.value = '';
                    refreshCatalogueInfo();
                } catch (err) {
                    status.textContent = err.message || 'Upload failed';
                    status.className = 'small text-danger';
                } finally {
                    btn.disabled = false;
                }
            });
        }
        wireCatalogueUpload('songDbFile', 'songDbUploadBtn', 'songDbStatus', '/api/settings/upload-song-database');
        wireCatalogueUpload('karaokeFile', 'karaokeUploadBtn', 'karaokeStatus', '/api/settings/upload-karaoke-catalog');

        // Banner style picker — whole row is clickable, radio + highlight kept in sync
        const bannerOptions = document.querySelectorAll('.banner-style-option');
        function selectBannerStyle(value) {
            bannerOptions.forEach(opt => {
                const isSelected = opt.dataset.value === value;
                opt.classList.toggle('selected', isSelected);
                opt.querySelector('input').checked = isSelected;
            });
        }
        bannerOptions.forEach(opt => {
            opt.addEventListener('click', () => selectBannerStyle(opt.dataset.value));
        });
        selectBannerStyle('<%= settings.photo_banner_style %>');

        // Save settings
        const form = document.getElementById('settingsForm');
        const saveStatus = document.getElementById('saveStatus');

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            saveStatus.textContent = 'Saving…';
            saveStatus.className = 'small text-muted';

            const payload = {
                dj_name: document.getElementById('djName').value.trim(),
                public_base_url: document.getElementById('publicBaseUrl').value.trim(),
                virtualdj_enabled: document.getElementById('virtualdjEnabled').checked,
                virtualdj_ask_path: document.getElementById('virtualdjAskPath').value.trim(),
                default_enable_song_requests: document.getElementById('defaultSongs').checked,
                default_enable_karaoke_requests: document.getElementById('defaultKaraoke').checked,
                default_enable_messages: document.getElementById('defaultMessages').checked,
                default_enable_photos: document.getElementById('defaultPhotos').checked,
                default_enable_tips: document.getElementById('defaultTips').checked,
                enable_public_events_page: document.getElementById('enablePublicEventsPage').checked,
                photo_max_per_guest: parseInt(document.getElementById('photoMaxPerGuest').value, 10) || 20,
                photo_slideshow_enabled: document.getElementById('photoSlideshowEnabled').checked,
                photo_slideshow_minutes: parseInt(document.getElementById('photoSlideshowMinutes').value, 10) || 5,
                photo_banner_style: (document.querySelector('input[name="bannerStyle"]:checked') || {}).value || 'party'
            };

            try {
                const res = await fetch('/api/settings', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (!res.ok || !data.success) throw new Error(data.error || 'Save failed');
                saveStatus.textContent = 'Saved ✓';
                saveStatus.className = 'small text-success';
                setTimeout(() => { saveStatus.textContent = ''; }, 2500);
            } catch (err) {
                saveStatus.textContent = err.message || 'Save failed';
                saveStatus.className = 'small text-danger';
            }
        });
    });
    </script>
</body>
</html>
