    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Dark mode toggle
        const toggle = document.getElementById('darkModeToggle');
        if (toggle) {
            function setMode(enabled) {
                if (enabled) {
                    document.body.classList.add('dark-mode');
                    const icon = toggle.querySelector('i');
                    if (icon) { icon.classList.remove('fa-moon'); icon.classList.add('fa-sun'); }
                } else {
                    document.body.classList.remove('dark-mode');
                    const icon = toggle.querySelector('i');
                    if (icon) { icon.classList.remove('fa-sun'); icon.classList.add('fa-moon'); }
                }
            }

            const saved = localStorage.getItem('djDashboardDarkMode') === 'true';
            setMode(saved);

            toggle.addEventListener('click', function() {
                const enabled = document.body.classList.toggle('dark-mode');
                localStorage.setItem('djDashboardDarkMode', enabled ? 'true' : 'false');
                setMode(enabled);
            });
        }

        // Modal instances
        const createEventModal = new bootstrap.Modal(document.getElementById('createEventModal'));
        const editEventModal = new bootstrap.Modal(document.getElementById('editEventModal'));

        const displaySlideshowAdmin = new DisplaySlideshowAdmin({
            eventId: null,
            listEl: document.getElementById('editDisplaySlideshowList'),
            uploadBtn: document.getElementById('editDisplaySlideshowUpload'),
            fileInput: document.getElementById('editDisplaySlideshowFile'),
            statusEl: document.getElementById('editDisplaySlideshowStatus')
        });
        const qrCodeModal = new bootstrap.Modal(document.getElementById('qrCodeModal'));

        // Pre-check the create-modal feature toggles from global "New Event Defaults"
        fetch('/api/settings')
            .then(res => res.json())
            .then(settings => {
                document.getElementById('eventEnableSongRequests').checked = settings.default_enable_song_requests !== false;
                document.getElementById('eventEnableKaraokeRequests').checked = settings.default_enable_karaoke_requests !== false;
                document.getElementById('eventEnableMessages').checked = settings.default_enable_messages !== false;
                document.getElementById('eventEnablePhotos').checked = settings.default_enable_photos === true;
                document.getElementById('eventEnableTips').checked = settings.default_enable_tips === true;
                document.getElementById('tipConfigFields').style.display = settings.default_enable_tips ? 'block' : 'none';
            })
            .catch(() => { /* fall back to hard-coded checked states */ });

        // Sync color pickers with text inputs
        function setupColorSync(colorId, textId) {
            const colorInput = document.getElementById(colorId);
            const textInput = document.getElementById(textId);
            if (colorInput && textInput) {
                colorInput.addEventListener('input', () => textInput.value = colorInput.value);
                textInput.addEventListener('input', () => {
                    if (/^#[0-9A-Fa-f]{6}$/.test(textInput.value)) {
                        colorInput.value = textInput.value;
                    }
                });
            }
        }
        
        // Setup color sync for create modal
        setupColorSync('eventHeadingColor', 'eventHeadingColorText');
        setupColorSync('eventTextColor', 'eventTextColorText');
        setupColorSync('eventBgColor', 'eventBgColorText');
        setupColorSync('eventAccentColor', 'eventAccentColorText');
        
        // Setup color sync for edit modal
        setupColorSync('editEventHeadingColor', 'editEventHeadingColorText');
        setupColorSync('editEventTextColor', 'editEventTextColorText');
        setupColorSync('editEventBgColor', 'editEventBgColorText');
        setupColorSync('editEventAccentColor', 'editEventAccentColorText');
        setupColorSync('editDisplayBgColor1', 'editDisplayBgColor1Text');
        setupColorSync('editDisplayBgColor2', 'editDisplayBgColor2Text');
        setupColorSync('editDisplayCardColor', 'editDisplayCardColorText');

        // Range slider value labels (display tab)
        document.getElementById('editDisplayQrSize').addEventListener('input', function() {
            document.getElementById('editDisplayQrSizeValue').textContent = this.value;
        });
        document.getElementById('editDisplayCardOpacity').addEventListener('input', function() {
            document.getElementById('editDisplayCardOpacityValue').textContent = this.value;
        });

        // ── Photo banner style picker (per event; '' = use global setting) ──
        const editBannerOptions = document.querySelectorAll('#editBannerStyleOptions .banner-style-option');
        function selectEditBannerStyle(value) {
            editBannerOptions.forEach(opt => {
                const isSelected = opt.dataset.value === value;
                opt.classList.toggle('selected', isSelected);
                opt.querySelector('input').checked = isSelected;
            });
            // Reflect in the photo popup example (fall back to party for "Global")
            const styleForPreview = value || 'party';
            document.getElementById('photoPreview').className = 'photo-preview pp-style-' + styleForPreview;
            document.getElementById('ppBanner').className = 'pp-banner banner-preview ' + styleForPreview;
        }
        editBannerOptions.forEach(opt => {
            opt.addEventListener('click', () => selectEditBannerStyle(opt.dataset.value));
        });

        // Guest theme — same rules as index.ejs (scoped for preview)
        const GUEST_THEME_LEGACY = { text: '#212529', bg: '#ffffff', accent: '#0d6efd' };
        const GUEST_THEME_PICKER = { heading: '#007bff', text: '#f0f0f5', bg: '#0a0a0a', accent: '#ff6b00' };

        function normalizeGuestThemeStored(value, key) {
            const v = (value || '').trim();
            if (!v) return '';
            if (GUEST_THEME_LEGACY[key] && v.toLowerCase() === GUEST_THEME_LEGACY[key].toLowerCase()) return '';
            return v;
        }

        function readGuestThemeField(textId, pickerKey) {
            const raw = (document.getElementById(textId).value || '').trim();
            if (!raw) return null;
            if (/^#[0-9A-Fa-f]{6}$/.test(raw)) return raw;
            return null;
        }

        function buildGuestEventThemeCss(scope, theme) {
            const parts = [];
            const vars = [];
            if (theme.heading_color) vars.push(`--event-heading-color: ${theme.heading_color};`);
            if (theme.text_color) vars.push(`--event-text-color: ${theme.text_color};`);
            if (theme.bg_color) vars.push(`--event-bg-color: ${theme.bg_color};`);
            if (theme.accent_color) vars.push(`--event-accent-color: ${theme.accent_color};`);
            if (vars.length) parts.push(`:root { ${vars.join(' ')} }`);

            if (theme.bg_color || theme.bg_image) {
                let block = `${scope} {\n`;
                if (theme.bg_color) block += `  background-color: ${theme.bg_color};\n`;
                if (theme.bg_image) {
                    block += `  background-image: url('${escapeCssUrl(theme.bg_image)}');\n`;
                    block += '  background-size: cover;\n  background-position: center;\n';
                }
                block += '}';
                parts.push(block);
            }

            if (theme.text_color) {
                parts.push(`${scope}, ${scope} .card-text, ${scope} p, ${scope} .lead { color: ${theme.text_color}; }`);
            }
            if (theme.heading_color) {
                parts.push(`${scope} h2, ${scope} h3, ${scope} h4, ${scope} h5, ${scope} h6, ${scope} .card-title, ${scope} .display-4 { color: ${theme.heading_color} !important; }`);
            }
            if (theme.accent_color) {
                parts.push(`${scope} .btn-primary { background-color: ${theme.accent_color}; border-color: ${theme.accent_color}; }`);
                parts.push(`${scope} .btn-primary:hover { background-color: color-mix(in srgb, ${theme.accent_color} 85%, black); border-color: color-mix(in srgb, ${theme.accent_color} 85%, black); }`);
                parts.push(`${scope} .text-primary { color: ${theme.accent_color} !important; }`);
                parts.push(`${scope} a { color: ${theme.accent_color}; }`);
            }
            if (theme.custom_css) parts.push(theme.custom_css);
            return parts.join('\n');
        }

        function loadGuestThemeEditorFields(event) {
            const heading = (event.heading_color || '').trim();
            const text = normalizeGuestThemeStored(event.text_color, 'text');
            const bg = normalizeGuestThemeStored(event.bg_color, 'bg');
            const accent = normalizeGuestThemeStored(event.accent_color, 'accent');

            document.getElementById('editEventHeadingColorText').value = heading;
            document.getElementById('editEventHeadingColor').value = heading || GUEST_THEME_PICKER.heading;
            document.getElementById('editEventTextColorText').value = text;
            document.getElementById('editEventTextColor').value = text || GUEST_THEME_PICKER.text;
            document.getElementById('editEventBgColorText').value = bg;
            document.getElementById('editEventBgColor').value = bg || GUEST_THEME_PICKER.bg;
            document.getElementById('editEventAccentColorText').value = accent;
            document.getElementById('editEventAccentColor').value = accent || GUEST_THEME_PICKER.accent;
        }

        // ── Live example previews ──
        function escapeCssUrl(url) {
            return String(url).replace(/\\/g, '\\\\').replace(/'/g, "\\'");
        }

        function updateGuestPreview() {
            const themeStyle = document.getElementById('guestPreviewThemeStyle');
            if (!themeStyle) return;

            let customCss = (document.getElementById('editEventCustomCss').value || '').trim();
            if (customCss) customCss = customCss.replace(/\bbody\b/g, '#guestPreviewScreen');

            const theme = {
                heading_color: readGuestThemeField('editEventHeadingColorText', 'heading'),
                text_color: readGuestThemeField('editEventTextColorText', 'text'),
                bg_color: readGuestThemeField('editEventBgColorText', 'bg'),
                accent_color: readGuestThemeField('editEventAccentColorText', 'accent'),
                bg_image: document.getElementById('editEventBgImage').value.trim() || null,
                custom_css: customCss
            };

            themeStyle.textContent = buildGuestEventThemeCss('#guestPreviewScreen', theme);

            const eventName = document.getElementById('editEventName').value.trim() || 'Your Event Name';
            document.getElementById('gpHeading').textContent = eventName;
            document.getElementById('gpSubtitle').textContent = 'Make your requests and send messages to the DJ!';

            const logo = document.getElementById('editEventLogoImage').value.trim();
            document.getElementById('gpLogoWrap').style.display = logo ? '' : 'none';
            document.getElementById('gpHeroIcon').style.display = logo ? 'none' : '';
            if (logo) {
                document.getElementById('gpLogoImg').src = logo;
                document.getElementById('gpLogoImg').alt = eventName + ' logo';
            }

            const showName = document.getElementById('editGuestPreviewShowNameCard').checked;
            document.getElementById('gpNameCard').style.display = showName ? '' : 'none';
            document.getElementById('gpOptionsSection').style.display = showName ? 'none' : '';

            const featureMap = {
                song: document.getElementById('editEventEnableSongRequests').checked,
                karaoke: document.getElementById('editEventEnableKaraokeRequests').checked,
                message: document.getElementById('editEventEnableMessages').checked,
                photo: document.getElementById('editEventEnablePhotos').checked,
                tip: document.getElementById('editEventEnableTips').checked
            };
            document.querySelectorAll('#guestPreviewScreen [data-gp-feature]').forEach(el => {
                const on = featureMap[el.dataset.gpFeature];
                el.style.display = on ? '' : 'none';
            });
        }

        function updateDisplayPreview() {
            const preview = document.getElementById('displayPreview');
            const bg1 = document.getElementById('editDisplayBgColor1Text').value || '#000428';
            const bg2 = document.getElementById('editDisplayBgColor2Text').value || '#004e92';
            const bgImage = document.getElementById('editDisplayBgImage').value.trim();
            preview.style.background = bgImage
                ? `linear-gradient(180deg, ${bg1}aa, ${bg2}aa), url('${bgImage}') center/cover`
                : `linear-gradient(180deg, ${bg1}, ${bg2})`;

            const qr = document.getElementById('dpQr');
            qr.style.display = document.getElementById('editDisplayShowQr').checked ? 'flex' : 'none';
            qr.className = 'dp-qr ' + (document.getElementById('editDisplayQrPosition').value || 'top-right');

            const cardColor = document.getElementById('editDisplayCardColorText').value || '#ffffff';
            const opacity = (parseInt(document.getElementById('editDisplayCardOpacity').value, 10) || 85) / 100;
            const r = parseInt(cardColor.slice(1, 3), 16), g = parseInt(cardColor.slice(3, 5), 16), b = parseInt(cardColor.slice(5, 7), 16);
            document.getElementById('dpCard').style.background = `rgba(${r},${g},${b},${opacity})`;
        }

        // Any relevant field updates its preview as you type/pick
        ['editEventName', 'editEventDescription', 'editEventHeadingColor', 'editEventHeadingColorText', 'editEventTextColor', 'editEventTextColorText',
         'editEventBgColor', 'editEventBgColorText', 'editEventAccentColor', 'editEventAccentColorText',
         'editEventBgImage', 'editEventLogoImage', 'editEventCustomCss',
         'editEventEnableSongRequests', 'editEventEnableKaraokeRequests', 'editEventEnableMessages',
         'editEventEnablePhotos', 'editEventEnableTips', 'editGuestPreviewShowNameCard'].forEach(id => {
            const el = document.getElementById(id);
            el.addEventListener('input', updateGuestPreview);
            el.addEventListener('change', updateGuestPreview);
        });
        ['editDisplayShowQr', 'editDisplayQrPosition', 'editDisplayBgColor1', 'editDisplayBgColor1Text',
         'editDisplayBgColor2', 'editDisplayBgColor2Text', 'editDisplayBgImage',
         'editDisplayCardColor', 'editDisplayCardColorText', 'editDisplayCardOpacity'].forEach(id => {
            const el = document.getElementById(id);
            el.addEventListener('input', updateDisplayPreview);
            el.addEventListener('change', updateDisplayPreview);
        });

        // Image URL fields ↔ thumbnails
        function syncThumb(inputId, thumbId) {
            const input = document.getElementById(inputId);
            const thumb = document.getElementById(thumbId);
            const update = () => {
                const url = input.value.trim();
                thumb.src = url;
                thumb.style.display = url ? '' : 'none';
            };
            input.addEventListener('input', update);
            input.addEventListener('change', update);
        }
        syncThumb('editEventBgImage', 'editBgImageThumb');
        syncThumb('editEventLogoImage', 'editLogoImageThumb');
        syncThumb('editDisplayBgImage', 'editDisplayBgImageThumb');

        // Theme image upload buttons (bg / logo / display_bg)
        document.querySelectorAll('.theme-upload-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const kind = this.dataset.kind;
                const targetInput = document.getElementById(this.dataset.target);
                const thumb = document.getElementById(this.dataset.thumb);
                const status = document.getElementById('themeUploadStatus');
                const eventId = document.getElementById('editEventId').value;
                if (!eventId) return;

                const picker = document.createElement('input');
                picker.type = 'file';
                picker.accept = 'image/*';
                picker.addEventListener('change', async () => {
                    const file = picker.files && picker.files[0];
                    if (!file) return;
                    const icon = this.querySelector('i');
                    icon.classList.replace('fa-upload', 'fa-spinner');
                    icon.classList.add('fa-spin');
                    if (status) { status.textContent = 'Uploading…'; status.className = 'small text-muted'; }
                    try {
                        const formData = new FormData();
                        formData.append('image', file);
                        const res = await fetch(`/api/events/${eventId}/theme-image?kind=${kind}`, {
                            method: 'POST',
                            body: formData
                        });
                        const data = await res.json();
                        if (!res.ok || !data.success) throw new Error(data.error || 'Upload failed');
                        targetInput.value = data.url;
                        targetInput.dispatchEvent(new Event('change'));
                        if (thumb) { thumb.src = data.url; thumb.style.display = ''; }
                        if (status) { status.textContent = 'Uploaded ✓ — remember to Save Changes'; status.className = 'small text-success'; }
                    } catch (err) {
                        if (status) { status.textContent = err.message || 'Upload failed'; status.className = 'small text-danger'; }
                        else alert(err.message || 'Upload failed');
                    } finally {
                        icon.classList.remove('fa-spin');
                        icon.classList.replace('fa-spinner', 'fa-upload');
                    }
                });
                picker.click();
            });
        });

        // Tip toggle visibility
        function setupTipToggle(checkboxId, fieldsId) {
            const cb = document.getElementById(checkboxId);
            const fields = document.getElementById(fieldsId);
            if (cb && fields) {
                cb.addEventListener('change', () => fields.style.display = cb.checked ? 'block' : 'none');
                fields.style.display = cb.checked ? 'block' : 'none';
            }
        }
        setupTipToggle('eventEnableTips', 'tipConfigFields');
        setupTipToggle('editEventEnableTips', 'editTipConfigFields');

        // Dynamic tip links builder
        const tipProviders = [
            { value: 'stripe', label: 'Stripe', icon: 'fa-credit-card' },
            { value: 'square', label: 'Square', icon: 'fa-square' },
            { value: 'venmo', label: 'Venmo', icon: 'fa-v' },
            { value: 'cashapp', label: 'Cash App', icon: 'fa-dollar-sign' },
            { value: 'paypal', label: 'PayPal', icon: 'fa-p' },
            { value: 'other', label: 'Other', icon: 'fa-link' }
        ];

        function createTipLinkRow(container, data = {}) {
            const row = document.createElement('div');
            row.className = 'tip-link-row mb-2 p-2 border rounded';
            row.innerHTML = `
                <div class="d-flex gap-2 align-items-start">
                    <div style="min-width: 130px;">
                        <select class="form-select form-select-sm tip-provider">
                            <option value="">Provider...</option>
                            ${tipProviders.map(p => `<option value="${p.value}"${data.provider === p.value ? ' selected' : ''}>${p.label}</option>`).join('')}
                        </select>
                    </div>
                    <div class="flex-grow-1">
                        <input type="url" class="form-control form-control-sm tip-url" placeholder="https://..." value="${data.url ? data.url.replace(/"/g, '&quot;') : ''}">
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger tip-remove-btn" title="Remove">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <input type="text" class="form-control form-control-sm mt-1 tip-label" placeholder="Custom label (optional)" value="${data.label ? data.label.replace(/"/g, '&quot;') : ''}">
            `;
            row.querySelector('.tip-remove-btn').addEventListener('click', () => row.remove());
            container.appendChild(row);
        }

        function getTipLinks(containerId) {
            const rows = document.querySelectorAll(`#${containerId} .tip-link-row`);
            const links = [];
            rows.forEach(row => {
                const provider = row.querySelector('.tip-provider').value;
                const url = row.querySelector('.tip-url').value.trim();
                const label = row.querySelector('.tip-label').value.trim();
                if (provider && url) {
                    links.push({ provider, url, label: label || null });
                }
            });
            return links;
        }

        document.getElementById('addTipLinkBtn').addEventListener('click', () => {
            createTipLinkRow(document.getElementById('tipLinksContainer'));
        });
        document.getElementById('editAddTipLinkBtn').addEventListener('click', () => {
            createTipLinkRow(document.getElementById('editTipLinksContainer'));
        });

        // Create event
        document.getElementById('saveEventBtn').addEventListener('click', async function() {
            const name = document.getElementById('eventName').value.trim();
            if (!name) {
                alert('Event name is required');
                return;
            }

            const data = {
                name,
                description: document.getElementById('eventDescription').value.trim(),
                venue: document.getElementById('eventVenue').value.trim(),
                eventDate: document.getElementById('eventDate').value || null,
                heading_color: document.getElementById('eventHeadingColorText').value || null,
                text_color: document.getElementById('eventTextColorText').value || null,
                bg_color: document.getElementById('eventBgColorText').value || null,
                accent_color: document.getElementById('eventAccentColorText').value || null,
                bg_image: document.getElementById('eventBgImage').value.trim() || null,
                custom_css: document.getElementById('eventCustomCss').value.trim() || null,
                enable_song_requests: document.getElementById('eventEnableSongRequests').checked,
                enable_karaoke_requests: document.getElementById('eventEnableKaraokeRequests').checked,
                enable_messages: document.getElementById('eventEnableMessages').checked,
                enable_photos: document.getElementById('eventEnablePhotos').checked,
                enable_tips: document.getElementById('eventEnableTips').checked,
                show_public: document.getElementById('eventShowPublic').checked,
                tip_links: getTipLinks('tipLinksContainer')
            };

            try {
                const response = await fetch('/api/events', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    createEventModal.hide();
                    document.getElementById('createEventForm').reset();
                    window.location.reload();
                } else {
                    alert('Error: ' + (result.error || 'Failed to create event'));
                }
            } catch (error) {
                console.error('Error creating event:', error);
                alert('Failed to create event');
            }
        });

        // Edit event (optionally opening straight onto a specific tab)
        async function openEditModal(eventId, tabBtnId) {
                try {
                    const response = await fetch(`/api/events`);
                    const events = await response.json();
                    const event = events.find(e => e.id == eventId);
                    if (event) {
                        document.getElementById('editEventId').value = event.id;
                        document.getElementById('editEventName').value = event.name;
                        document.getElementById('editEventDescription').value = event.description || '';
                        document.getElementById('editEventVenue').value = event.venue || '';
                        document.getElementById('editEventDate').value = event.event_date ? event.event_date.split('T')[0] : '';
                        
                        loadGuestThemeEditorFields(event);
                        document.getElementById('editEventBgImage').value = event.bg_image || '';
                        document.getElementById('editEventBgImage').dispatchEvent(new Event('change'));
                        document.getElementById('editEventLogoImage').value = event.logo_image || '';
                        document.getElementById('editEventLogoImage').dispatchEvent(new Event('change'));
                        document.getElementById('editEventCustomCss').value = event.custom_css || '';

                        // Load display screen config
                        document.getElementById('editDisplayShowQr').checked = event.display_show_qr !== 0;
                        document.getElementById('editDisplayQrPosition').value = event.display_qr_position || 'top-right';
                        document.getElementById('editDisplayQrSize').value = event.display_qr_size || 120;
                        document.getElementById('editDisplayQrSizeValue').textContent = event.display_qr_size || 120;
                        document.getElementById('editDisplayQrLabel').value = event.display_qr_label || 'Scan to Request Songs!';
                        const dispBg1 = event.display_bg_color1 || '#000428';
                        const dispBg2 = event.display_bg_color2 || '#004e92';
                        const dispCard = event.display_card_color || '#ffffff';
                        document.getElementById('editDisplayBgColor1').value = dispBg1;
                        document.getElementById('editDisplayBgColor1Text').value = dispBg1;
                        document.getElementById('editDisplayBgColor2').value = dispBg2;
                        document.getElementById('editDisplayBgColor2Text').value = dispBg2;
                        document.getElementById('editDisplayCardColor').value = dispCard;
                        document.getElementById('editDisplayCardColorText').value = dispCard;
                        document.getElementById('editDisplayCardOpacity').value = event.display_card_opacity || 85;
                        document.getElementById('editDisplayCardOpacityValue').textContent = event.display_card_opacity || 85;
                        document.getElementById('editDisplayBgImage').value = event.display_bg_image || '';
                        document.getElementById('editDisplayBgImage').dispatchEvent(new Event('change'));
                        document.getElementById('editDisplaySlideshowEnabled').checked = event.display_bg_slideshow_enabled === 1;
                        document.getElementById('editDisplaySlideshowSeconds').value = event.display_bg_slideshow_seconds || 15;
                        document.getElementById('editOpenDisplayLink').href = '/dj/display/' + event.slug;
                        displaySlideshowAdmin.setEventId(event.id);
                        displaySlideshowAdmin.load();
                        
                        // Load feature toggles
                        document.getElementById('editEventEnableSongRequests').checked = event.enable_song_requests !== 0;
                        document.getElementById('editEventEnableKaraokeRequests').checked = event.enable_karaoke_requests !== 0;
                        document.getElementById('editEventEnableMessages').checked = event.enable_messages !== 0;
                        document.getElementById('editEventEnablePhotos').checked = event.enable_photos === 1;
                        document.getElementById('editEventShowTracksGuest').checked = event.show_tracks_played_guest === 1;
                        document.getElementById('editEventShowPublic').checked = event.show_public === 1;
                        
                        // Load tip settings
                        document.getElementById('editEventEnableTips').checked = event.enable_tips !== 0;
                        document.getElementById('editTipConfigFields').style.display = event.enable_tips ? 'block' : 'none';
                        // Populate tip links
                        const editContainer = document.getElementById('editTipLinksContainer');
                        editContainer.innerHTML = '';
                        let tipLinks = [];
                        if (event.tip_links) {
                            try { tipLinks = JSON.parse(event.tip_links); } catch(e) {}
                        }
                        // Backward compat: migrate old single link
                        if (tipLinks.length === 0 && event.tip_provider && event.tip_payment_link) {
                            tipLinks = [{ provider: event.tip_provider, url: event.tip_payment_link }];
                        }
                        tipLinks.forEach(link => createTipLinkRow(editContainer, link));

                        // Photo banner style + live previews
                        selectEditBannerStyle(event.photo_banner_style || '');
                        updateGuestPreview();
                        updateDisplayPreview();

                        bootstrap.Tab.getOrCreateInstance(
                            document.getElementById(tabBtnId || 'editTabDetailsBtn')
                        ).show();
                        editEventModal.show();
                    }
                } catch (error) {
                    console.error('Error fetching event:', error);
                }
        }

        document.querySelectorAll('.edit-event').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                openEditModal(this.dataset.eventId);
            });
        });
        document.querySelectorAll('.edit-display').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                openEditModal(this.dataset.eventId, 'editTabDisplayBtn');
            });
        });

        // Update event
        document.getElementById('updateEventBtn').addEventListener('click', async function() {
            const eventId = document.getElementById('editEventId').value;
            const data = {
                name: document.getElementById('editEventName').value.trim(),
                description: document.getElementById('editEventDescription').value.trim(),
                venue: document.getElementById('editEventVenue').value.trim(),
                event_date: document.getElementById('editEventDate').value || null,
                heading_color: document.getElementById('editEventHeadingColorText').value || null,
                text_color: document.getElementById('editEventTextColorText').value || null,
                bg_color: document.getElementById('editEventBgColorText').value || null,
                accent_color: document.getElementById('editEventAccentColorText').value || null,
                bg_image: document.getElementById('editEventBgImage').value.trim() || null,
                logo_image: document.getElementById('editEventLogoImage').value.trim() || null,
                custom_css: document.getElementById('editEventCustomCss').value.trim() || null,
                enable_song_requests: document.getElementById('editEventEnableSongRequests').checked ? 1 : 0,
                enable_karaoke_requests: document.getElementById('editEventEnableKaraokeRequests').checked ? 1 : 0,
                enable_messages: document.getElementById('editEventEnableMessages').checked ? 1 : 0,
                enable_photos: document.getElementById('editEventEnablePhotos').checked ? 1 : 0,
                show_tracks_played_guest: document.getElementById('editEventShowTracksGuest').checked ? 1 : 0,
                show_public: document.getElementById('editEventShowPublic').checked ? 1 : 0,
                enable_tips: document.getElementById('editEventEnableTips').checked ? 1 : 0,
                tip_links: getTipLinks('editTipLinksContainer'),
                display_show_qr: document.getElementById('editDisplayShowQr').checked ? 1 : 0,
                display_qr_position: document.getElementById('editDisplayQrPosition').value,
                display_qr_size: parseInt(document.getElementById('editDisplayQrSize').value, 10) || 120,
                display_qr_label: document.getElementById('editDisplayQrLabel').value.trim() || 'Scan to Request Songs!',
                display_bg_color1: document.getElementById('editDisplayBgColor1Text').value || '#000428',
                display_bg_color2: document.getElementById('editDisplayBgColor2Text').value || '#004e92',
                display_bg_image: document.getElementById('editDisplayBgImage').value.trim() || null,
                display_bg_slideshow_enabled: document.getElementById('editDisplaySlideshowEnabled').checked ? 1 : 0,
                display_bg_slideshow_seconds: parseInt(document.getElementById('editDisplaySlideshowSeconds').value, 10) || 15,
                display_card_color: document.getElementById('editDisplayCardColorText').value || '#ffffff',
                display_card_opacity: parseInt(document.getElementById('editDisplayCardOpacity').value, 10) || 85,
                photo_banner_style: (document.querySelector('input[name="editBannerStyle"]:checked') || {}).value || null
            };

            try {
                const response = await fetch(`/api/events/${eventId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    editEventModal.hide();
                    window.location.reload();
                } else {
                    alert('Error: ' + (result.error || 'Failed to update event'));
                }
            } catch (error) {
                console.error('Error updating event:', error);
                alert('Failed to update event');
            }
        });

        // Toggle event active status
        document.querySelectorAll('.toggle-event').forEach(btn => {
            btn.addEventListener('click', async function(e) {
                e.preventDefault();
                const eventId = this.dataset.eventId;
                const currentActive = this.dataset.active === '1';
                
                try {
                    const response = await fetch(`/api/events/${eventId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ is_active: currentActive ? 0 : 1 })
                    });
                    const result = await response.json();
                    if (result.success) {
                        window.location.reload();
                    }
                } catch (error) {
                    console.error('Error toggling event:', error);
                }
            });
        });

        // Delete event
        document.querySelectorAll('.delete-event').forEach(btn => {
            btn.addEventListener('click', async function(e) {
                e.preventDefault();
                const eventId = this.dataset.eventId;
                
                if (!confirm('Are you sure you want to delete this event? All associated requests and messages will also be deleted.')) {
                    return;
                }
                
                try {
                    const response = await fetch(`/api/events/${eventId}`, {
                        method: 'DELETE'
                    });
                    const result = await response.json();
                    if (result.success) {
                        window.location.reload();
                    }
                } catch (error) {
                    console.error('Error deleting event:', error);
                }
            });
        });

        // Copy URL buttons
        document.querySelectorAll('.copy-url').forEach(btn => {
            btn.addEventListener('click', function() {
                const url = window.location.origin + this.dataset.url;
                navigator.clipboard.writeText(url).then(() => {
                    const icon = this.querySelector('i');
                    icon.classList.remove('fa-copy');
                    icon.classList.add('fa-check');
                    setTimeout(() => {
                        icon.classList.remove('fa-check');
                        icon.classList.add('fa-copy');
                    }, 2000);
                });
            });
        });

        // Show QR Code
        document.querySelectorAll('.show-qr').forEach(btn => {
            btn.addEventListener('click', function() {
                const slug = this.dataset.slug;
                const name = this.dataset.name;
                const url = window.location.origin + '/event/' + slug;
                
                document.getElementById('qrEventName').textContent = name;
                document.getElementById('qrEventUrl').value = url;
                
                const container = document.getElementById('qrCodeContainer');
                container.innerHTML = '';
                
                if (typeof QRCode !== 'undefined') {
                    QRCode.toCanvas(url, { width: 200 }, function(error, canvas) {
                        if (error) {
                            container.innerHTML = '<p class="text-danger">Failed to generate QR code</p>';
                            return;
                        }
                        container.appendChild(canvas);
                    });
                } else {
                    container.innerHTML = '<p class="text-muted">QR Code library not loaded</p>';
                }
                
                qrCodeModal.show();
            });
        });

        // ── Share links modal ─────────────────────────────────────────
        const shareLinksModal = new bootstrap.Modal(document.getElementById('shareLinksModal'));
        const shareLinksList = document.getElementById('shareLinksList');
        const shareLinksLoading = document.getElementById('shareLinksLoading');
        let shareEventId = null;

        const LINK_META = [
            { key: 'guest',   label: 'Guest requests page', icon: 'fa-users',  desc: 'Send/QR to guests at the event' },
            { key: 'photos',  label: 'Photo upload page',   icon: 'fa-camera', desc: 'Guests snap photos into the album' },
            { key: 'gallery', label: 'Customer photo album', icon: 'fa-images', desc: 'Private link — send to the customer after the event' },
            { key: 'display', label: 'DJ display screen',   icon: 'fa-tv',     desc: 'Open on a big screen / projector' }
        ];

        function renderShareLinks(links) {
            shareLinksList.innerHTML = '';
            LINK_META.forEach(meta => {
                const url = links[meta.key];
                if (!url) return;
                const row = document.createElement('div');
                row.className = 'mb-3';
                row.innerHTML = `
                    <label class="form-label small fw-bold mb-1"><i class="fas ${meta.icon} me-2"></i>${meta.label}</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control event-url" value="${url}" readonly>
                        <button class="btn btn-outline-secondary share-copy" type="button" title="Copy link"><i class="fas fa-copy"></i></button>
                        <button class="btn btn-outline-primary share-qr" type="button" title="Show QR code"><i class="fas fa-qrcode"></i></button>
                    </div>
                    <div class="form-text">${meta.desc}</div>
                `;
                row.querySelector('.share-copy').addEventListener('click', function() {
                    navigator.clipboard.writeText(url).then(() => {
                        const icon = this.querySelector('i');
                        icon.classList.replace('fa-copy', 'fa-check');
                        setTimeout(() => icon.classList.replace('fa-check', 'fa-copy'), 2000);
                    });
                });
                row.querySelector('.share-qr').addEventListener('click', function() {
                    document.getElementById('qrEventName').textContent = meta.label;
                    document.getElementById('qrEventUrl').value = url;
                    const container = document.getElementById('qrCodeContainer');
                    container.innerHTML = '';
                    if (typeof QRCode !== 'undefined') {
                        QRCode.toCanvas(url, { width: 200 }, function(error, canvas) {
                            if (error) {
                                container.innerHTML = '<p class="text-danger">Failed to generate QR code</p>';
                                return;
                            }
                            container.appendChild(canvas);
                        });
                    }
                    shareLinksModal.hide();
                    qrCodeModal.show();
                });
                shareLinksList.appendChild(row);
            });
            shareLinksLoading.style.display = 'none';
            shareLinksList.style.display = 'block';
        }

        async function loadShareLinks(eventId) {
            shareLinksLoading.style.display = 'block';
            shareLinksList.style.display = 'none';
            try {
                const res = await fetch(`/api/events/${eventId}/links`);
                const links = await res.json();
                renderShareLinks(links);
            } catch (err) {
                shareLinksLoading.innerHTML = '<span class="text-danger">Failed to load links</span>';
            }
        }

        document.querySelectorAll('.share-links').forEach(btn => {
            btn.addEventListener('click', function() {
                shareEventId = this.dataset.eventId;
                document.getElementById('shareEventName').textContent = this.dataset.name;
                shareLinksModal.show();
                loadShareLinks(shareEventId);
            });
        });

        document.getElementById('regenTokenBtn').addEventListener('click', async function() {
            if (!shareEventId) return;
            if (!confirm('Regenerate the gallery link? Anyone with the old link will lose access.')) return;
            try {
                const res = await fetch(`/api/events/${shareEventId}/regenerate-share-token`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    loadShareLinks(shareEventId);
                } else {
                    alert('Failed to regenerate link');
                }
            } catch (err) {
                alert('Failed to regenerate link');
            }
        });

        // Copy QR URL
        document.getElementById('copyQrUrl').addEventListener('click', function() {
            const url = document.getElementById('qrEventUrl').value;
            navigator.clipboard.writeText(url).then(() => {
                const icon = this.querySelector('i');
                icon.classList.remove('fa-copy');
                icon.classList.add('fa-check');
                setTimeout(() => {
                    icon.classList.remove('fa-check');
                    icon.classList.add('fa-copy');
                }, 2000);
            });
        });
    });
    </script>
</body>
</html>
