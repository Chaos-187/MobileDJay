<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guest Spinner - MobileDJay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #7986cb;
            --secondary-color: #5c6bc0;
        }
        body {
            background: linear-gradient(135deg, rgba(26, 26, 46, 0.9) 0%, rgba(22, 33, 62, 0.9) 100%),
                url('/images/dj-bg.jpg') center/cover no-repeat fixed;
            margin: 0;
            overflow: hidden;
            font-family: Arial, sans-serif;
            cursor: none;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .spinner-container { width: 100%; max-width: 1200px; padding: 2rem; }
        .spinner-title {
            text-align: center;
            color: white;
            font-size: 3rem;
            font-weight: bold;
            margin-bottom: 2rem;
            animation: pulse 2s ease-in-out infinite;
        }
        .spinner-window {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 2rem;
            border: 3px solid var(--primary-color);
            min-height: 400px;
            position: relative;
            overflow: hidden;
        }
        .spinner-slot {
            background: rgba(0, 0, 0, 0.4);
            border-radius: 15px;
            height: 300px;
            position: relative;
            overflow: hidden;
            border: 2px solid rgba(121, 134, 203, 0.35);
        }
        .spinner-slot::before, .spinner-slot::after {
            content: '';
            position: absolute;
            left: 0; right: 0;
            height: 2px;
            background: var(--primary-color);
            z-index: 10;
        }
        .spinner-slot::before { top: calc(50% - 150px); }
        .spinner-slot::after { bottom: calc(50% - 150px); }
        .guests-list { position: absolute; top: 0; left: 0; right: 0; }
        .guest-item {
            height: 300px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #fff;
            border-bottom: 2px solid rgba(255,255,255,0.1);
        }
        .guest-name { font-size: 2.5rem; font-weight: bold; }
        .guest-stats { font-size: 1.2rem; color: #c5cae9; margin-top: 0.5rem; }
        .waiting-message {
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: rgba(255,255,255,0.7);
            font-size: 2rem;
        }
        .winner-display {
            display: none;
            position: fixed;
            inset: 0;
            background: linear-gradient(135deg, rgba(57, 73, 171, 0.97), rgba(92, 107, 192, 0.97));
            z-index: 1000;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            text-align: center;
            padding: 2rem;
        }
        .winner-display.show { display: flex; animation: winnerFullscreen 1s ease forwards; }
        .winner-title { font-size: clamp(2.5rem, 8vw, 5rem); font-weight: 800; color: #fff9c4; }
        .winner-artist { font-size: 1.75rem; color: #fff; margin-top: 1rem; }
        .winner-icon { font-size: 6rem; color: #ffd54f; margin-bottom: 1.5rem; }
        @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.85} }
        @keyframes winnerFullscreen { from{transform:scale(.5);opacity:0} to{transform:scale(1);opacity:1} }
        .control-panel {
            position: fixed; top: 10px; right: 10px;
            background: rgba(0,0,0,.8); color: #fff;
            padding: 10px; border-radius: 10px; font-size: .9rem;
            opacity: 0; transition: opacity .3s; z-index: 1000;
        }
        .control-panel.show, .control-panel:hover { opacity: .75; }
        .confetti {
            position: fixed; width: 10px; height: 10px;
            animation: confettiFall 3s linear forwards;
        }
        @keyframes confettiFall {
            from { transform: translateY(-100vh); opacity: 1; }
            to { transform: translateY(100vh); opacity: 0; }
        }
    </style>
</head>
<body>
    <div class="control-panel" id="controlPanel">
        <div><strong>Guest Spinner</strong></div>
        <div>Waiting for DJ to trigger...</div>
        <div id="spinStatus">Ready</div>
    </div>
    <div class="spinner-container">
        <h1 class="spinner-title">
            <i class="fas fa-users me-3"></i>Random Guest Selector<i class="fas fa-user-check ms-3"></i>
        </h1>
        <div class="spinner-window">
            <div class="spinner-slot" id="spinnerSlot">
                <div class="waiting-message" id="waitingMessage">
                    <i class="fas fa-dice fa-3x mb-3"></i>
                    <div>Waiting for DJ to spin...</div>
                    <div style="font-size:1rem;margin-top:1rem;opacity:.6">Use ?event=your-event-slug in the URL</div>
                </div>
                <div class="guests-list" id="guestsList" style="display:none"></div>
            </div>
        </div>
    </div>
    <div class="winner-display" id="winnerDisplay">
        <div class="winner-icon"><i class="fas fa-user-check"></i></div>
        <div class="winner-title" id="winnerTitle"></div>
        <div class="winner-artist" id="winnerArtist"></div>
    </div>
    <script>
        (function () {
            var params = new URLSearchParams(window.location.search);
            var slug = params.get('event') || params.get('eventSlug');
            if (slug) window.displayEventSlug = String(slug).trim();
        })();
    </script>
    <script src="/js/guest-spinner.js"></script>
</body>
</html>
