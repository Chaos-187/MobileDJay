<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guest Spinner - MobileDJay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="/css/spinner-show.css?v=1" rel="stylesheet">
</head>
<body class="spinner-page spinner-theme-guest">
    <div class="mdj-spinner-rays" aria-hidden="true"></div>

    <div class="control-panel" id="controlPanel">
        <div><strong>Guest Spinner</strong></div>
        <div>Waiting for DJ to trigger...</div>
        <div id="spinStatus">Ready</div>
    </div>

    <div class="spinner-container">
        <h1 class="spinner-title">
            <i class="fas fa-users me-3"></i>
            Random Guest Selector
            <i class="fas fa-user-check ms-3"></i>
        </h1>
        <div class="guest-spinner-window">
            <div class="guest-spinner-slot" id="spinnerSlot">
                <div class="mdj-slot-vignette" aria-hidden="true"></div>
                <div class="mdj-slot-highlight" aria-hidden="true"></div>
                <div class="waiting-message" id="waitingMessage">
                    <i class="fas fa-dice"></i>
                    <div>Waiting for DJ to spin...</div>
                    <div style="font-size: 1rem; margin-top: 1rem; opacity: 0.55;">
                        Use ?event=your-event-slug in the URL
                    </div>
                </div>
                <div class="guests-list" id="guestsList" style="display: none"></div>
            </div>
        </div>
    </div>

    <div class="guest-winner-display" id="winnerDisplay">
        <div class="winner-label">Selected guest</div>
        <div class="winner-icon"><i class="fas fa-user-check"></i></div>
        <div class="guest-winner-name" id="winnerTitle"></div>
        <div class="guest-winner-sub" id="winnerArtist"></div>
    </div>

    <script>
        (function () {
            var params = new URLSearchParams(window.location.search);
            var slug = params.get('event') || params.get('eventSlug');
            if (slug) window.displayEventSlug = String(slug).trim();
        })();
    </script>
    <script src="/js/guest-spinner.js?v=2"></script>
</body>
</html>
