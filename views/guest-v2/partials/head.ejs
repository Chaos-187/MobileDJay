<%
  const gv2Event = typeof event !== 'undefined' ? event : null;
  const gv2Title = typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Guest Hub';
  const gv2Theme = gv2Event && gv2Event.accent_color ? gv2Event.accent_color : '#6366f1';
%>
<meta charset="UTF-8">
<%- include('../../partials/guest-mobile-head', { themeColor: gv2Theme, appTitle: gv2Event && gv2Event.name ? gv2Event.name : 'EYUP EVENTS' }) %>
<title><%= gv2Title %><% if (gv2Event && gv2Event.name) { %> · <%= gv2Event.name %><% } %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
<link href="/css/guest-v2/guest-v2.css?v=1" rel="stylesheet">
<% if (typeof includeBootstrap !== 'undefined' && includeBootstrap) { %>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="/css/guest-v2/guest-v2-flows.css?v=1" rel="stylesheet">
<% } %>
<% if (typeof includeGuestChat !== 'undefined' && includeGuestChat) { %>
<link href="/css/guest-chat.css" rel="stylesheet">
<link href="/css/guest-v2/guest-v2-messages.css?v=1" rel="stylesheet">
<% } %>
<% if (gv2Event) { %>
<%- include('../../partials/guest-event-theme', { event: gv2Event }) %>
<% } %>
