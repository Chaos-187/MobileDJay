<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <%- include('partials/guest-mobile-head', { themeColor: '#0a0a0a' }) %>
    <title>MobileDJay - DJ Request System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Orbitron:wght@400;700;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/eyup-site-chrome.css" rel="stylesheet">
    <link href="/css/guest-hub.css?v=7" rel="stylesheet">
    
    <%- include('partials/guest-event-theme', { event: typeof event !== 'undefined' ? event : null }) %>
    

</head>
<%
  const hubEvent = typeof event !== 'undefined' ? event : null;
  let hubBodyClass = 'mdj-eyup-brand mdj-guest-hub-page';
  if (!hubEvent || hubEvent.guest_menu_compact !== 0) hubBodyClass += ' mdj-guest-hub-compact';
  if (hubEvent && hubEvent.guest_show_option_desc === 0) hubBodyClass += ' mdj-guest-hub-no-desc';
  if (hubEvent && hubEvent.guest_hero_compact === 1) hubBodyClass += ' mdj-guest-hub-hero-compact';
%>
<body class="<%= hubBodyClass %>">
    <div class="mdj-scanlines" aria-hidden="true"></div>

    <span id="welcomeName" class="visually-hidden"></span>
    <script>
        window.eventSlug = '<%= eventSlug || "" %>';
        window.djName = '<%= typeof djName !== "undefined" && djName ? djName : "DJ" %>';
    </script>

    <main class="container mdj-guest-hub-main">
        <div class="index-page">
            <div class="guest-hub-top" aria-hidden="false">
                <button id="repliesBellBtn" type="button" class="nav-msg-btn guest-hub-messages-btn position-relative" title="Messages" aria-pressed="false" aria-label="Messages" hidden>
                    <i class="fas fa-comment-dots"></i>
                    <span class="guest-hub-messages-label">Messages</span>
                    <span id="repliesBadge" class="nav-msg-badge" style="display: none;">0</span>
                </button>
            </div>
            <!-- Hero Section (hidden when now playing) -->
            <header class="hero-section" id="heroSection">
                <% if (event && event.logo_image) { %>
                <div class="hero-event-logo">
                    <img src="<%= event.logo_image %>" alt="<%= event.name %> logo"
                         style="max-width: min(280px, 70vw); max-height: 140px; object-fit: contain;">
                </div>
                <% } else { %>
                <div class="hero-icon">
                    <i class="fas fa-headphones-alt"></i>
                </div>
                <% } %>
                <h1 class="hero-title"><%= event && event.name ? event.name : 'Welcome to MobileDJay' %></h1>
                <p class="hero-subtitle">Make your requests and send messages to the DJ!</p>
            </header>

            <!-- Now Playing Section (replaces hero when active) -->
            <div id="nowPlayingSection" class="now-playing-section" style="display: none;">
                <div class="now-playing-card">
                    <div class="now-playing-icon" id="nowPlayingIcon">
                        <i class="fas fa-compact-disc fa-spin"></i>
                    </div>
                    <img id="nowPlayingArtwork" class="now-playing-artwork" src="" alt="Album Art" style="display: none;">
                    <div class="now-playing-info">
                        <span class="now-playing-label">Now Playing</span>
                        <div class="now-playing-title" id="nowPlayingTitle"></div>
                        <div class="now-playing-artist" id="nowPlayingArtist"></div>
                    </div>
                </div>
            </div>

            <!-- Customer Name Input -->
            <div class="name-card" id="nameInputCard">
                <div class="name-card-inner">
                    <div class="name-card-icon">
                        <i class="fas fa-user-circle"></i>
                    </div>
                    <h2 class="name-card-title">What's your name?</h2>
                    <div class="name-input-group">
                        <input type="text" id="customerName" class="form-control form-control-lg" 
                               placeholder="Enter your name..." maxlength="50" autocomplete="off">
                        <button type="button" id="nameSubmitBtn" class="btn btn-primary btn-lg name-submit-btn">
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                    <p class="name-card-hint text-muted small mt-2 mb-0">Your name is unique for this event. You can use the same name again on this phone.</p>
                </div>
            </div>

            <!-- Options (initially hidden) -->
            <div id="optionsContainer" style="display: none;">
                <p class="options-prompt">What would you like to do?</p>

                <div class="options-grid">
                    <% if (!event || event.enable_song_requests !== 0) { %>
                    <div class="option-card" data-target="<%= eventSlug ? 'event/' + eventSlug + '/song-request' : 'song-request' %>">
                        <div class="option-card-icon option-card-icon--songs">
                            <i class="fas fa-music"></i>
                        </div>
                        <div class="option-card-content">
                            <h3 class="option-card-title">Song Request</h3>
                            <p class="option-card-desc">Browse and request songs from our music library</p>
                        </div>
                        <div class="option-card-arrow">
                            <i class="fas fa-chevron-right"></i>
                        </div>
                    </div>
                    <% } %>
                    <% if (!event || event.enable_karaoke_requests !== 0) { %>
                    <div class="option-card" data-target="<%= eventSlug ? 'event/' + eventSlug + '/karaoke-request' : 'karaoke-request' %>">
                        <div class="option-card-icon option-card-icon--karaoke">
                            <i class="fas fa-microphone"></i>
                        </div>
                        <div class="option-card-content">
                            <h3 class="option-card-title">Karaoke Request</h3>
                            <p class="option-card-desc">Find your favorite karaoke songs to sing along</p>
                        </div>
                        <div class="option-card-arrow">
                            <i class="fas fa-chevron-right"></i>
                        </div>
                    </div>
                    <% } %>
                    <% if (!event || event.enable_messages !== 0) { %>
                    <div class="option-card" data-target="<%= eventSlug ? 'event/' + eventSlug + '/send-message' : 'send-message' %>">
                        <div class="option-card-icon option-card-icon--message">
                            <i class="fas fa-paper-plane"></i>
                        </div>
                        <div class="option-card-content">
                            <h3 class="option-card-title">Send Message</h3>
                            <p class="option-card-desc">Send a custom message or special request to the DJ</p>
                        </div>
                        <div class="option-card-arrow">
                            <i class="fas fa-chevron-right"></i>
                        </div>
                    </div>
                    <% } %>
                    <% if (event && event.enable_photos) { %>
                    <div class="option-card" data-target="<%= 'event/' + eventSlug + '/camera' %>">
                        <div class="option-card-icon option-card-icon--photo">
                            <i class="fas fa-camera"></i>
                        </div>
                        <div class="option-card-content">
                            <h3 class="option-card-title">Event Cam</h3>
                            <p class="option-card-desc">Open the camera and snap a photo for the event album</p>
                        </div>
                        <div class="option-card-arrow">
                            <i class="fas fa-chevron-right"></i>
                        </div>
                    </div>
                    <% } %>
                    <% if (event && event.enable_tips) { %>
                    <%
                        let tipLinks = [];
                        if (event.tip_links) {
                            try { tipLinks = JSON.parse(event.tip_links); } catch(e) {}
                        }
                        if (tipLinks.length === 0 && event.tip_provider && event.tip_payment_link) {
                            tipLinks = [{ provider: event.tip_provider, url: event.tip_payment_link }];
                        }
                    %>
                    <% if (tipLinks.length > 0) { %>
                    <div class="option-card" id="tipDjCard" data-tip-links='<%- JSON.stringify(tipLinks) %>'>
                        <div class="option-card-icon option-card-icon--tip">
                            <i class="fas fa-hand-holding-dollar"></i>
                        </div>
                        <div class="option-card-content">
                            <h3 class="option-card-title">Tip the DJ</h3>
                            <p class="option-card-desc">Show your appreciation with a tip!</p>
                        </div>
                        <div class="option-card-arrow">
                            <i class="fas fa-chevron-right"></i>
                        </div>
                    </div>
                    <% } %>
                    <% } %>
                </div>
            </div>

        </div>

        <footer class="mdj-eyup-footer mdj-eyup-footer--compact" aria-label="Company">
            <div class="mdj-footer-container">
                <div class="mdj-company-foot">
                    <p class="mdj-company-foot__legal">&copy; 2026 EYUP EVENTS UK LTD · Co. no. 17186451 · All rights reserved</p>
                </div>
            </div>
        </footer>
    </main>

    <!-- Replies Screen (same layout as send-message page) -->
    <div id="repliesScreen" class="container-fluid" style="display: none; height: 100vh; background-color: #f8f9fa;">
        <div class="row h-100">
            <div class="col-12 d-flex flex-column">
                <div class="bg-white border-bottom p-3 mb-0">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <button id="backToMenuBtn" class="btn btn-outline-secondary btn-sm me-3">
                                <i class="fas fa-arrow-left me-1"></i>Back
                            </button>
                            <h5 class="mb-0">
                                <i class="fas fa-comments me-2 text-primary"></i>
                                Messages for <span id="repliesCustomerName" class="text-primary"></span>
                            </h5>
                        </div>
                        <button id="refreshRepliesBtn" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-sync-alt me-1"></i>Refresh
                        </button>
                    </div>
                </div>

                <div id="chatMessages" class="flex-grow-1 p-3" style="overflow-y: auto;">
                    <div class="text-center py-4">
                        <i class="fas fa-spinner fa-spin fa-2x mb-3"></i>
                        <p>Loading your conversation...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tip Selection Modal -->
    <div class="modal fade" id="tipModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content tip-modal-content">
                <div class="modal-header tip-modal-header">
                    <h5 class="modal-title"><i class="fas fa-hand-holding-dollar me-2"></i>Tip the DJ</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body tip-modal-body">
                    <p class="text-center mb-3 tip-modal-subtitle">Choose a payment method</p>
                    <div id="tipLinksOptions" class="d-grid gap-2"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Now Playing Polling -->
    <script>
    (function() {
        const nowPlayingSection = document.getElementById('nowPlayingSection');
        const nowPlayingTitle = document.getElementById('nowPlayingTitle');
        const nowPlayingArtist = document.getElementById('nowPlayingArtist');
        const nowPlayingArtwork = document.getElementById('nowPlayingArtwork');
        const nowPlayingIcon = document.getElementById('nowPlayingIcon');
        const heroSection = document.getElementById('heroSection');
        
        let lastTrack = null;
        
        async function fetchNowPlaying() {
            try {
                // Include eventSlug if available
                let url = '/api/now-playing';
                if (window.eventSlug) {
                    url += '?eventSlug=' + encodeURIComponent(window.eventSlug);
                }
                
                const response = await fetch(url);
                const data = await response.json();
                
                if (data.title) {
                    // Check if track changed
                    const trackKey = data.title + '|' + data.artist;
                    if (trackKey !== lastTrack) {
                        lastTrack = trackKey;
                        nowPlayingSection.style.display = 'none';
                        // Small delay for re-animation
                        setTimeout(() => {
                            nowPlayingTitle.textContent = data.title;
                            nowPlayingArtist.textContent = data.artist || '';
                            
                            // Handle artwork
                            if (data.artwork) {
                                nowPlayingArtwork.src = data.artwork;
                                nowPlayingArtwork.style.display = 'block';
                                nowPlayingIcon.style.display = 'none';
                            } else {
                                nowPlayingArtwork.style.display = 'none';
                                nowPlayingIcon.style.display = 'flex';
                            }
                            
                            // Hide hero, show now playing
                            heroSection.style.display = 'none';
                            nowPlayingSection.style.display = 'block';
                        }, 50);
                    }
                } else {
                    // Show hero, hide now playing
                    nowPlayingSection.style.display = 'none';
                    heroSection.style.display = '';
                    lastTrack = null;
                }
            } catch (error) {
                console.error('Error fetching now playing:', error);
            }
        }
        
        // Initial fetch
        fetchNowPlaying();
        
        // Poll every 3 seconds
        setInterval(fetchNowPlaying, 3000);
    })();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/guest-session.js"></script>
    <script src="/js/app.js"></script>
</body>
</html>
