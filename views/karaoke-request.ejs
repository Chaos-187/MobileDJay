<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Karaoke Request - MobileDJay</title>
    <meta name="theme-color" content="<%= event && event.accent_color ? event.accent_color : '#0a0a0a' %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Orbitron:wght@400;700;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/eyup-site-chrome.css" rel="stylesheet">
    
    <% if (event) { %>
    <%- include('partials/guest-event-theme', { event }) %>
    <% } %>
</head>
<body class="mdj-eyup-brand">
    <div class="mdj-scanlines" aria-hidden="true"></div>

    <nav class="mdj-site-navbar mdj-site-navbar--minimal" aria-label="Karaoke request">
        <div class="nav-container">
            <div class="logo" role="img" aria-label="EYUP EVENTS">
                <span class="logo-text">EYUP</span>
                <span class="logo-accent">EVENTS</span>
                <span class="logo-subtitle">Karaoke<% if (event && event.name) { %> · <%= event.name %><% } %></span>
            </div>
            <div class="mdj-nav-controls">
                <a href="<%= eventSlug ? '/event/' + eventSlug : '/' %>" class="mdj-nav-back">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i> Back
                </a>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <!-- Search Bar -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="form-group">
                            <label for="karaokeSearch" class="form-label">Search Karaoke Songs</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="text" id="karaokeSearch" class="form-control" 
                                       placeholder="Search by title, artist, or difficulty...">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Karaoke Request Form -->
                <form id="karaokeRequestForm" action="/submit-karaoke-request" method="POST">
                    <!-- Hidden input for customer name and event -->
                    <input type="hidden" id="customerName" name="customerName" value="<%= customerName %>">
                    <input type="hidden" name="eventSlug" value="<%= eventSlug || '' %>">

                    <!-- Karaoke List -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Available Karaoke Songs</h5>
                        </div>
                        <div class="card-body p-2">
                            <div class="scrollable-results">
                                <div id="karaokeList" class="row g-2" style="display: none;">
                                    <!-- Karaoke songs will be populated via JavaScript search -->
                                </div>
                                <div id="noKaraokeFound" class="text-center text-muted">
                                    <i class="fas fa-search fa-2x mb-2"></i>
                                    <p>Start typing to search for karaoke songs...</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-warning btn-lg">
                            <i class="fas fa-microphone me-2"></i>Submit Karaoke Request
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/karaoke-request.js"></script>
</body>
</html>
