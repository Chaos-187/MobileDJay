<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Karaoke Song Spinner - MobileDJay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="/css/spinner-show.css?v=1" rel="stylesheet">
</head>
<body class="spinner-page spinner-theme-karaoke">
    <div class="mdj-spinner-rays" aria-hidden="true"></div>

    <div class="control-panel" id="controlPanel">
        <div><strong>Karaoke Spinner</strong></div>
        <div>Waiting for DJ to trigger...</div>
        <div id="spinStatus">Ready</div>
    </div>

    <div class="spinner-container">
        <h1 class="spinner-title">
            <i class="fas fa-microphone-alt me-3"></i>
            Random Karaoke Selector
            <i class="fas fa-music ms-3"></i>
        </h1>

        <div class="spinner-window">
            <div class="spinner-slot" id="spinnerSlot">
                <div class="mdj-slot-vignette" aria-hidden="true"></div>
                <div class="mdj-slot-highlight" aria-hidden="true"></div>
                <div class="waiting-message" id="waitingMessage">
                    <i class="fas fa-dice"></i>
                    <div>Waiting for DJ to spin...</div>
                    <div style="font-size: 1.1rem; margin-top: 1rem; opacity: 0.55;">
                        Ready to pick a random karaoke song!
                    </div>
                </div>

                <div class="songs-list" id="songsList" style="display: none;"></div>
            </div>
        </div>
    </div>

    <div class="winner-display" id="winnerDisplay">
        <div class="winner-label">It&apos;s karaoke time</div>
        <div class="winner-icon">
            <i class="fas fa-trophy"></i>
        </div>
        <div class="winner-title" id="winnerTitle"></div>
        <div class="winner-artist" id="winnerArtist"></div>
        <div class="winner-difficulty" id="winnerDifficulty"></div>
    </div>

    <script>
        (function () {
            var params = new URLSearchParams(window.location.search);
            var slug = params.get('event') || params.get('eventSlug');
            if (slug) window.displayEventSlug = String(slug).trim();
        })();
    </script>
    <script src="/js/karaoke-spinner.js?v=2"></script>
</body>
</html>
