<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Karaoke Song Spinner - MobileDJay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #ffc107;
            --secondary-color: #ff6b6b;
            --bg-dark: #1a1a2e;
            --bg-light: #16213e;
        }

        body {
            background: linear-gradient(135deg, rgba(26, 26, 46, 0.9) 0%, rgba(22, 33, 62, 0.9) 100%), 
                        url('/images/dj-bg.jpg') center/cover no-repeat fixed;
            margin: 0;
            overflow: hidden;
            font-family: 'Arial', sans-serif;
            cursor: none;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .spinner-container {
            width: 100%;
            max-width: 1200px;
            padding: 2rem;
            position: relative;
        }

        .spinner-title {
            text-align: center;
            color: white;
            font-size: 3rem;
            font-weight: bold;
            margin-bottom: 2rem;
            text-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
            animation: pulse 2s ease-in-out infinite;
        }

        .spinner-window {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 2rem;
            border: 3px solid var(--primary-color);
            box-shadow: 0 0 40px rgba(255, 193, 7, 0.3);
            position: relative;
            overflow: hidden;
            min-height: 400px;
        }

        .spinner-slot {
            background: rgba(0, 0, 0, 0.4);
            border-radius: 15px;
            padding: 2rem;
            margin: 1rem 0;
            position: relative;
            overflow: hidden;
            height: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid rgba(255, 193, 7, 0.3);
        }
        
        .spinner-slot::before,
        .spinner-slot::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--primary-color);
            box-shadow: 0 0 10px var(--primary-color);
            z-index: 10;
        }
        
        .spinner-slot::before {
            top: calc(50% - 150px);
        }
        
        .spinner-slot::after {
            bottom: calc(50% - 150px);
        }

        .songs-list {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            transition: transform 0.1s linear;
        }

        .song-item {
            padding: 2rem;
            text-align: center;
            color: white;
            height: 300px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
        }

        .song-title {
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
        }

        .song-artist {
            font-size: 1.8rem;
            color: var(--primary-color);
            margin-bottom: 0.5rem;
        }

        .song-difficulty {
            display: inline-block;
            padding: 0.5rem 1.5rem;
            background: var(--secondary-color);
            border-radius: 20px;
            font-size: 1.2rem;
            margin-top: 0.5rem;
        }

        .winner-display {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100vw;
            height: 100vh;
            background: linear-gradient(135deg, rgba(255, 193, 7, 0.97), rgba(255, 107, 107, 0.97));
            backdrop-filter: blur(30px);
            padding: 4rem;
            text-align: center;
            z-index: 1000;
            transform: scale(0.5);
            opacity: 0;
        }

        .winner-display.show {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            animation: winnerFullscreen 1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        .winner-icon {
            font-size: 10rem;
            color: white;
            margin-bottom: 3rem;
            animation: iconBounce 1s ease-in-out infinite;
            filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.5));
        }

        .winner-title {
            font-size: 7rem;
            font-weight: bold;
            color: white;
            margin-bottom: 2rem;
            text-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
            animation: titlePulse 2s ease-in-out infinite;
            line-height: 1.2;
        }

        .winner-artist {
            font-size: 4.5rem;
            color: rgba(255, 255, 255, 0.95);
            margin-bottom: 2rem;
            text-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
        }

        .winner-difficulty {
            display: inline-block;
            padding: 1.5rem 3rem;
            background: rgba(255, 255, 255, 0.35);
            border-radius: 50px;
            font-size: 2.5rem;
            color: white;
            margin-top: 2rem;
            border: 3px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
        }
        
        @keyframes titlePulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        .waiting-message {
            text-align: center;
            color: rgba(255, 255, 255, 0.7);
            font-size: 2rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
        }

        .waiting-message i {
            font-size: 5rem;
            margin-bottom: 2rem;
            animation: pulse 2s ease-in-out infinite;
        }

        .confetti {
            position: fixed;
            width: 10px;
            height: 10px;
            background: var(--primary-color);
            position: absolute;
            animation: confettiFall 3s linear forwards;
            opacity: 0;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.05); }
        }

        @keyframes winnerFullscreen {
            0% { 
                transform: scale(0.3);
                opacity: 0;
            }
            60% { 
                transform: scale(1.08);
                opacity: 1;
            }
            100% { 
                transform: scale(1);
                opacity: 1;
            }
        }

        @keyframes iconBounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        @keyframes confettiFall {
            0% { transform: translateY(-100vh) rotate(0deg); opacity: 1; }
            100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
        }

        .control-panel {
            position: fixed;
            top: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.8);
            color: white;
            padding: 10px;
            border-radius: 10px;
            font-size: 0.9rem;
            opacity: 0;
            transition: opacity 0.3s;
            z-index: 1000;
        }

        .control-panel:hover { opacity: 1; }
        .control-panel.show { opacity: 0.7; }
    </style>
</head>
<body>
    <!-- Control Panel -->
    <div class="control-panel" id="controlPanel">
        <div><strong>Karaoke Spinner</strong></div>
        <div>Waiting for DJ to trigger...</div>
        <div id="spinStatus">Ready</div>
    </div>

    <div class="spinner-container">
        <h1 class="spinner-title">
            <i class="fas fa-microphone-alt me-3"></i>
            Random Karaoke Selector
            <i class="fas fa-music ms-3"></i>
        </h1>

        <div class="spinner-window">
            <div class="spinner-slot" id="spinnerSlot">
                <div class="waiting-message" id="waitingMessage">
                    <i class="fas fa-dice"></i>
                    <div>Waiting for DJ to spin...</div>
                    <div style="font-size: 1.2rem; margin-top: 1rem; opacity: 0.5;">
                        Ready to pick a random karaoke song!
                    </div>
                </div>

                <div class="songs-list" id="songsList" style="display: none;"></div>
            </div>
        </div>
    </div>

    <!-- Winner display - outside spinner container for full screen -->
    <div class="winner-display" id="winnerDisplay">
        <div class="winner-icon">
            <i class="fas fa-trophy"></i>
        </div>
        <div class="winner-title" id="winnerTitle"></div>
        <div class="winner-artist" id="winnerArtist"></div>
        <div class="winner-difficulty" id="winnerDifficulty"></div>
    </div>

    <script src="/js/karaoke-spinner.js"></script>
</body>
</html>