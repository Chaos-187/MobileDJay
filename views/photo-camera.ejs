<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <%- include('partials/guest-mobile-head', {
        themeColor: '#000000',
        viewportContent: 'width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no, viewport-fit=cover'
    }) %>
    <title>Event Cam - MobileDJay</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body {
            height: 100%;
            background: #000;
            color: #fff;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            overflow: hidden;
        }
        button { font-family: inherit; cursor: pointer; }

        .stage {
            position: fixed;
            inset: 0;
            background: #000;
            touch-action: none;
        }
        .camera-viewport {
            position: absolute;
            inset: 0;
            overflow: hidden;
        }
        .stage video,
        .stage img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transform-origin: center center;
            will-change: transform;
        }
        .stage video.mirrored { transform: scaleX(-1); }
        .stage img { object-fit: contain; }

        .camera-flash {
            position: absolute;
            inset: 0;
            background: #fff;
            opacity: 0;
            pointer-events: none;
        }
        .camera-flash.flashing { animation: cameraFlash 0.3s ease-out; }
        @keyframes cameraFlash {
            0% { opacity: 0.9; }
            100% { opacity: 0; }
        }

        .top-bar {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: calc(0.75rem + env(safe-area-inset-top, 0px)) 0.75rem 0.75rem;
            background: linear-gradient(rgba(0, 0, 0, 0.55), transparent);
            z-index: 5;
        }
        .round-btn {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: none;
            background: rgba(0, 0, 0, 0.45);
            color: #fff;
            font-size: 1.1rem;
        }
        .event-label {
            font-size: 0.85rem;
            font-weight: 600;
            opacity: 0.85;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
        }

        .bottom-bar {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 2.25rem;
            padding: 1.25rem 1rem calc(1.5rem + env(safe-area-inset-bottom, 0px));
            background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
            z-index: 5;
        }
        .shutter-btn {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            border: 5px solid #fff;
            background: rgba(255, 255, 255, 0.25);
            transition: transform 0.1s ease, background 0.1s ease;
        }
        .shutter-btn:active {
            transform: scale(0.9);
            background: #fff;
        }
        .side-btn {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            border: none;
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            font-size: 1.2rem;
        }

        .side-btn:disabled {
            opacity: 0.35;
            cursor: not-allowed;
        }
        .zoom-cluster {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.35rem;
            min-width: 48px;
        }
        .zoom-cluster .zoom-label {
            font-size: 0.72rem;
            font-weight: 700;
            line-height: 1;
            opacity: 0.9;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
            font-variant-numeric: tabular-nums;
        }
        .zoom-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: none;
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            font-size: 1.35rem;
            font-weight: 700;
            line-height: 1;
        }
        .zoom-btn:disabled {
            opacity: 0.35;
            cursor: not-allowed;
        }

        /* Filter strip (above the shutter bar) */
        .filter-strip {
            position: absolute;
            bottom: calc(118px + env(safe-area-inset-bottom, 0px));
            left: 0;
            right: 0;
            display: flex;
            gap: 0.5rem;
            padding: 0.4rem 0.75rem;
            overflow-x: auto;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
            z-index: 5;
        }
        .filter-strip::-webkit-scrollbar { display: none; }
        .filter-chip {
            flex: 0 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.3rem;
            border: none;
            background: none;
            color: #fff;
            font-size: 0.72rem;
            font-weight: 600;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
        }
        .filter-chip .swatch {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.35);
            background: linear-gradient(135deg, #ff8a5c 0%, #5cc8ff 60%, #8f7bff 100%);
            transition: border-color 0.15s ease, transform 0.15s ease;
        }
        .filter-chip.active .swatch {
            border-color: #0dcaf0;
            transform: scale(1.12);
            box-shadow: 0 0 12px rgba(13, 202, 240, 0.6);
        }
        .filter-chip.active { color: #0dcaf0; }

        /* Review (after capture) */
        .review-bar {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 1rem 1rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
            background: linear-gradient(transparent, rgba(0, 0, 0, 0.85) 40%);
            z-index: 6;
            display: none;
            flex-direction: column;
            gap: 0.75rem;
        }
        .review-bar.active { display: flex; }
        .review-bar input {
            width: 100%;
            padding: 0.7rem 0.9rem;
            border-radius: 0.6rem;
            border: 1px solid rgba(255, 255, 255, 0.3);
            background: rgba(0, 0, 0, 0.55);
            color: #fff;
            font-size: 1rem;
        }
        .review-bar input::placeholder { color: rgba(255, 255, 255, 0.55); }
        .review-actions {
            display: flex;
            gap: 0.6rem;
        }
        .review-actions button {
            flex: 1;
            padding: 0.8rem;
            border-radius: 0.6rem;
            border: none;
            font-size: 1rem;
            font-weight: 700;
        }
        .btn-retake {
            background: rgba(255, 255, 255, 0.18);
            color: #fff;
        }
        .btn-upload {
            background: #0dcaf0;
            color: #06232b;
        }
        .btn-upload:disabled { opacity: 0.6; }

        .status-msg {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            padding: 1rem 1.25rem;
            max-width: 90%;
            z-index: 7;
            border-radius: 0.75rem;
            background: rgba(0, 0, 0, 0.75);
            font-size: 1rem;
            display: none;
        }
        .status-msg.active { display: block; }
        .status-msg .actions { margin-top: 0.9rem; }
        .status-msg a,
        .status-msg button.linkish {
            display: inline-block;
            margin: 0 0.35rem;
            padding: 0.55rem 1rem;
            border-radius: 0.5rem;
            border: none;
            background: #0dcaf0;
            color: #06232b;
            font-weight: 700;
            text-decoration: none;
            font-size: 0.95rem;
        }
        .status-msg button.linkish.secondary,
        .status-msg a.secondary {
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
        }
    </style>
</head>
<body>
    <div class="stage" id="cameraStage">
        <div class="camera-viewport" id="cameraViewport">
            <video id="cameraVideo" autoplay playsinline muted></video>
            <img id="reviewImg" alt="Captured photo" style="display: none;">
        </div>
        <div class="camera-flash" id="cameraFlash"></div>
    </div>

    <div class="top-bar">
        <span class="event-label"><i class="fas fa-camera me-1"></i> Event Cam · <%= event.name %></span>
        <button type="button" id="closeBtn" class="round-btn" aria-label="Close camera">
            <i class="fas fa-xmark"></i>
        </button>
    </div>

    <div class="filter-strip" id="filterStrip"></div>

    <div class="bottom-bar" id="captureControls">
        <button type="button" id="flipBtn" class="side-btn" aria-label="Switch camera">
            <i class="fas fa-camera-rotate"></i>
        </button>
        <button type="button" id="shutterBtn" class="shutter-btn" aria-label="Take photo"></button>
        <div class="zoom-cluster" id="zoomCluster">
            <button type="button" id="zoomInBtn" class="zoom-btn" aria-label="Zoom in">+</button>
            <span class="zoom-label" id="zoomLabel">1.0×</span>
            <button type="button" id="zoomOutBtn" class="zoom-btn" aria-label="Zoom out">−</button>
        </div>
    </div>

    <div class="review-bar" id="reviewBar">
        <input type="text" id="captionInput" maxlength="200" placeholder="Add a caption (optional)…" autocomplete="off">
        <div class="review-actions">
            <button type="button" class="btn-retake" id="retakeBtn"><i class="fas fa-rotate-left me-1"></i> Retake</button>
            <button type="button" class="btn-upload" id="uploadBtn"><i class="fas fa-cloud-arrow-up me-1"></i> Add to Album</button>
        </div>
    </div>

    <div class="status-msg" id="statusMsg"></div>

    <script>
        window.eventSlug = '<%= eventSlug %>';
        window.customerName = '<%= customerName %>';
    </script>
    <script src="/js/photo-camera.js"></script>
</body>
</html>
