<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="manifest" href="/manifest.json">
    <title>Share a Photo - MobileDJay</title>
    <meta name="theme-color" content="<%= typeof event !== 'undefined' && event && event.accent_color ? event.accent_color : '#0a0a0a' %>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Orbitron:wght@400;700;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/eyup-site-chrome.css" rel="stylesheet">
    <% if (typeof event !== 'undefined' && event && event.accent_color) { %>
    <style>
        body.mdj-eyup-brand .mdj-site-navbar { background-color: <%= event.accent_color %> !important; border-bottom-color: <%= event.accent_color %> !important; }
    </style>
    <% } %>
    <style>
        .photo-drop-zone {
            border: 2px dashed rgba(255, 255, 255, 0.25);
            border-radius: 1rem;
            padding: 2.5rem 1.5rem;
            text-align: center;
            cursor: pointer;
            transition: border-color 0.2s ease, background-color 0.2s ease;
        }
        .photo-drop-zone:hover,
        .photo-drop-zone.drag-over {
            border-color: var(--event-accent-color, #0d6efd);
            background-color: rgba(255, 255, 255, 0.04);
        }
        .photo-drop-zone i {
            font-size: 2.6rem;
            opacity: 0.7;
            margin-bottom: 0.75rem;
        }
        .photo-preview-wrap {
            position: relative;
            border-radius: 1rem;
            overflow: hidden;
        }
        .photo-preview-wrap img {
            width: 100%;
            display: block;
            max-height: 60vh;
            object-fit: contain;
            background: #000;
        }
        .photo-retake-btn {
            position: absolute;
            top: 0.6rem;
            right: 0.6rem;
        }
        .photo-recent-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
            gap: 0.5rem;
        }
        .photo-recent-grid img {
            width: 100%;
            aspect-ratio: 1;
            object-fit: cover;
            border-radius: 0.5rem;
        }
        /* Full-screen camera overlay */
        .live-camera-wrap {
            position: fixed;
            inset: 0;
            z-index: 2000;
            background: #000;
        }
        .live-camera-wrap video {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
        }
        .live-camera-wrap video.mirrored {
            transform: scaleX(-1);
        }
        body.camera-open {
            overflow: hidden;
        }
        .live-camera-controls {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 2rem;
            padding: 1.25rem 1rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
            background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
        }
        .shutter-btn {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            border: 4px solid #fff;
            background: rgba(255, 255, 255, 0.25);
            transition: transform 0.1s ease, background 0.1s ease;
        }
        .shutter-btn:active {
            transform: scale(0.9);
            background: #fff;
        }
        .camera-side-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            border: none;
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            font-size: 1.1rem;
        }
        .camera-close-btn {
            position: absolute;
            top: calc(0.75rem + env(safe-area-inset-top, 0px));
            right: 0.75rem;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            font-size: 1.1rem;
        }
        .camera-flash {
            position: absolute;
            inset: 0;
            background: #fff;
            opacity: 0;
            pointer-events: none;
        }
        .camera-flash.flashing {
            animation: cameraFlash 0.3s ease-out;
        }
        @keyframes cameraFlash {
            0% { opacity: 0.9; }
            100% { opacity: 0; }
        }
    </style>
</head>
<body class="mdj-eyup-brand">
    <div class="mdj-scanlines" aria-hidden="true"></div>

    <nav class="mdj-site-navbar mdj-site-navbar--minimal" aria-label="Share a photo">
        <div class="nav-container">
            <div class="logo" role="img" aria-label="EYUP EVENTS">
                <span class="logo-text">EYUP</span>
                <span class="logo-accent">EVENTS</span>
                <span class="logo-subtitle">Photos<% if (typeof event !== 'undefined' && event && event.name) { %> · <%= event.name %><% } %></span>
            </div>
            <div class="mdj-nav-controls">
                <a href="<%= eventSlug ? '/event/' + eventSlug : '/' %>" class="mdj-nav-back">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i> Back
                </a>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-camera me-2"></i>Share a Photo</h5>
                        <p class="text-muted small mb-3">Snap a picture of the party — it gets saved to the event album for everyone to enjoy afterwards.</p>

                        <input type="file" id="photoInput" accept="image/*" capture="environment" class="d-none">

                        <div class="d-grid mb-2" id="liveCameraBtnWrap" style="display: none !important;">
                            <button type="button" id="openCameraBtn" class="btn btn-outline-info">
                                <i class="fas fa-video me-2"></i>Take a Picture Live
                            </button>
                        </div>

                        <div id="dropZone" class="photo-drop-zone" role="button" tabindex="0" aria-label="Take or choose a photo">
                            <i class="fas fa-camera-retro d-block"></i>
                            <div class="fw-bold">Tap to take a photo</div>
                            <div class="small text-muted">or choose one from your gallery</div>
                        </div>

                        <div id="previewWrap" class="photo-preview-wrap mt-3" style="display: none;">
                            <img id="previewImg" src="" alt="Photo preview">
                            <button type="button" id="retakeBtn" class="btn btn-sm btn-dark photo-retake-btn">
                                <i class="fas fa-rotate-left me-1"></i>Retake
                            </button>
                        </div>

                        <div class="mt-3">
                            <label for="captionInput" class="form-label">Caption <span class="text-muted small">(optional)</span></label>
                            <input type="text" id="captionInput" class="form-control" maxlength="200" placeholder="Say something about this moment...">
                        </div>

                        <div class="d-grid mt-3">
                            <button type="button" id="uploadBtn" class="btn btn-info btn-lg" disabled>
                                <i class="fas fa-cloud-arrow-up me-2"></i>Add to Event Album
                            </button>
                        </div>
                        <div id="uploadStatus" class="mt-2 small text-center" aria-live="polite"></div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <h6 class="card-title mb-3"><i class="fas fa-images me-2"></i>Latest Event Photos</h6>
                        <div id="recentGrid" class="photo-recent-grid">
                            <span class="text-muted small">Loading…</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer class="mdj-eyup-footer mdj-eyup-footer--compact" aria-label="Company">
            <div class="mdj-footer-container">
                <div class="mdj-company-foot">
                    <p class="mdj-company-foot__legal">&copy; 2026 EYUP EVENTS UK LTD · Co. no. 17186451 · All rights reserved</p>
                </div>
            </div>
        </footer>
    </main>

    <!-- Full-screen live camera overlay (direct child of body so position:fixed
         is not trapped by the card's transform/backdrop-filter/overflow) -->
    <div id="cameraWrap" class="live-camera-wrap" style="display: none;">
        <video id="cameraVideo" autoplay playsinline muted></video>
        <div class="camera-flash" id="cameraFlash"></div>
        <button type="button" id="closeCameraBtn" class="btn btn-sm btn-dark camera-close-btn" aria-label="Close camera">
            <i class="fas fa-xmark"></i>
        </button>
        <div class="live-camera-controls">
            <button type="button" id="flipCameraBtn" class="camera-side-btn" aria-label="Switch camera">
                <i class="fas fa-camera-rotate"></i>
            </button>
            <button type="button" id="shutterBtn" class="shutter-btn" aria-label="Take photo"></button>
            <span style="width: 44px;"></span>
        </div>
    </div>

    <script>
        window.eventSlug = '<%= eventSlug %>';
        window.customerName = '<%= customerName %>';
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/photo-capture.js"></script>
</body>
</html>
