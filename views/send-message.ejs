<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="supports-keyboard-gifs" content="true">
    <meta name="supports-keyboard-stickers" content="true">
    <link rel="manifest" href="/manifest.json">
    <title>Messages<% if (typeof event !== 'undefined' && event && event.name) { %> · <%= event.name %><% } %> - MobileDJay</title>
    <meta name="theme-color" content="<%= typeof event !== 'undefined' && event && event.accent_color ? event.accent_color : '#0a0a0a' %>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Orbitron:wght@400;700;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/eyup-site-chrome.css" rel="stylesheet">
    <link href="/css/guest-chat.css" rel="stylesheet">
    <% if (typeof event !== 'undefined' && event) { %>
    <%- include('partials/guest-event-theme', { event }) %>
    <% } %>
</head>
<body class="mdj-eyup-brand guest-chat-page">
    <div class="mdj-scanlines" aria-hidden="true"></div>

    <nav class="mdj-site-navbar mdj-site-navbar--minimal" aria-label="Messages">
        <div class="nav-container">
            <div class="logo" role="img" aria-label="EYUP EVENTS">
                <span class="logo-text">EYUP</span>
                <span class="logo-accent">EVENTS</span>
                <span class="logo-subtitle">Chat<% if (typeof event !== 'undefined' && event && event.name) { %> · <%= event.name %><% } %></span>
            </div>
            <div class="mdj-nav-controls">
                <a href="<%= eventSlug ? '/event/' + eventSlug : '/' %>" class="mdj-nav-back">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i> Back
                </a>
            </div>
        </div>
    </nav>

    <div class="guest-chat-shell">
        <div id="chatMessages" class="guest-chat-thread" role="log" aria-live="polite" aria-relevant="additions">
            <div class="guest-chat-thread__empty">
                <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
                <p class="mb-0">Loading conversation…</p>
            </div>
        </div>

        <div class="guest-chat-composer">
            <form id="messageForm" novalidate>
                <input type="hidden" id="customerName" name="customerName" value="<%= customerName %>">
                <input type="hidden" id="message" name="message">
                <input type="hidden" id="messageText" name="messageText">
                <input type="hidden" name="eventSlug" value="<%= eventSlug || '' %>">

                <div class="guest-chat-composer__toolbar">
                    <label class="guest-chat-composer__privacy" for="djOnly">
                        <input class="form-check-input" type="checkbox" value="1" id="djOnly" name="djOnly">
                        <span><i class="fas fa-user-lock me-1" aria-hidden="true"></i>DJ only (private)</span>
                    </label>
                    <span id="charCount" class="guest-chat-composer__char">0/500</span>
                </div>

                <div class="guest-chat-composer__row">
                    <div id="messageInput"
                         class="guest-chat-composer__input"
                         contenteditable="true"
                         role="textbox"
                         aria-label="Type a message"
                         aria-multiline="true"
                         data-placeholder="Message the DJ…"
                         inputmode="text"
                         enterkeyhint="send"
                         spellcheck="true"
                         tabindex="0"></div>
                    <button type="submit" id="sendBtn" class="guest-chat-composer__send" aria-label="Send message">
                        <i class="fas fa-paper-plane" aria-hidden="true"></i>
                    </button>
                </div>

                <p class="guest-chat-composer__hint mb-0">
                    Use your keyboard GIF button on mobile, or paste images on desktop.
                </p>
            </form>
        </div>
    </div>

    <script>
        window.eventSlug = '<%= eventSlug || "" %>';
        window.djName = '<%= typeof djName !== "undefined" && djName ? djName : "DJ" %>';
    </script>
    <script src="/js/guest-session.js"></script>
    <script src="/js/send-message.js"></script>
</body>
</html>
