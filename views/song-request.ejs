<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <%- include('partials/guest-mobile-head', { themeColor: event && event.accent_color ? event.accent_color : '#0a0a0a' }) %>
    <title>Song Request - MobileDJay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Orbitron:wght@400;700;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/eyup-site-chrome.css" rel="stylesheet">
    
    <% if (event) { %>
    <%- include('partials/guest-event-theme', { event }) %>
    <% } %>
</head>
<body class="mdj-eyup-brand">
    <div class="mdj-scanlines" aria-hidden="true"></div>

    <nav class="mdj-site-navbar mdj-site-navbar--minimal" aria-label="Song request">
        <div class="nav-container">
            <div class="logo" role="img" aria-label="EYUP EVENTS">
                <span class="logo-text">EYUP</span>
                <span class="logo-accent">EVENTS</span>
                <span class="logo-subtitle">Song request<% if (event && event.name) { %> · <%= event.name %><% } %></span>
            </div>
            <div class="mdj-nav-controls">
                <a href="<%= eventSlug ? '/event/' + eventSlug : '/' %>" class="mdj-nav-back">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i> Back
                </a>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <% if (event && event.show_tracks_played_guest && eventSlug) { %>
                <button type="button" id="tracksPlayedBtn" class="tracks-played-btn"
                        data-bs-toggle="modal" data-bs-target="#tracksPlayedModal"
                        aria-label="View recently played tracks">
                    <span class="tracks-played-btn__icon"><i class="fas fa-list-ul" aria-hidden="true"></i></span>
                    <span class="tracks-played-btn__label">Recently Played</span>
                    <span id="tracksPlayedCount" class="tracks-played-btn__count">…</span>
                    <i class="fas fa-chevron-right tracks-played-btn__arrow" aria-hidden="true"></i>
                </button>
                <% } %>

                <!-- Search Bar -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="form-group">
                            <label for="songSearch" class="form-label">Search Songs</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="text" id="songSearch" class="form-control" 
                                       placeholder="Enter at least 3 characters to search...">
                            </div>
                            <div class="form-text">Search by title, artist, album, or year</div>
                        </div>
                    </div>
                </div>

                <!-- Song Request Form -->
                <form id="songRequestForm" action="/submit-song-request" method="POST">
                    <!-- Hidden input for customer name and event -->
                    <input type="hidden" id="customerName" name="customerName" value="<%= customerName %>">
                    <input type="hidden" name="eventSlug" value="<%= eventSlug || '' %>">

                    <!-- Song List -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Available Songs</h5>
                        </div>
                        <div class="card-body p-2">
                            <div class="scrollable-results">
                                <div id="songList" class="row g-2">
                                    <div class="col-12">
                                        <div class="text-center text-muted py-4">
                                            <i class="fas fa-search fa-3x mb-3"></i>
                                            <h5>Search for Songs</h5>
                                            <p>Enter at least 3 characters to start searching through our music library</p>
                                        </div>
                                    </div>
                                </div>
                                <div id="noSongsFound" style="display: none;" class="text-center text-muted">
                                    <i class="fas fa-search fa-2x mb-2"></i>
                                    <p>Please enter at least 3 characters to search</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-paper-plane me-2"></i>Submit Song Request
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <% if (event && event.show_tracks_played_guest && eventSlug) { %>
    <div class="modal fade" id="tracksPlayedModal" tabindex="-1" aria-labelledby="tracksPlayedModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable tracks-played-modal-dialog">
            <div class="modal-content tracks-played-modal-content">
                <div class="modal-header tracks-played-modal-header">
                    <h5 class="modal-title" id="tracksPlayedModalLabel">
                        <i class="fas fa-list-ul me-2"></i>Recently Played
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body tracks-played-modal-body">
                    <ul class="tracks-played-list tracks-played-list--modal" id="tracksPlayedModalList">
                        <li class="tracks-played-empty text-muted">Loading…</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <script>
        window.eventSlug = '<%= eventSlug || "" %>';
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/guest-session.js"></script>
    <% if (event && event.show_tracks_played_guest && eventSlug) { %>
    <script src="/js/tracks-played-guest.js"></script>
    <% } %>
    <script src="/js/song-request.js"></script>
</body>
</html>
