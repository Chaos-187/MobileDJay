<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Song Request - MobileDJay</title>
    <meta name="theme-color" content="#1a1040">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    
    <% if (event) { %>
    <!-- Event Custom Styling -->
    <style>
        :root {
            <% if (event.heading_color) { %>--event-heading-color: <%= event.heading_color %>;<% } %>
            <% if (event.text_color) { %>--event-text-color: <%= event.text_color %>;<% } %>
            <% if (event.bg_color) { %>--event-bg-color: <%= event.bg_color %>;<% } %>
            <% if (event.accent_color) { %>--event-accent-color: <%= event.accent_color %>;<% } %>
        }
        <% if (event.bg_color || event.bg_image) { %>
        body {
            <% if (event.bg_color) { %>background-color: <%= event.bg_color %>;<% } %>
            <% if (event.bg_image) { %>
            background-image: url('<%= event.bg_image %>');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            <% } %>
        }
        <% } %>
        <% if (event.text_color) { %>
        body, .card-text, p, .lead { color: <%= event.text_color %>; }
        <% } %>
        <% if (event.heading_color) { %>
        h1, h2, h3, h4, h5, h6, .card-title, .display-4 { color: <%= event.heading_color %> !important; }
        <% } %>
        <% if (event.accent_color) { %>
        .navbar, .bg-primary { background-color: <%= event.accent_color %> !important; }
        .btn-primary { background-color: <%= event.accent_color %>; border-color: <%= event.accent_color %>; }
        .btn-primary:hover { background-color: color-mix(in srgb, <%= event.accent_color %> 85%, black); border-color: color-mix(in srgb, <%= event.accent_color %> 85%, black); }
        .text-primary { color: <%= event.accent_color %> !important; }
        .border-primary { border-color: <%= event.accent_color %> !important; }
        a { color: <%= event.accent_color %>; }
        <% } %>
        <%= event.custom_css || '' %>
    </style>
    <% } %>
</head>
<body>
    <nav class="navbar navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="<%= eventSlug ? '/event/' + eventSlug : '/' %>">
                <i class="fas fa-music me-2"></i>MobileDJay
            </a>
            <a href="<%= eventSlug ? '/event/' + eventSlug : '/' %>" class="btn btn-outline-light btn-sm">
                <i class="fas fa-arrow-left me-1"></i>Back
            </a>
        </div>
    </nav>

    <main class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <!-- Search Bar -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="form-group">
                            <label for="songSearch" class="form-label">Search Songs</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="text" id="songSearch" class="form-control" 
                                       placeholder="Enter at least 3 characters to search...">
                            </div>
                            <div class="form-text">Search by title, artist, album, or year</div>
                        </div>
                    </div>
                </div>

                <!-- Song Request Form -->
                <form id="songRequestForm" action="/submit-song-request" method="POST">
                    <!-- Hidden input for customer name and event -->
                    <input type="hidden" id="customerName" name="customerName" value="<%= customerName %>">
                    <input type="hidden" name="eventSlug" value="<%= eventSlug || '' %>">

                    <!-- Song List -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Available Songs</h5>
                        </div>
                        <div class="card-body p-2">
                            <div class="scrollable-results">
                                <div id="songList" class="row g-2">
                                    <div class="col-12">
                                        <div class="text-center text-muted py-4">
                                            <i class="fas fa-search fa-3x mb-3"></i>
                                            <h5>Search for Songs</h5>
                                            <p>Enter at least 3 characters to start searching through our music library</p>
                                        </div>
                                    </div>
                                </div>
                                <div id="noSongsFound" style="display: none;" class="text-center text-muted">
                                    <i class="fas fa-search fa-2x mb-2"></i>
                                    <p>Please enter at least 3 characters to search</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-paper-plane me-2"></i>Submit Song Request
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/song-request.js"></script>
</body>
</html>
